{
  "name": "_template",
  "version": "0.1.0",
  "private": true,
  "_comment": "Rename to your app name (e.g. 'quiksocial', 'quikcrm') before first run. Pick an unused port in scripts.",
  "scripts": {
    "dev": "next dev -p 3010",
