  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  quote        CrmQuote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([tenantId, quoteId])
  @@schema("app_quikcrm")
}

