  name        String                   @unique
  subStatuses CrmLeadStatusSubStatus[]

  @@schema("app_quikcrm")
}

model CrmLeadSubStatus {
  id       String                   @id @default(cuid())
  name     String                   @unique
  statuses CrmLeadStatusSubStatus[]

  @@schema("app_quikcrm")
}

model CrmLeadStatusSubStatus {
  id              String           @id @default(cuid())
  leadStatusId    String
  leadSubStatusId String
  leadStatus      CrmLeadStatus    @relation(fields: [leadStatusId], references: [id], onDelete: Cascade)
  leadSubStatus   CrmLeadSubStatus @relation(fields: [leadSubStatusId], references: [id], onDelete: Cascade)

