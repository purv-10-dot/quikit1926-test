// ─── Call Disposition Form Builder ───────────────────────────────────────────

enum CrmFormSurface {
  call_disposition

  @@schema("app_quikcrm")
}

enum CrmFormSetVersionStatus {
  draft
  published
  retired

  @@schema("app_quikcrm")
}

enum CrmFormFieldTab {
  contact_details
  call_disposition

  @@schema("app_quikcrm")
}

enum CrmFormFieldType {
  text
  datetime
  dropdown
  number
  user_picker
  file_upload

  @@schema("app_quikcrm")
}

enum CrmFormFieldRequiredLevel {
  none
  soft
  hard

  @@schema("app_quikcrm")
}

enum CrmFieldValueType {
  text
  datetime
  dropdown
  number
  user_picker
  file_upload

  @@schema("app_quikcrm")
}

/// Named, tenant-scoped form set. surface discriminator keeps the engine generic.
model CrmFormSet {
  id               String              @id @default(cuid())
  tenantId         String
  surface          CrmFormSurface
  name             String
  isDefault        Boolean             @default(false)
  isActive         Boolean             @default(true)
  /// Points to the live version agents receive. Null until first publish.
  currentVersionId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  currentVersion   CrmFormSetVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions         CrmFormSetVersion[] @relation("FormSetVersions")
  selectionLogsAsDefault CrmSetSelectionLog[] @relation("DefaultSet")
  selectionLogsAsChosen  CrmSetSelectionLog[] @relation("ChosenSet")

  @@unique([tenantId, surface, name])
  @@index([tenantId, surface, isDefault])
  @@schema("app_quikcrm")
}

/// Immutable snapshot of a form set's fields and mapping rules.
/// Editing a published set always creates a new draft version.
model CrmFormSetVersion {
  id            String                  @id @default(cuid())
  formSetId     String
  versionNumber Int
  status        CrmFormSetVersionStatus @default(draft)
  publishedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  formSet       CrmFormSet              @relation("FormSetVersions", fields: [formSetId], references: [id])
  currentFor    CrmFormSet[]            @relation("CurrentVersion")
  fields        CrmFormField[]
  mappingRules  CrmFormSetMappingRule[]
  fieldValues   CrmFieldValue[]
  selectionLogs CrmSetSelectionLog[]
  tabs          CrmFormTab[]
  rules         CrmFormRule[]

  @@unique([formSetId, versionNumber])
  @@index([formSetId, status])
  @@schema("app_quikcrm")
}

/// One form field within a version snapshot. fieldKey is immutable once created;
/// only the label is editable (display-only rename, no data migration needed).
model CrmFormField {
  id               String                    @id @default(cuid())
  formSetVersionId String
  tab              CrmFormFieldTab
  fieldKey         String
  label            String
  fieldType        CrmFormFieldType
  isProtected      Boolean                   @default(false)
  requiredLevel    CrmFormFieldRequiredLevel  @default(soft)
  sortOrder        Int
  isActive         Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  version          CrmFormSetVersion         @relation(fields: [formSetVersionId], references: [id])
  options          CrmFormFieldOption[]
  formTabId         String?
  formSectionId     String?
  userPickerMode    CrmUserPickerMode?
  userPickerScope   CrmUserPickerScope?
  defaultVisibility CrmFieldVisibility        @default(visible)
  formTab           CrmFormTab?               @relation(fields: [formTabId], references: [id])
  formSection       CrmFormSection?           @relation(fields: [formSectionId], references: [id])

  @@unique([formSetVersionId, tab, fieldKey])
  @@unique([formSetVersionId, tab, label])
  @@index([formSetVersionId, tab, sortOrder])
  @@schema("app_quikcrm")
}

/// Dropdown option for a form field. Deactivate-not-delete: historical records keep their value.
model CrmFormFieldOption {
  id          String       @id @default(cuid())
  formFieldId String
  /// Stable internal identifier; data attaches to this, not the label.
  valueKey    String
  label       String
  sortOrder   Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  field       CrmFormField @relation(fields: [formFieldId], references: [id])

  @@unique([formFieldId, valueKey])
  @@index([formFieldId, isActive, sortOrder])
  @@schema("app_quikcrm")
}

/// Indexed key-value store for custom-field values captured per activity.
/// One row per field per activity. Never store custom values as JSON on the activity.
/// tenantId is denormalized here so every query can be ACL-filtered without a join.
model CrmFieldValue {
  id               String            @id @default(cuid())
  tenantId         String
  activityId       String
  formSetVersionId String
  fieldKey         String
  valueType        CrmFieldValueType
  valueText        String?
  valueNumber      Decimal?          @db.Decimal(18, 4)
  valueDatetime    DateTime?
  valueFileId      String?
  valueUserIds     String[]           @default([])
  createdAt        DateTime          @default(now())
  version          CrmFormSetVersion @relation(fields: [formSetVersionId], references: [id])
  valueFile        CrmFileAttachment? @relation(fields: [valueFileId], references: [id])

  @@unique([activityId, fieldKey])
  @@index([tenantId, fieldKey, valueText])
  @@index([tenantId, fieldKey, valueNumber])
  @@index([tenantId, fieldKey, valueDatetime])
  @@index([valueUserIds], type: Gin)
  @@schema("app_quikcrm")
}

/// Audit log of which form set an agent used per call.
/// was_overridden=true when the agent switched away from the tenant default.
model CrmSetSelectionLog {
  id            String            @id @default(cuid())
  tenantId      String
  leadId        String
  activityId    String?
  defaultSetId  String
  chosenSetId   String
  formSetVersionId String
  wasOverridden Boolean
  chosenBy      String
  createdAt     DateTime          @default(now())
  defaultSet    CrmFormSet        @relation("DefaultSet", fields: [defaultSetId], references: [id])
  chosenSet     CrmFormSet        @relation("ChosenSet", fields: [chosenSetId], references: [id])
  version       CrmFormSetVersion @relation(fields: [formSetVersionId], references: [id])

  @@index([tenantId, leadId])
  @@index([tenantId, wasOverridden])
  @@schema("app_quikcrm")
}

/// Per-set, per-version disposition → lead-status mapping rules.
/// Replaces the hardcoded switch in disposition-engine.ts (Step 6).
/// Never global: every rule is scoped to a form_set_version.
model CrmFormSetMappingRule {
  id               String            @id @default(cuid())
  formSetVersionId String
  trigger          Json
  action           Json
  sortOrder        Int
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  version          CrmFormSetVersion @relation(fields: [formSetVersionId], references: [id])

  @@index([formSetVersionId, isActive, sortOrder])
  @@schema("app_quikcrm")
}

// ─────────────────────────────────────────────────────────────────────────────
// FR-RE — conditional rule engine, multi-tab/section forms, new field types.
// Spec: quikcrm-disposition-rule-engine-spec.md. Every table is versioned WITH
// the form set (scoped to a CrmFormSetVersion snapshot). Flat rules, no nesting.
// set_stage / activity references are logical String ids validated at the app
// layer (FR-RE-A7a) — NOT hard FKs — keeping the status taxonomy decoupled.
// ─────────────────────────────────────────────────────────────────────────────

enum CrmFormTabVisibility {
  always
  rule_driven

  @@schema("app_quikcrm")
}

enum CrmFormRuleMatchType {
  all
  any

  @@schema("app_quikcrm")
}

enum CrmFormRuleSubjectKind {
  field
  stage
  status
  sub_stage

  @@schema("app_quikcrm")
}

enum CrmFormRuleOperator {
  is
  is_not
  is_any_of
  is_none_of
  is_empty
  is_not_empty

  @@schema("app_quikcrm")
}

enum CrmFormRuleActionType {
  show_field
  hide_field
  make_mandatory
  make_optional
  show_tab
  set_stage

  @@schema("app_quikcrm")
}

enum CrmFormRuleTargetKind {
  field
  section
  tab
  stage

  @@schema("app_quikcrm")
}

enum CrmUserPickerMode {
  single
  multi

  @@schema("app_quikcrm")
}

enum CrmUserPickerScope {
  all_users
  team
  role

  @@schema("app_quikcrm")
}

enum CrmFieldVisibility {
  visible
  hidden

  @@schema("app_quikcrm")
}

/// A top-level page of a form set version. visibility=rule_driven tabs stay
/// hidden until a show_tab action reveals them. The Call Disposition tab is
/// protected (must exist; holds the four protected fields).
model CrmFormTab {
  id                String               @id @default(cuid())
  formSetVersionId  String
  name              String
  sortOrder         Int
  visibility        CrmFormTabVisibility @default(always)
  isProtected       Boolean              @default(false)
  createdByUserId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  version           CrmFormSetVersion    @relation(fields: [formSetVersionId], references: [id])
  sections          CrmFormSection[]
  fields            CrmFormField[]
  targetedByActions CrmFormRuleAction[]

  @@index([formSetVersionId, sortOrder])
  @@schema("app_quikcrm")
}

/// A labelled grouping of fields within a tab. name may be blank.
model CrmFormSection {
  id        String         @id @default(cuid())
  formTabId String
  name      String?
  sortOrder Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tab       CrmFormTab     @relation(fields: [formTabId], references: [id])
  fields    CrmFormField[]

  @@index([formTabId, sortOrder])
  @@schema("app_quikcrm")
}

/// One IF [conditions, joined all/any] THEN [actions] rule, scoped to a version.
/// Flat: match_type applies to the whole condition list; there is no nesting.
model CrmFormRule {
  id               String                 @id @default(cuid())
  formSetVersionId String
  name             String
  matchType        CrmFormRuleMatchType
  sortOrder        Int
  isActive         Boolean                @default(true)
  createdByUserId  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  version          CrmFormSetVersion      @relation(fields: [formSetVersionId], references: [id])
  conditions       CrmFormRuleCondition[]
  actions          CrmFormRuleAction[]

  @@index([formSetVersionId, isActive, sortOrder])
  @@schema("app_quikcrm")
}

/// One flat condition: [subject] [operator] [value(s)]. No parent-condition FK.
model CrmFormRuleCondition {
  id              String                 @id @default(cuid())
  formRuleId      String
  subjectKind     CrmFormRuleSubjectKind
  subjectFieldKey String?
  operator        CrmFormRuleOperator
  /// Value key(s) compared against. Array for is_any_of/is_none_of; empty for is_empty/is_not_empty.
  valueKeys       Json?
  sortOrder       Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  rule            CrmFormRule            @relation(fields: [formRuleId], references: [id], onDelete: Cascade)

  @@index([formRuleId, sortOrder])
  @@schema("app_quikcrm")
}

/// One action a rule fires. setStatusId/setSubStatusId are logical references to
/// the lead status taxonomy (validated at save — FR-RE-A7a), not hard FKs.
model CrmFormRuleAction {
  id             String                @id @default(cuid())
  formRuleId     String
  actionType     CrmFormRuleActionType
  targetKind     CrmFormRuleTargetKind
  targetFieldKey String?
  targetTabId    String?
  setStatusId    String?
  setSubStatusId String?
  sortOrder      Int
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  rule           CrmFormRule           @relation(fields: [formRuleId], references: [id], onDelete: Cascade)
  targetTab      CrmFormTab?           @relation(fields: [targetTabId], references: [id])

  @@index([formRuleId, sortOrder])
  @@schema("app_quikcrm")
}

/// An uploaded file (e.g. payment proof). Bytes live in object storage; this row
/// holds metadata + storage key. activityId is a logical reference (matches
/// CrmFieldValue.activityId). Every read MUST be ACL-wrapped (Unit 3b).
model CrmFileAttachment {
  id          String          @id @default(cuid())
  tenantId    String
  activityId  String
  storageKey  String
  filename    String
  contentType String
  sizeBytes   Int
  uploadedBy  String
  createdAt   DateTime        @default(now())
  fieldValues CrmFieldValue[]

  @@index([tenantId, activityId])
  @@schema("app_quikcrm")
}
