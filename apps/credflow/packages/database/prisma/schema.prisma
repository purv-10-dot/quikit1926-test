// === QuikCRM — quotes, orders, documents (app code) ===

enum CrmQuoteStatus {
  Draft
  Active
  Won
  Lost
  Revised

  @@schema("app_quikcrm")
}

enum CrmQuotePricingMode {
  Exclusive
  Inclusive

  @@schema("app_quikcrm")
}

enum CrmQuoteApprovalStatus {
  None
  Pending
  Approved
  Rejected

  @@schema("app_quikcrm")
}

enum CrmQuoteEngagementStatus {
  NotSent
  Sent
  Viewed
  Signed
  Accepted
  Rejected

  @@schema("app_quikcrm")
}

enum CrmInvoiceStatus {
  Draft
  Sent
  Paid
  Void

  @@schema("app_quikcrm")
}

enum CrmProductType {
  Product
  Service
  Bundle

  @@schema("app_quikcrm")
}

enum CrmProductTaxonomyKind {
  Category
  Subcategory
  Brand
  Family

  @@schema("app_quikcrm")
}

enum CrmStockMovementType {
  Receipt
  Issue
  Adjustment
  Reserve
  Release
  Transfer

  @@schema("app_quikcrm")
}

enum CrmOrderStatus {
  Open
  Confirmed
  Fulfilled
  Closed
  Cancelled

  @@schema("app_quikcrm")
}

model CrmDocumentFolder {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  parentFolderId String?
  parentFolder   CrmDocumentFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Restrict)
  children       CrmDocumentFolder[] @relation("FolderHierarchy")

  refType String?
  refId   String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  documents CrmDocument[]

  @@index([tenantId])
  @@index([tenantId, parentFolderId])
  @@index([tenantId, refType, refId])
  @@index([tenantId, deletedAt])
  @@schema("app_quikcrm")
}

model CrmDocument {
  id          String    @id @default(cuid())
  tenantId    String
  refType     String
  refId       String
  folderId    String?
  folder      CrmDocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  fileName    String
  contentType String
  size        Int
  storageKey  String
  uploadedBy  String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  linksFrom CrmDocumentLink[] @relation("DocumentLinkSource")

  @@index([tenantId, refType, refId])
  @@index([tenantId, deletedAt])
  @@index([folderId])
  @@schema("app_quikcrm")
}

// Reuses S3 object from source document — no duplicate upload.
model CrmDocumentLink {
  id               String    @id @default(cuid())
  tenantId         String
  sourceDocumentId String
  sourceDocument   CrmDocument @relation("DocumentLinkSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetFolderId   String?
  refType          String?
  refId            String?
  createdBy        String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  @@index([tenantId, targetFolderId])
  @@index([tenantId, sourceDocumentId])
  @@index([tenantId, refType, refId])
  @@index([tenantId, deletedAt])
  @@schema("app_quikcrm")
}

model CrmProductTaxonomy {
  id        String                 @id @default(cuid())
  tenantId  String
  kind      CrmProductTaxonomyKind
  name      String
  parentId  String?
  parent    CrmProductTaxonomy?    @relation("ProductTaxonomyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  CrmProductTaxonomy[]   @relation("ProductTaxonomyTree")
  sortOrder Int                    @default(0)
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  productsAsCategory    CrmProduct[] @relation("ProductCategory")
  productsAsSubcategory CrmProduct[] @relation("ProductSubcategory")
  productsAsBrand       CrmProduct[] @relation("ProductBrand")
  productsAsFamily      CrmProduct[] @relation("ProductFamily")

  @@unique([tenantId, kind, name, parentId])
  @@index([tenantId, kind])
  @@index([tenantId, parentId])
  @@schema("app_quikcrm")
}

model CrmProduct {
  id              String         @id @default(cuid())
  tenantId        String
  name            String
  sku             String
  /// Legacy free-text category — prefer categoryId when set.
  category        String?
  categoryId      String?
  subcategoryId   String?
  brandId         String?
  familyId        String?
  barcode         String?
  tags            String[]       @default([])
  hsnCode         String?
  sacCode         String?
  unitGroup       String         @default("Each")
  defaultUnit     String         @default("Each")
  standardCost    Decimal?       @db.Decimal(18, 2)
  listPrice       Decimal        @db.Decimal(18, 2)
  currency        String         @default("INR")
  gstRate         Decimal        @db.Decimal(5, 2)
  /// Optional explicit split; when null, CGST/SGST/IGST are derived from gstRate.
  cgstRate        Decimal?       @db.Decimal(5, 2)
  sgstRate        Decimal?       @db.Decimal(5, 2)
  igstRate        Decimal?       @db.Decimal(5, 2)
  manufacturer    String?
  warrantyMonths  Int?
  weightKg        Decimal?       @db.Decimal(10, 3)
  lengthCm        Decimal?       @db.Decimal(10, 2)
  widthCm         Decimal?       @db.Decimal(10, 2)
  heightCm        Decimal?       @db.Decimal(10, 2)
  serialTracked   Boolean        @default(false)
  dynamicFields   Json?
  description     String?
  imageUrl        String?
  productType     CrmProductType @default(Product)
  isActive        Boolean        @default(true)
  deletedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  categoryRef    CrmProductTaxonomy? @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryRef CrmProductTaxonomy? @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  brandRef       CrmProductTaxonomy? @relation("ProductBrand", fields: [brandId], references: [id], onDelete: SetNull)
  familyRef      CrmProductTaxonomy? @relation("ProductFamily", fields: [familyId], references: [id], onDelete: SetNull)

  priceListItems  CrmPriceListItem[]
  variants        CrmProductVariant[]
  images          CrmProductImage[]
  inventory       CrmProductInventory[]
  stockMovements  CrmStockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([tenantId, barcode])
  @@schema("app_quikcrm")
}

model CrmProductVariant {
  id           String    @id @default(cuid())
  tenantId     String
  productId    String
  sku          String
  name         String?
  attributes   Json?
  barcode      String?
  listPrice    Decimal?  @db.Decimal(18, 2)
  standardCost Decimal?  @db.Decimal(18, 2)
  gstRate      Decimal?  @db.Decimal(5, 2)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  product      CrmProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    CrmProductInventory[]
  stockMovements CrmStockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@schema("app_quikcrm")
}

model CrmWarehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inventory CrmProductInventory[]
  stockMovements CrmStockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@schema("app_quikcrm")
}

model CrmProductInventory {
  id                String   @id @default(cuid())
  tenantId          String
  productId         String
  variantId         String?
  warehouseId       String
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  lowStockThreshold Int?
  updatedAt         DateTime @updatedAt
  product           CrmProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           CrmProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse         CrmWarehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, variantId, warehouseId])
  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@schema("app_quikcrm")
}

model CrmStockMovement {
  id              String               @id @default(cuid())
  tenantId        String
  productId       String
  variantId       String?
  warehouseId     String
  quantity        Int
  movementType    CrmStockMovementType
  reference       String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime             @default(now())
  product         CrmProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         CrmProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse       CrmWarehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, warehouseId])
  @@schema("app_quikcrm")
}

model CrmProductImage {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  url       String
  label     String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   CrmProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@schema("app_quikcrm")
}

model CrmPriceList {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  currency          String    @default("INR")
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  isActive          Boolean   @default(true)
  isDefault         Boolean   @default(false)
  regionCode        String?
  customerTier      String?
  versionNumber     Int       @default(1)
  sourcePriceListId String?
  deletedAt         DateTime?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  items             CrmPriceListItem[]
  quotes            CrmQuote[]
  opportunities     CrmOpportunity[]
  accountsDefault   CrmAccount[] @relation("AccountDefaultPriceList")
  sourcePriceList   CrmPriceList?  @relation("PriceListClone", fields: [sourcePriceListId], references: [id], onDelete: SetNull)
  clonedLists       CrmPriceList[] @relation("PriceListClone")
  auditLogs         CrmPriceListAuditLog[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive])
  @@index([tenantId, regionCode])
  @@index([tenantId, customerTier])
  @@schema("app_quikcrm")
}

/// Quantity-based pricing bracket — one row per (product, minQuantity) tier.
model CrmPriceListItem {
  id              String       @id @default(cuid())
  tenantId        String
  priceListId     String
  productId       String
  unitPrice       Decimal      @db.Decimal(18, 2)
  discountPct     Decimal      @default(0) @db.Decimal(5, 2)
  minQuantity     Int          @default(1)
  floorPrice      Decimal?     @db.Decimal(18, 2)
  notes           String?
  sortOrder       Int          @default(0)
  deletedAt       DateTime?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  priceList       CrmPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product         CrmProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, priceListId])
  @@index([tenantId, priceListId, deletedAt])
  @@index([tenantId, productId])
  @@schema("app_quikcrm")
}

model CrmPriceListAuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  priceListId String
  itemId      String?
  action      String
  summary     String
  changes     Json?
  userId      String?
  userName    String?
  createdAt   DateTime @default(now())
  priceList   CrmPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, priceListId, createdAt])
  @@schema("app_quikcrm")
}

model CrmQuote {
  id                    String             @id @default(cuid())
  tenantId              String
  quoteNumber           String
  versionNumber         Int                @default(1)
  parentQuoteId         String?
  accountId             String
  contactId             String?
  opportunityId         String?
  priceListId           String?
  currency              String             @default("INR")
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  status                CrmQuoteStatus     @default(Draft)
  pricingMode           CrmQuotePricingMode @default(Exclusive)
  companyState          String?
  billingState          String?
  subtotal              Decimal            @default(0) @db.Decimal(18, 2)
  totalLineDiscount     Decimal            @default(0) @db.Decimal(18, 2)
  overallDiscountAmount Decimal            @default(0) @db.Decimal(18, 2)
  freightAmount         Decimal            @default(0) @db.Decimal(18, 2)
  taxableAmount         Decimal            @default(0) @db.Decimal(18, 2)
  cgstAmount            Decimal            @default(0) @db.Decimal(18, 2)
  sgstAmount            Decimal            @default(0) @db.Decimal(18, 2)
  igstAmount            Decimal            @default(0) @db.Decimal(18, 2)
  roundOffAmount        Decimal            @default(0) @db.Decimal(18, 2)
  grandTotal            Decimal            @default(0) @db.Decimal(18, 2)
  grandTotalInWords     String?
  termsText             String?
  ownerId               String?
  ownerName             String?
  sentAt                DateTime?
  wonAt                 DateTime?
  lostAt                DateTime?
  lostReason            String?
  lostNotes             String?
  templateKey           String             @default("b2b-standard")
  approvalStatus        CrmQuoteApprovalStatus @default(None)
  engagementStatus      CrmQuoteEngagementStatus @default(NotSent)
  portalTokenHash       String?
  portalExpiresAt       DateTime?
  firstViewedAt         DateTime?
  lastViewedAt          DateTime?
  lastViewedIp          String?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  rejectedReason        String?
  customerComment       String?
  signedAt              DateTime?
  signatureJson         Json?
  signatureOtpVerified  Boolean            @default(false)
  watermarkText         String?
  bankDetailsJson       Json?
  lockedSnapshotAt      DateTime?
  deletedAt             DateTime?
  createdByUserId       String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  priceList             CrmPriceList?      @relation(fields: [priceListId], references: [id])
  lines                 CrmQuoteLine[]
  transitions           CrmQuoteStatusTransition[]
  order                 CrmOrder?
  approvals             CrmQuoteApproval[]
  pdfSnapshots          CrmQuotePdfSnapshot[]
  comments              CrmQuoteComment[]
  engagements           CrmQuoteEngagementEvent[]
  portalAccess          CrmQuotePortalAccess[]
  invoice               CrmInvoice?

  @@unique([tenantId, quoteNumber])
  @@unique([tenantId, portalTokenHash])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, accountId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, ownerId])
  @@index([tenantId, parentQuoteId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, approvalStatus])
  @@schema("app_quikcrm")
}

model CrmQuoteLine {
  id             String   @id @default(cuid())
  tenantId       String
  quoteId        String
  lineNumber     Int
  productId      String?
  productName    String
  sku            String?
  hsnCode        String?
  description    String?
  quantity       Decimal  @db.Decimal(18, 4)
  unit           String   @default("Each")
  unitPrice      Decimal  @db.Decimal(18, 2)
  discountPct    Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  taxableAmount  Decimal  @default(0) @db.Decimal(18, 2)
  gstRate        Decimal  @db.Decimal(5, 2)
  cgstAmount     Decimal  @default(0) @db.Decimal(18, 2)
  sgstAmount     Decimal  @default(0) @db.Decimal(18, 2)
  igstAmount     Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 2)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  quote          CrmQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
  @@schema("app_quikcrm")
}

model CrmQuoteStatusTransition {
  id              String         @id @default(cuid())
  tenantId        String
  quoteId         String
  fromStatus      CrmQuoteStatus
  toStatus        CrmQuoteStatus
  changedByUserId String?
  changedByName   String?
  reason          String?
  notes           String?
  createdAt       DateTime       @default(now())
  quote           CrmQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
  @@schema("app_quikcrm")
}

model CrmQuoteTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  key             String
  name            String
  description     String?
  layout          String   @default("b2b")
  themeColor      String   @default("#1d4ed8")
  headerHtml      String?
  footerHtml      String?
  termsDefault    String?
  bankDetailsJson Json?
  watermarkText   String?
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
  @@schema("app_quikcrm")
}

model CrmQuoteApproval {
  id              String                @id @default(cuid())
  tenantId        String
  quoteId         String
  status          CrmQuoteApprovalStatus @default(Pending)
  triggerReason   String
  requestedById   String?
  requestedByName String?
  decidedById     String?
  decidedByName   String?
  decisionNotes   String?
  requestedAt     DateTime              @default(now())
  decidedAt       DateTime?
  quote           CrmQuote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
  @@index([tenantId, status])
  @@schema("app_quikcrm")
}

model CrmQuotePdfSnapshot {
  id              String   @id @default(cuid())
  tenantId        String
  quoteId         String
  versionNumber   Int
  templateKey     String
  documentId      String?
  storageKey      String?
  contentHash     String?
  fileName        String
  contentType     String   @default("application/pdf")
  size            Int      @default(0)
  isLocked        Boolean  @default(true)
  generatedById   String?
  generatedByName String?
  createdAt       DateTime @default(now())
  quote           CrmQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId, createdAt])
  @@schema("app_quikcrm")
}

model CrmQuoteComment {
  id          String   @id @default(cuid())
  tenantId    String
  quoteId     String
  body        String
  mentions    Json?
  authorId    String?
  authorName  String?
  isInternal  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quote       CrmQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId, createdAt])
  @@schema("app_quikcrm")
}

