/// Mapping "diary" for the QuikCRM <-> LeadSquared two-way sync.
/// One row per synced lead. Holds the cross-system id link plus the two
/// pieces of state the loop guard needs to break echo loops:
///   - syncOrigin: which side authored the most recent write we processed.
///   - lastPayloadHash: the stable hash of the field set we last synced, so a
///     write that produces an identical payload (an echo) is dropped.
/// Delete-sync is intentionally NOT modelled here yet; when it lands it can add
/// a `deletedAt` / `deleteSyncedAt` column without touching the loop guard.
model LeadSquaredSyncMap {
  id              String    @id @default(cuid())
  tenantId        String
  /// FK to the QuikCRM lead. One mapping row per lead.
  crmLeadId       String    @unique
  /// LeadSquared ProspectId. Null until the first outbound push returns one
  /// (or the first inbound webhook matches an existing lead).
  lsqProspectId   String?
  /// Which system authored the write we last recorded: "crm" | "leadsquared".
  /// Stored as a String (matching the CrmLead.stage/status convention) and
  /// narrowed to the SyncOrigin union in the loop-guard module.
  syncOrigin      String
  /// Stable sha256 of the last payload we synced. Used to drop echoes.
  lastPayloadHash String?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lead            CrmLead   @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  @@unique([tenantId, lsqProspectId], name: "leadsquared_prospect_uk")
  @@index([tenantId])
  @@schema("app_quikcrm")
}

