/// Per-lead/day loop guard counter (SPEC §6 / Build-Plan Task 2.1).
/// Counts lead-mutating automated writes per lead per UTC calendar day, shared
/// by BOTH the workflow engine AND the legacy disposition engine so a
/// cross-engine ping-pong is caught below either engine's individual cap. When
/// `count` exceeds the cap the run is terminated and `terminated` is set
/// (observable). `day` is a YYYY-MM-DD UTC string (the app is UTC-only).
model CrmAutomationLeadDayCount {
  id         String   @id @default(cuid())
  tenantId   String
  leadId     String
  day        String
  count      Int      @default(0)
  terminated Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([tenantId, leadId, day])
  @@index([tenantId, terminated])
  @@schema("app_quikcrm")
}

/// Per-write attribution for automated lead changes (SPEC §8 / Build-Plan Task
/// 2.2). One row per automated field write, answering "why did this lead
/// change?" in a single read: which engine, which automation + rule/node, which
/// trigger event, the before→after value, and the trigger-time field snapshot.
/// Written by BOTH engines; `engineSource` discriminates
/// "automation" vs "legacy-disposition" (ties to the §6 dual-engine guard).
model CrmAutomationAttribution {
  id              String   @id @default(cuid())
  tenantId        String
  leadId          String
  engineSource    String
  workflowId      String?
  nodeId          String?
  ruleId          String?
  triggerEventId  String?
  triggerType     String?
  field           String
  beforeValue     String?
  afterValue      String?
  triggerSnapshot Json?
  createdAt       DateTime @default(now())
  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, engineSource])
  @@schema("app_quikcrm")
}

