# =============================================================================
# CredFlow (apps/credflow) — environment template
# =============================================================================
# Copy to `.env.local` and fill in real values.  NEVER commit `.env.local`.
# This file contains PLACEHOLDERS ONLY — no real secret belongs here.
#
# Every variable below maps to a real read in `apps/credflow`, either:
#   (a) the zod schema in `lib/env.ts` (parsed via `envSchema.safeParse(process.env)`
#       at lib/env.ts:120 — those have a documented default where one exists), or
#   (b) a direct `process.env.X` read (file:line cited inline), or
#   (c) the Prisma datasource block in packages/database/prisma/schema.prisma:9-10.
#
# -----------------------------------------------------------------------------
# MANDATORY IN PRODUCTION — the app will not start / will hard-fail without these
# -----------------------------------------------------------------------------
#   DATABASE_URL              lib/env.ts:7  — z.string().min(1), no default
#   JWT_SECRET                lib/env.ts:9  — >=16 chars, and in prod >=32 chars and
#                                             not matching /change-me|dev-only|placeholder/
#                                             (throws at lib/env.ts:126-128)
#   NEXTAUTH_SECRET           app/auth-handoff/route.ts:39 — handoff returns 500 without it
#   NEXTAUTH_URL              packages/auth/public-url.ts:53 — see WARNING below
#   RP_DIGITAL_WEBHOOK_SECRET required when WEBHOOK_REQUIRE_SECRET=true
#                                             (throws at lib/env.ts:129-131)
#   QUIKIT_CLIENT_ID          lib/auth.ts:5  — see FAIL-OPEN #3 below
#   QUIKIT_CLIENT_SECRET      lib/auth.ts:6
#   QUIKIT_URL (or QUIKIT_ISSUER_URL)         lib/auth.ts:4
#
# -----------------------------------------------------------------------------
# SECURITY CONTROLS THAT SILENTLY FAIL **OPEN** WHEN LEFT BLANK
# -----------------------------------------------------------------------------
# These do NOT error. They degrade quietly, so a blank value looks like a
# working deploy while the control is off. Set all of them in production.
#
#  1) NEXT_PUBLIC_AUTH_URL + INTERNAL_SECRET  (middleware.ts:3, packages/auth/verify-token-remote.ts:38-39)
#     Remote session validation returns {valid:false, error:"Auth service not configured"}
#     when either is unset. packages/auth/middleware.ts:106 tolerates the `error`
#     branch, so requests are ALLOWED through — session revocation, org-suspension
#     and trial-expiry gates all stop working with no visible symptom.
#
#  2) REDIS_URL  (lib/handoff-replay.ts:24-25)
#     Single-use `jti` enforcement on SSO handoff tokens. With Redis unset,
#     consumeHandoffJti() returns true unconditionally — a captured handoff token
#     can be replayed within its freshness window. Redis also gates BullMQ
#     (imports, SLA, automation), rate-limiting and kanban SSE; all no-op silently.
#
#  3) QUIKIT_CLIENT_ID / QUIKIT_CLIENT_SECRET / QUIKIT_URL  (lib/auth.ts:4-8)
#     If ANY of the three is missing, lib/auth.ts falls back from
#     createOAuthClientOptions() to createAuthOptions() with no error — you get a
#     completely different auth provider than intended.
#
#  4) WEBHOOK_REQUIRE_SECRET  (defaults to "false" — lib/env.ts:44)
#     Telephony webhook auth. lib/services/telephony/webhook-handler.ts:393-399
#     forces the requirement when NODE_ENV=production, so prod is safe by default;
#     any NON-production deployment (staging/UAT) with this unset accepts unsigned
#     webhooks. Set it to "true" explicitly on every non-local environment.
#
# NOT fail-open (verified — these block correctly in production):
#   CRON_SECRET                      app/api/notifications/tasks/daily/route.ts:47-52 (403s in prod)
#   LEADSQUARED_WEBHOOK_SECRET       lib/services/leadsquared/inbound.ts:681-684 (503s in prod)
#
# -----------------------------------------------------------------------------
# WARNING — NEXTAUTH_URL semantics changed vs the standalone UAT app
# -----------------------------------------------------------------------------
# UAT built every redirect from `request.url`. The monorepo routes them through
# publicBaseUrl() (packages/auth/public-url.ts:51-72), which PREFERS NEXTAUTH_URL.
# It must be CREDFLOW'S OWN public origin. If it points at the auth app instead,
# auth-handoff sets the session cookie on CredFlow's host and then redirects to a
# different host → infinite login loop.
# =============================================================================


# ── Database ─────────────────────────────────────────────────────────────────
# Runtime connection (pooler in transaction mode in prod).
# Prisma reads both names from packages/database/prisma/schema.prisma:9-10.
DATABASE_URL=<postgresql://user:password@host:5432/dbname>
# Direct (non-pooled) connection — used for migrations / DDL / advisory locks.
# Local dev without a pooler: same value as DATABASE_URL.
DATABASE_URL_DIRECT=<postgresql://user:password@host:5432/dbname>


# ── NextAuth / QuikIT SSO ────────────────────────────────────────────────────
# CredFlow's OWN public origin (see WARNING above). Local dev = http://localhost:3076.
NEXTAUTH_URL=<https://credflow.example.com>
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
# Shared secret for internal service-to-service calls (handoff verify + remote
# session validation). app/auth-handoff/route.ts:38, packages/auth/middleware.ts:43,104
INTERNAL_SECRET=<set-in-prod>

# OAuth client registration for the QuikIT identity provider. lib/auth.ts:4-6
QUIKIT_URL=<https://quikit.example.com>
QUIKIT_ISSUER_URL=<https://quikit.example.com>
QUIKIT_CLIENT_ID=<set-in-prod>
QUIKIT_CLIENT_SECRET=<set-in-prod>

# Auth app origin — drives centralLoginUrl and remote session validation.
# middleware.ts:3 ; packages/auth/verify-token-remote.ts:38
NEXT_PUBLIC_AUTH_URL=<https://auth.example.com>
# QuikIT launcher origin — centralSelectOrgUrl (middleware.ts:4) and invite links
# (lib/services/settings/invite-helpers.ts:43). Unset → invite URLs silently fall
# back to http://localhost:3001.
NEXT_PUBLIC_QUIKIT_URL=<https://quikit.example.com>


# ── JWT / cookies (lib/env.ts:9-14) ──────────────────────────────────────────
# >=16 chars; >=32 and non-placeholder enforced in production (lib/env.ts:126-128).
JWT_SECRET=<generate-a-32+-char-random-string>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# AES-GCM key seed for at-rest field encryption. Falls back to JWT_SECRET when
# unset (lib/crypto/aes-gcm.ts:20) — set it explicitly in production.
CRYPTO_SECRET=<set-in-prod>


# ── Org defaults ─────────────────────────────────────────────────────────────
# Fallback org slug/id when a request carries no org context. lib/env.ts:15
DEFAULT_ORG_ID=shield
# Seeded demo-user password (dev/seed only). lib/env.ts:16
SEED_DEMO_PASSWORD=<dev-only>


# ── Redis / queues ───────────────────────────────────────────────────────────
# Optional but STRONGLY recommended in prod — see FAIL-OPEN #2 above.
# Powers BullMQ (imports, SLA, automation), rate limiting, kanban SSE, and the
# SSO handoff replay guard. lib/env.ts:8, lib/db/redis.ts:20
REDIS_URL=<redis://localhost:6379>

# BullMQ worker tuning (lib/queue/worker.ts). All optional.
# "1" = run only the automation queue (worker.ts:121)
WORKER_AUTOMATION_ONLY=
# worker.ts:142
AUTOMATION_CONCURRENCY=10
# worker.ts:151
IMPORT_CONCURRENCY=4
# worker.ts:170
LEADSQUARED_SYNC_CONCURRENCY=5
# worker.ts:191
LEADSQUARED_INBOUND_CONCURRENCY=5


# ── Telephony: RP Digital / IndiaVoice ───────────────────────────────────────
# Auth precedence: RP_DIGITAL_AUTHCODE (preferred, sent as `authcode` query param)
# takes priority over HTTP Basic (RP_DIGITAL_BASIC_USER + RP_DIGITAL_BASIC_PASSWORD).
# UAT ran on Basic auth with AUTHCODE left blank — confirm which the client uses.
RP_DIGITAL_BASE_URL=https://indiavoice.rpdigitalphone.com
RP_DIGITAL_AUTHCODE=<set-in-prod-or-leave-blank-if-using-basic>
RP_DIGITAL_BASIC_USER=<set-in-prod>
RP_DIGITAL_BASIC_PASSWORD=<set-in-prod>
RP_DIGITAL_DESKPHONE=<set-in-prod>
# Default agent number (Party A). Blank = the dialer must always send `partyA`,
# otherwise the call falls back to DESKPHONE and usually won't ring an agent.
RP_DIGITAL_CALLING_PARTY_A=
RP_DIGITAL_CALL_LIMIT=6516839
# NOTE: static/shared across all calls and orgs on both UAT and monorepo
# (lib/services/telephony/india-voice.ts:389). Per-call uid is a known open item.
RP_DIGITAL_UID=3641
RP_DIGITAL_CALL_FROM_DID=1
RP_DIGITAL_WAITTIME=30
RP_DIGITAL_HTTP_TIMEOUT_MS=30000
RP_DIGITAL_WORKING_STATUS_DIRECTION=IVR
# Verbose telephony request/response logging (auto-on outside production).
RP_DIGITAL_TELEPHONY_DEBUG=


# ── Webhook receiver (telephony) ─────────────────────────────────────────────
# Required when WEBHOOK_REQUIRE_SECRET=true; also enforced whenever
# NODE_ENV=production (webhook-handler.ts:393-399 → 503 if missing).
RP_DIGITAL_WEBHOOK_SECRET=<set-in-prod>
# Set to "true" on EVERY non-local environment — see FAIL-OPEN #4 above.
WEBHOOK_REQUIRE_SECRET=true
# IndiaVoice's panel does not include an org id in its event payload, so the
# handler cannot infer it. Pinning it here keeps the configured webhook URL clean.
WEBHOOK_DEFAULT_ORG_ID=<org-id>
# "false"/"0" stops the handler trusting an org id supplied in the payload.
WEBHOOK_TRUST_PAYLOAD_ORG_ID=true


# ── Cron ─────────────────────────────────────────────────────────────────────
# Bearer token for the daily task-notification cron. Blocks in production when
# unset (app/api/notifications/tasks/daily/route.ts:47-52).
CRON_SECRET=<set-in-prod>


# ── Email ────────────────────────────────────────────────────────────────────
# Driver selector: console (default) | resend | brevo | office365.
# lib/services/email/send.ts:74
EMAIL_PROVIDER=office365
# Default From when a caller passes no override. send.ts:96
# Format: "Display Name <address@domain>"
EMAIL_FROM=<set-in-prod>

# office365 / generic SMTP (lib/services/email/send.ts:303-310, send-report.ts:42-67)
SMTP_HOST=<smtp.office365.com>
SMTP_PORT=587
SMTP_USER=<mailbox@example.com>
SMTP_PASS=<set-in-prod>
# FROM must be the authenticated mailbox or an allowed send-as alias — M365
# rejects anything else.
SMTP_FROM=<mailbox@example.com>
# Legacy aliases still read by send.ts:308-309 and :349-350.
EMAIL_USER=<mailbox@example.com>
# NOTE: @next/env expands `$VAR` inside .env files — escape any literal `$` as `\$`
# or the password will silently break.
EMAIL_PASSWORD=<set-in-prod>

# resend driver (send.ts:193, send-report.ts:159)
RESEND_API_KEY=<set-in-prod>
# brevo driver (send.ts:230)
BREVO_API_KEY=<set-in-prod>


# ── LeadSquared: connection ──────────────────────────────────────────────────
# India (in21) SYNCHRONOUS API host — NOT the asyncapi- host. lib/env.ts:53
LEADSQUARED_HOST=https://api-in21.leadsquared.com
LEADSQUARED_ACCESS_KEY=<set-in-prod>
LEADSQUARED_SECRET_KEY=<set-in-prod>
LEADSQUARED_HTTP_TIMEOUT_MS=30000

# ── LeadSquared: inbound webhook ─────────────────────────────────────────────
LEADSQUARED_WEBHOOK_SECRET=<set-in-prod>
# Org resolution for inbound LSQ events, in order: this →
# WEBHOOK_DEFAULT_ORG_ID → DEFAULT_ORG_ID. Never taken from the payload.
# lib/services/leadsquared/inbound.ts:699-703
LEADSQUARED_DEFAULT_ORG_ID=<org-id>
# route.ts:36, default 1_000_000
LEADSQUARED_WEBHOOK_MAX_BYTES=1000000
# route.ts:37, default 600
LEADSQUARED_WEBHOOK_RATE_LIMIT=600
# route.ts:38
LEADSQUARED_WEBHOOK_RATE_WINDOW_SEC=

# ── LeadSquared: field SchemaNames (mx_...) ──────────────────────────────────
# Unset => that field is skipped (backward-compatible).
# LEADSQUARED_SCHEMA_STAGE overrides the standard "ProspectStage" default.
LEADSQUARED_SCHEMA_STAGE=
LEADSQUARED_SCHEMA_SUBSTAGE=
LEADSQUARED_SCHEMA_STATUS=
LEADSQUARED_SCHEMA_REMARKS=
LEADSQUARED_SCHEMA_COUNTRY=
LEADSQUARED_SCHEMA_INDUSTRY=
LEADSQUARED_SCHEMA_WEBSITE=
LEADSQUARED_SCHEMA_ADDRESS1=
LEADSQUARED_SCHEMA_ADDRESS2=
LEADSQUARED_SCHEMA_CITY=
LEADSQUARED_SCHEMA_STATE=
LEADSQUARED_SCHEMA_ZIP=
# Ambiguous — enable only after confirming the SchemaName with the client.
LEADSQUARED_SCHEMA_JOBTITLE=
LEADSQUARED_SCHEMA_SECONDARY_EMAIL=
LEADSQUARED_SCHEMA_ANNUAL_REVENUE=
LEADSQUARED_SCHEMA_LEAD_TYPE=
LEADSQUARED_SCHEMA_CONTACT_LINKEDIN=
LEADSQUARED_SCHEMA_AREA=

# ── LeadSquared: picklist value maps ─────────────────────────────────────────
# JSON objects, e.g. {"Won":"ClosedWon"}. For Select/Dropdown fields these also
# act as an allowlist — an out-of-list value is skipped rather than 500-ing the lead.
LEADSQUARED_STAGE_VALUE_MAP=
LEADSQUARED_SUBSTAGE_VALUE_MAP=
LEADSQUARED_STATUS_VALUE_MAP=
LEADSQUARED_INDUSTRY_VALUE_MAP=
LEADSQUARED_SOURCE_VALUE_MAP=
# Opt-in: auto-resolve missing SchemaNames via LeadsMetaData.Get (cached).
LEADSQUARED_METADATA_AUTORESOLVE=
# field-map-resolver.ts:157, default 1h
LEADSQUARED_METADATA_TTL_MS=3600000
# Validate configured SchemaNames and WARN on mismatch. Default ON; "false" disables.
LEADSQUARED_VALIDATE_SCHEMA=
# Skip a picklist attribute when its value isn't in the map. Default ON.
LEADSQUARED_SKIP_UNKNOWN_PICKLIST=

# ── LeadSquared: inbound poller (safety net for changes that fire no webhook) ─
# Interval in ms; 0 or unset = poller DISABLED. e.g. 300000 for 5 min.
LEADSQUARED_POLL_INTERVAL_MS=0
# first-run look-back (10 min)
LEADSQUARED_POLL_WINDOW_MS=600000
# re-scan overlap to avoid boundary misses
LEADSQUARED_POLL_OVERLAP_MS=120000
LEADSQUARED_POLL_PAGE_SIZE=200
# +330 = IST
LEADSQUARED_TZ_OFFSET_MINUTES=330


# ── Imports ──────────────────────────────────────────────────────────────────
IMPORT_MAX_ATTEMPTS=3
IMPORT_WORKER_NAME=import-worker


# ── Rate limiting (lib/env.ts:17-18) ─────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120


# ── File storage (S3-compatible) — lib/s3.ts:14-17 ───────────────────────────
AWS_REGION=<ap-south-1>
AWS_S3_BUCKET=<bucket-name>
AWS_ACCESS_KEY_ID=<set-in-prod>
AWS_SECRET_ACCESS_KEY=<set-in-prod>


# ── Feature flags / tuning ───────────────────────────────────────────────────
# Auto-create a follow-up task on lead creation. Default OFF. lib/services/leads/auto-task.ts:13
AUTO_TASK_ON_LEAD_CREATE=
# Escape hatch: let form-rule apply write `stage`. Default OFF; automation owns
# stage. Set to "1" only deliberately. lib/services/forms/form-rule-apply.service.ts:173
FRRE_APPLY_STAGE=
# Automation loop guard cap. lib/services/automation/loop-guard.ts:24
AUTOMATION_LOOP_CAP=
# Max rows per CSV/XLSX report export. Default 50_000.
# lib/services/reports/csv-stream.ts:26, xlsx-stream.ts:17
REPORTS_CSV_MAX_ROWS=50000


# ── Client-side (NEXT_PUBLIC_*) ──────────────────────────────────────────────
# ⚠ Next.js INLINES these into the client bundle at BUILD time. They must be
# present in the build environment (Docker ARG/ENV or turbo.json `build.env`),
# not just at runtime, or the bundle ships `undefined` and silently uses fallbacks.
# Builds the Open/Snooze deep-links inside task emails. lib/notifications/email-templates.ts:224
NEXT_PUBLIC_APP_URL=<https://credflow.example.com>
# Dashboard auto-refresh interval. Default 60000. components/dashboard/dashboard-client.tsx:28
NEXT_PUBLIC_DASHBOARD_REFRESH_MS=60000


# =============================================================================
# DEV / SCRIPT-ONLY — not read by the running app. Set ad hoc when invoking the
# script, do not put them in a production environment.
#   SEED_TENANT_ID          scripts/seed-clean-automations.ts:38, seed-stage-status-mapping.ts:17
#   SEED_DRAFT              scripts/seed-clean-automations.ts:39
#   TENANT_ID               scripts/tmp-create-rules-from-map.mjs:45 (+3 other tmp scripts)
#   LEADSQUARED_WEBHOOK_URL scripts/tmp-inbound-update-test.mjs:22 (+2)
#   PROBE_PROSPECT_ID       scripts/tmp-lsq-activity-probe.mjs:19
#   TYPES                   scripts/tmp-lsq-activity-fields.mjs:12
# =============================================================================
