{
  "name": "quiklms",
  "version": "1.0.0",
  "private": true,
  "description": "QuikSkill LMS — unified Next.js (App Router) + PostgreSQL/Prisma re-platform",
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "worker:dev": "npm --workspace worker run dev",
    "worker:start": "npm --workspace worker run start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@aws-sdk/s3-request-presigner": "^3.665.0",
    "@prisma/client": "^5.22.0",
    "@quikit/auth": "*",
    "@quikit/database": "*",
    "@quikit/shared": "*",
    "argon2": "^0.41.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.18.0",
    "next": "14.0.4",
    "next-auth": "^4.24.0",
    "next-intl": "^3.21.1",
    "nodemailer": "^6.9.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.80.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "resend": "^4.0.0",
    "socket.io-client": "^4.8.3",
    "twilio": "^5.3.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.0.4",
    "mongodb": "^6.10.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
