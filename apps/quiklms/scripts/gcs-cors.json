[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE"],
    "responseHeader": [
      "Content-Type",
      "Content-Length",
      "Content-Disposition",
      "Content-Range",
      "Range",
      "ETag",
      "x-goog-resumable",
      "x-goog-content-length-range"
    ],
    "maxAgeSeconds": 3600
  }
]
