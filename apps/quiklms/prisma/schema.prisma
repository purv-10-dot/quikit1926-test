// ============================================================================
// QuikSkill LMS — Prisma schema (PostgreSQL)
// Phase 1 of the NestJS/Mongo → Next.js/Postgres re-platform.
//
// Source of truth: the 55 Mongoose schemas under QuikSkillsbackend/src.
//
// FK STRATEGY = HYBRID (approved):
//   • Real Prisma relations for OWNING AGGREGATES (Course→Module→Lesson,
//     Exam→ExamQuestion, Conversation→Message→Reaction, Batch→children, …)
//     and the §8 JOIN/CHILD tables (group_members, batch_students, user_parents,
//     exam_questions, payout_*, course prerequisites, the split-out subdoc arrays).
//   • `orgId` and every ACTOR reference (userId / teacherId / learnerId /
//     studentId / createdBy / authorId / …) are indexed `String` SCALARS with
//     NO relation — identical to MongoDB (which enforced no FKs) and enforced at
//     the app layer by the mandatory tenantScope() helper (Phase 2).
//   • CROSS-aggregate references (notably `courseId`, which in the legacy data
//     points at EITHER the `courses` OR `mastercourses` collection) are also
//     scalar Strings, so the ETL never fails on a mixed-target id.
//
// CONVENTIONS:
//   • ObjectId → String @id @default(uuid())
//   • Mongo TTL collections (otps 600s, analytics-cache) keep `expiresAt`;
//     a worker cron purges them (Phase 4).
//   • Json columns per §8: all *Config blobs, exam/assessment settings,
//     progress.lessonProgress, examSession.answers, proctoringFlags,
//     providerMetadata, notificationPreferences, textPlacements, eventData, …
//   • Enum member name = stored value when it is a valid identifier; otherwise
//     an identifier + @map("<exact stored value>").
//   • Join/child tables intentionally OMIT a denormalized orgId — they are
//     tenant-scoped through their parent (documented deviation from the blanket
//     "all tables get orgId" rule, to avoid denormalization drift).
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // Isolated output: this monorepo's ROOT node_modules/@prisma/client is
  // generated from packages/database (the org/quikscale schema, User.orgId, no
  // Course). quiklms is a workspace member, so a bare `@prisma/client` import
  // hoists to that root client and rejects this app's orgId/Course models.
  // Generating here + the tsconfig `@prisma/client` alias keeps this client
  // fully isolated and un-clobberable by root's `prisma generate`.
  output = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

