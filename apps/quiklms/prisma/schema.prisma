  orgId                     String
  batchId                      String // scalar
  teacherId                    String // actor scalar
  lastNotifiedScheduledClassId String // scalar
  notifiedAt                   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, batchId, teacherId])
  @@index([batchId])
  @@index([teacherId])
  @@map("teacher_lateness_reminder_logs")
}

// ════════════════════════════════════════════════════════════════════════════
// EXAMS, QUESTION-BANK, PROCTORING, QUIZ-PROCTORING
// ════════════════════════════════════════════════════════════════════════════

model Question {
  id            String           @id @default(uuid())
  orgId      String
  createdBy     String // actor scalar
  subject       String
  topic         String?
  difficulty    Difficulty       @default(medium)
  tags          String[]         @default([])
  type          BankQuestionType
  text          String
  imageUrl      String?
  audioUrl      String?
  options       Json             @default("[]") // [{ text, isCorrect }]
  correctAnswer Json? // boolean | string | string[]
  points        Int              @default(1)
  negativeMarks Int              @default(0)
  explanation   String?
  isActive      Boolean          @default(true)
  version       Int              @default(1)

  examQuestions ExamQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, subject, difficulty])
  @@index([orgId, type])
  @@index([orgId, tags])
  @@map("questions")
}

model Exam {
  id                    String                @id @default(uuid())
  orgId              String
  createdBy             String // actor scalar
  title                 String
  description           String                @default("")
  instructions          String                @default("")
  subject               String                @default("")
  batchId               String?
  batch                 Batch?                @relation(fields: [batchId], references: [id])
  duration              Int // minutes
  totalMarks            Int                   @default(0)
  questionSelectionMode QuestionSelectionMode @default(manual)
  autoSelectRules       Json? // { count, difficulty?, subject?, tags? }
  settings              Json                  @default("{}") // ExamSettings (defaults applied in service layer)
  proctoringLevel       ProctoringLevel       @default(soft)
  scheduledStartTime    DateTime?
  scheduledEndTime      DateTime?
  status                ExamStatus            @default(draft)
  resultPublishedAt     DateTime?

  questions ExamQuestion[]
  sessions  ExamSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, batchId, status])
  @@index([orgId, status, scheduledStartTime])
  @@map("exams")
}

// Exam.questions[] (exam_questions)
model ExamQuestion {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  points     Int      @default(1)
  order      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, questionId])
  @@index([questionId])
  @@map("exam_questions")
}

model ExamSession {
  id                String            @id @default(uuid())
  orgId          String
  examId            String
  exam              Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId         String // actor scalar
  startedAt         DateTime?
  endedAt           DateTime?
  serverDeadline    DateTime?
  status            ExamSessionStatus @default(not_started)
  answers           Json              @default("{}") // Map<questionId, AnswerEntry> per §8
  lastSavedAt       DateTime?
  assignedQuestions Json              @default("[]") // [{ questionId, order }]
  score             Float?
  totalPoints       Float?
  percentage        Float?
  passed            Boolean?
  teacherRemarks    String?
  gradedBy          String? // actor scalar
  gradedAt          DateTime?
  proctoringFlags   Json              @default("{}") // per §8
  isReconnection    Boolean           @default(false)
  disconnectedAt    DateTime?
  reconnectedAt     DateTime?

  logs            ProctoringLog[]
  incidentReports IncidentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, examId, studentId])
  @@index([status, serverDeadline])
  @@map("exam_sessions")
}

model ProctoringLog {
  id        String              @id @default(uuid())
  orgId  String
  sessionId String
  session   ExamSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String // actor scalar
  eventType ProctoringEventType
  timestamp DateTime
  metadata  Json?
  severity  ProctoringSeverity  @default(low)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, eventType])
  @@index([sessionId, timestamp])
  @@map("proctoring_logs")
}

model IncidentReport {
  id          String              @id @default(uuid())
  orgId    String
  sessionId   String
  session     ExamSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  examId      String // scalar
  reviewedBy  String? // actor scalar
  reviewedAt  DateTime?
  flagSummary Json                @default("{}")
  disposition IncidentDisposition @default(pending)
  action      IncidentAction      @default(none)
  remarks     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId, disposition])
  @@index([sessionId])
  @@map("incident_reports")
}

model QuizProctoringSession {
  id                        String            @id @default(uuid())
  orgId                  String
  assessmentId              String // scalar (ObjectId OR master-course UUID)
  courseId                  String // scalar
  learnerId                 String // actor scalar
  startedAt                 DateTime?
  endedAt                   DateTime?
  serverDeadline            DateTime?
  status                    QuizSessionStatus @default(in_progress)
  proctoringFlags           Json              @default("{}") // incl. face_* counters
  isReconnection            Boolean           @default(false)
  disconnectedAt            DateTime?
  reconnectedAt             DateTime?
  selectedQuestionIndices   Int[]             @default([]) // empty = serve all
  selectedAdditionalIndices Int[]             @default([])
  questionManifest          Json? // [{ pool: 'main'|'additional', index }]

  logs            QuizProctoringLog[]
  incidentReports QuizIncidentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, assessmentId, learnerId])
  @@index([status, serverDeadline])
  @@map("quiz_proctoring_sessions")
}

model QuizProctoringLog {
  id        String                  @id @default(uuid())
  orgId  String
  sessionId String
  session   QuizProctoringSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId String // actor scalar
  eventType QuizProctoringEventType
  timestamp DateTime
  metadata  Json?
  severity  ProctoringSeverity      @default(low)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, eventType])
  @@index([sessionId, timestamp])
  @@map("quiz_proctoring_logs")
}

model QuizIncidentReport {
  id           String                @id @default(uuid())
  orgId     String
  sessionId    String
  session      QuizProctoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assessmentId String // scalar
  reviewedBy   String? // actor scalar
  reviewedAt   DateTime?
  flagSummary  Json                  @default("{}")
  disposition  IncidentDisposition   @default(pending)
  action       IncidentAction        @default(none)
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId, disposition])
  @@index([sessionId])
  @@map("quiz_incident_reports")
}

// ════════════════════════════════════════════════════════════════════════════
// MESSAGING
// ════════════════════════════════════════════════════════════════════════════

model Conversation {
  id              String           @id @default(uuid())
  orgId        String
  type            ConversationType @default(direct)
  title           String?
  groupIcon       String?
  description     String?
  lastMessageText String?
  lastMessageAt   DateTime?
  lastMessageBy   String? // actor scalar
  messageCount    Int              @default(0)
  blockedUserIds  String[]         @default([]) // actor id list (scalar array)
  createdBy       String? // actor scalar

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

// Conversation.participants[] (conversation_participants)
model ConversationParticipant {
  id             String                      @id @default(uuid())
  conversationId String
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String // actor scalar
  joinedAt       DateTime                    @default(now())
  lastReadAt     DateTime                    @default(now())
  role           ConversationParticipantRole @default(member)
  isArchived     Boolean                     @default(false)
  isDeleted      Boolean                     @default(false)
  deletedAt      DateTime?
  isMuted        Boolean                     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String // actor scalar
  text           String
  attachmentUrls String[]     @default([])
  isEdited       Boolean      @default(false)
  editedAt       DateTime?
  isDeleted      Boolean      @default(false)
  deletedBy      String? // actor scalar
  deletedAt      DateTime?
  isFlagged      Boolean      @default(false)
  flagReason     String?
  replyTo        String? // scalar self-ref
  forwardedFrom  String? // scalar self-ref

  reactions MessageReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

// Message.reactions[] (message_reactions)
model MessageReaction {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String // actor scalar
  emoji     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// ════════════════════════════════════════════════════════════════════════════
// ANALYTICS, AUDIT, PRIVACY
// ════════════════════════════════════════════════════════════════════════════

model AnalyticsEvent {
  id         String  @id @default(uuid())
  orgId   String
  userId     String? // actor scalar
  eventType  String
  eventData  Json? // per §8
  sessionId  String?
  deviceType String?
  ipAddress  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, eventType, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("analytics_events")
}

model AnalyticsCache {
  id           String   @id @default(uuid())
  orgId     String
  metricKey    String
  data         Json
  calculatedAt DateTime
  expiresAt    DateTime // TTL — purged by worker cron
  filters      Json? // { dateFrom?, dateTo?, batchId?, teacherId? }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, metricKey])
  @@index([expiresAt])
  @@map("analytics_cache")
}

model ActivityLog {
  id        String       @id @default(uuid())
  orgId  String? // optional (super-admin global actions)
  userId    String? // actor scalar
  type      ActivityType
  message   String
  metadata  Json?
  timestamp DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, timestamp(sort: Desc)])
  @@index([type, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@map("activity_logs")
}

model TenantLog {
  id          String           @id @default(uuid())
  orgId    String
  actionType  TenantActionType
  description String
  performedBy String // actor scalar
  metadata    Json?
  ipAddress   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, actionType, createdAt(sort: Desc)])
  @@map("tenant_logs")
}

model PrivacyAuditLog {
  id              String   @id @default(uuid())
  orgId        String
  userId          String // actor scalar
  userRole        String
  endpoint        String
  method          String
  fieldsStripped  String[] @default([])
  recordsAffected Int      @default(0)
  ipAddress       String?
  userAgent       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("privacy_audit_logs")
}
