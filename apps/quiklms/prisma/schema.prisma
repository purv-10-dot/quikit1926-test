// SCHOOL OPS: batches, scheduling, credits, attendance, homework, payouts,
// meetings, non-teaching, teacher-level, escalation, tutoring, reminders, jobs
// ════════════════════════════════════════════════════════════════════════════

model Batch {
  id          String  @id @default(uuid())
  orgId    String
  name        String
  grade       String?
  section     String?
  subject     String
  description String?
  teacherId   String // actor scalar

  academicYear String
  term         String?
  startDate    DateTime
  endDate      DateTime

  maxCapacity            Int?
  defaultMeetingProvider BatchMeetingProvider? @default(jitsi)

  creditPerClass Float? @default(1)
  ratePerClass   Float?
  ratePerHour    Float?

  classType          BatchClassType? @default(regular)
  trialClassCount    Int?            @default(0)
  convertedToRegular Boolean?        @default(false)
  convertedAt        DateTime?

  status    BatchStatus @default(active)
  createdBy String? // actor scalar

  batchType         BatchType   @default(regular)
  source            BatchSource @default(manual)
  tutoringRequestId String? // scalar

  // Decomposed arrays + owned aggregates
  schedule           BatchSchedule[]
  students           BatchStudent[]
  substituteTeachers BatchSubstituteTeacher[]
  scheduledClasses   ScheduledClass[]
  homeworks          Homework[]
  gradeRecords       GradeRecord[]
  exams              Exam[]
  attendances        Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name, academicYear])
  @@index([orgId, academicYear, status])
  @@index([orgId, teacherId, status])
  @@index([orgId, grade, section, subject])
  @@map("batches")
}

