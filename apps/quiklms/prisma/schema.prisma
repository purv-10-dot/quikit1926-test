// ════════════════════════════════════════════════════════════════════════════
// FOUNDATION: tenants, users, otp, counters, groups, consent
// ════════════════════════════════════════════════════════════════════════════

model Tenant {
  id                 String       @id @default(uuid())
  name               String       @unique
  subdomain          String       @unique
  tenantType         TenantType   @default(corporate)
  gstNumber          String?      @unique // nullable @unique = sparse (Postgres treats NULLs as distinct)
  dbConnectionString String?
  status             TenantStatus @default(Active)
  tenantKey          String       @unique

  // Platform link (Phase-3 fold): the quikit `Org.id` this LMS Tenant maps to.
  // Nullable + sparse-unique until backfilled (Postgres treats NULLs as distinct).
  // Populated by prisma/backfill-tenant-orgid.ts and by onboardTenant going
  // forward; resolveOrgToTenantId prefers this over the subdomain↔slug match.
  orgId              String?      @unique

  // Organization profile
  orgName       String
  fullAddress   String
  country       String
  officialPhone String
  website       String?
  officialEmail String

  // Primary contact
  contactFirstName          String
  contactMiddleName         String?
  contactLastName           String
  contactPhone              String
  contactEmail              String
  contactRoleInOrganization String

  // Billing
  billingFirstName  String
  billingMiddleName String?
  billingLastName   String
  billingAddress    String

  // Config blobs (Json per §8)
  featureConfig     Json  @default("{}")
  schoolConfig      Json?
  corporateConfig   Json?
  creditConfig      Json?
  payoutConfig      Json?
  videoConfig       Json? // provider credentials encrypted at rest (lib/crypto)
  enhancementConfig Json?

  // Localization
  timezone         String   @default("UTC")
  defaultLanguage  String   @default("en")
  enabledLanguages String[] @default(["en"])
  locale           String   @default("en-US")
  currency         String   @default("USD")
  localeSettings   Json? // { dateFormat, timeFormat, firstDayOfWeek }

  // Storage & branding
  storageLimit   Int     @default(2) // GB
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String  @default("#3B82F6")
  secondaryColor String  @default("#1E40AF")

  // Auth0 integration
  auth0OrganizationId String?
  auth0UserId         String?
  loginUrl            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantType, status])
  @@map("tenants")
}

model User {
  id            String    @id @default(uuid())
  email         String // lowercased/trimmed in app layer
  password      String? // null for OAuth users
  firstName     String
  lastName      String
  role          UserRole  @default(LEARNER)
  secondaryRole UserRole?
  orgId      String? // scalar — global super-admins have no tenant
  managerId     String? // corporate team manager (scalar self-ref)
  isActive      Boolean   @default(true)

  // Parent-child linking (graph modelled via UserParent join)
  parentEmail      String? // deferred-link placeholder during bulk upload
  guardianContact  String?
  phone            String?
  guardianRelation String?

  // School-specific
  grade         String?
  subjects      String[]           @default([])
  ratePerClass  Float?
  ratePerHour   Float?
  rateType      RateType?          @default(per_class)
  qualification UserQualification?
  monthlyPayout Float?
  employeeId    String?
  studentId     String?
  parentCode    String?
  dateOfBirth   DateTime?
  section       String?

  // Teacher availability (SCH-005) — split to UserAvailabilitySlot child
  availableSlots     UserAvailabilitySlot[]
  maxSlotsPerWeek    Int?                   @default(0)
  tutoringEnabled    Boolean                @default(false)
  tutoringCreditCost Float?

  // Class statistics
  classesCompleted               Int?   @default(0)
  classesMissed                  Int?   @default(0)
  classesCancelled               Int?   @default(0)
  classesRescheduledAndCompleted Int?   @default(0)
  punctualityScore               Float? @default(0)

  // Authentication
  provider                 String?
  providerId               String?
  profilePicture           String?
  aiApiKey                 String? // encrypted (lib/crypto)
  mustChangePassword       Boolean   @default(true)
  passwordSetupToken       String?
  passwordSetupTokenExpiry DateTime?
  activeSessionId          String? // single-session enforcement

  // Gamification
  currentStreak    Int       @default(0)
  totalPoints      Int       @default(0)
  lastActivityDate DateTime?

  // Localization & notifications
  preferredLanguage       String  @default("en")
  timezone                String?
  notificationPreferences Json? // defaults applied in service layer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // parent↔child graph
  children UserParent[] @relation("UserChildren") // rows where this user is the parent
  parents  UserParent[] @relation("UserParents") // rows where this user is the child

  @@unique([orgId, studentId]) // sparse per-tenant unique (NULL-distinct)
  @@unique([orgId, employeeId])
  @@unique([orgId, parentCode])
  @@index([orgId, role])
  @@index([orgId, grade])
  @@index([orgId, email])
  @@index([orgId, totalPoints(sort: Desc)])
  @@index([orgId, currentStreak(sort: Desc)])
  @@index([orgId, parentEmail])
  @@index([managerId])
  @@map("users")
}

// User.availableSlots[] (SCH-005)
model UserAvailabilitySlot {
  id        String @id @default(uuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0-6
  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_availability_slots")
}

// parent↔child link (user_parents)
model UserParent {
  id       String @id @default(uuid())
  parentId String
  childId  String
  parent   User   @relation("UserChildren", fields: [parentId], references: [id], onDelete: Cascade)
  child    User   @relation("UserParents", fields: [childId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, childId])
  @@index([childId])
  @@map("user_parents")
}

model Otp {
  id        String   @id @default(uuid())
  email     String // lowercased/trimmed
  otp       String // 4-digit
  expiresAt DateTime // TTL 600s — purged by worker cron
  isUsed    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@map("otps")
}

model Counter {
  id       String @id @default(uuid())
  orgId String
  type     String // 'teacher' | 'student' | 'parent'
  seq      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, type])
  @@map("counters")
}

model Group {
  id          String        @id @default(uuid())
  orgId    String
  name        String
  description String?
  createdBy   String? // actor scalar
  members     GroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
  @@map("groups")
}

// Group.memberIds[] (group_members)
model GroupMember {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String // actor scalar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model ConsentRecord {
  id             String      @id @default(uuid())
  orgId       String
  studentId      String // actor scalar
  parentId       String // actor scalar
  consentType    ConsentType
  granted        Boolean     @default(false)
  grantedAt      DateTime?
  revokedAt      DateTime?
  ipAddress      String?
  consentVersion String      @default("1.0")
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, studentId, consentType])
  @@index([orgId, parentId])
  @@map("consent_records")
}

// ════════════════════════════════════════════════════════════════════════════
// COURSES: course, module, lesson, master-course, assessment, quiz-attempt
// ════════════════════════════════════════════════════════════════════════════

model Course {
  id           String       @id @default(uuid())
  orgId     String? // optional for master courses
  title        String
  category     String?
  description  String?
  authorId     String // actor scalar
  status       CourseStatus @default(Draft)
  thumbnailUrl String?
  isMaster     Boolean      @default(false)
  isFeatured   Boolean      @default(false)
  version      Int          @default(1)

  modules         Module[]
  selectedTenants CourseSelectedTenant[]
  prerequisites   CoursePrerequisite[]   @relation("CourseToPrereqs")
  prerequisiteFor CoursePrerequisite[]   @relation("CoursePrereqOf")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([isMaster])
  @@index([isFeatured, status])
  @@index([category, orgId])
  @@map("courses")
}

// Course.selectedTenants[] (course_selected_tenants)
model CourseSelectedTenant {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orgId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, orgId])
  @@index([orgId])
  @@map("course_selected_tenants")
}

// Course.prerequisites[] (course prerequisites self-join)
model CoursePrerequisite {
  id             String @id @default(uuid())
  courseId       String
  prerequisiteId String
  course         Course @relation("CourseToPrereqs", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite   Course @relation("CoursePrereqOf", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("course_prerequisites")
}

model Module {
  id           String  @id @default(uuid())
  orgId     String? // optional for master courses
  courseId     String
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  orderIndex   Int
  assessmentId String? // scalar (avoids Module↔Assessment double-link cycle)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, courseId])
  @@index([courseId, orderIndex])
  @@map("modules")
}

// Module.lessons[] (lessons child table)
model Lesson {
  id          String     @id @default(uuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  type        LessonType
  contentUrl  String?
  orderIndex  Int
  isMaster    Boolean    @default(false)
  description String?
  duration    Int? // minutes
  fileSize    Int? // bytes
  captions    Json? // [{ language, label, url }]
  quiz        Json? // { questions[], passingScore }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId, orderIndex])
  @@map("lessons")
}

// Tier-1 authoring document. Deeply nested 3-tier content (modules→subModules→
// resources, quizzes, assignments) is kept as Json blobs per §8 (queried whole).
model MasterCourse {
  id                   String             @id @default(uuid())
  title                String
  description          String?
  category             String?
  level                CourseLevel        @default(Beginner)
  thumbnailUrl         String?
  aiGeneratedThumbnail Boolean            @default(false)
  authorId             String // actor scalar
  modules              Json               @default("[]") // CourseModule[] (3-tier nested)
  settings             Json               @default("{}") // CourseSettings
  status               MasterCourseStatus @default(Draft)
  isMaster             Boolean            @default(true)
  tags                 String[]           @default([])
  estimatedDuration    Int?

  // Auto-save draft
  lastAutoSaveAt DateTime?
  draftData      Json?
  version        Int       @default(1)

  // Approval workflow
  submittedBy           String? // actor scalar
  submittedByTenantId   String? // scalar
  parentCourseId        String? // scalar self-ref (pending/rejected revision of a published parent)
  revisionNumber        Int       @default(1)
  tenantApprovedBy      String?
  tenantApprovalDate    DateTime?
  tenantRejectionReason String?
  approvedBy            String?
  approvalDate          DateTime?
  rejectionReason       String?

  selectedTenants MasterCourseSelectedTenant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isMaster, status])
  @@index([authorId])
  @@index([category, level])
  @@index([status, submittedByTenantId])
  @@index([parentCourseId, status])
  @@map("master_courses")
}

// MasterCourse.selectedTenants[] (certificate_selected_tenants analogue for master courses)
model MasterCourseSelectedTenant {
  id             String       @id @default(uuid())
  masterCourseId String
  masterCourse   MasterCourse @relation(fields: [masterCourseId], references: [id], onDelete: Cascade)
  orgId       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([masterCourseId, orgId])
  @@index([orgId])
  @@map("master_course_selected_tenants")
}

model Assessment {
  id        String @id @default(uuid())
  orgId  String
  moduleId  String // scalar (cross-aggregate; avoids cycle with Module.assessmentId)
  title     String
  questions Json   @default("[]") // embedded Question[] (text, type, options, correctAnswerIndex, …)

  passingScore Int  @default(75)
  retryLimit   Int  @default(3)
  timeLimit    Int? // minutes

  randomizeQuestions           Boolean @default(false)
  questionsToShow              Int?
  additionalQuestions          Json    @default("[]") // bonus pool Question[]
  additionalQuestionsToInclude Int?
  isMaster                     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, moduleId])
  @@index([isMaster])
  @@map("assessments")
}

model QuizAttempt {
  id                  String   @id @default(uuid())
  orgId            String
  learnerId           String // actor scalar
  courseId            String // scalar (Course|MasterCourse ambiguous)
  assessmentId        String // scalar
  answers             Json     @default("[]") // QuestionAnswer[]
  score               Int
  totalPoints         Int
  percentage          Float
  passed              Boolean
  submittedAt         DateTime @default(now())
  proctoringSessionId String? // scalar (optional QuizProctoringSession link)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, learnerId, courseId])
  @@index([orgId, learnerId, assessmentId])
  @@index([learnerId, courseId, submittedAt(sort: Desc)])
  @@map("quiz_attempts")
}

// ════════════════════════════════════════════════════════════════════════════
// PROGRESS, ASSIGNMENTS, CERTIFICATES, DISCUSSIONS, BOOKMARKS, ACADEMIC, ETC.
// ════════════════════════════════════════════════════════════════════════════

model Progress {
  id                   String         @id @default(uuid())
  orgId             String
  learnerId            String // actor scalar
  courseId             String // scalar (ambiguous target)
  currentModuleId      String? // scalar
  status               ProgressStatus @default(NotStarted)
