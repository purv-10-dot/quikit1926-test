/lib/generated

# env
.env
.env*.local
worker/.env

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea
.vscode/*
!.vscode/extensions.json

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
/logs
*.log

# reference source apps (kept in-repo for parity, not part of the build)
# (left tracked intentionally; comment out the next two lines to ignore them)
# /QuikSkillsbackend
# /QuikSkillsfrontend
.vercel
.env*

# ────────────────────────────────────────────────────────────────────────────
# Local-only / not-for-server artifacts — never pushed to git or deployed.
# Some are also enforced by the repo-root .gitignore; duplicated here so this
# app folder documents its own exclusions.
# ────────────────────────────────────────────────────────────────────────────

# Markdown docs, plans, reports, scratch notes (repo policy: never committed).
# Covers README.md, GAPS.md, FIX_PLAN.md, TEST_REPORT.md, SKILL*.md, docs/*.md, etc.
*.md

# Local debug / probe scratch scripts (hardcoded local paths, read .env.local secrets)
.audit-probe.ts
*.probe.ts

# Build caches & test output (regenerated locally / in CI, not source)
/.turbo
/coverage
/.vitest-cache
/playwright-report
/test-results
/.playwright-cache
