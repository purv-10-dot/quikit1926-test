# ============================================================================
# QuikSkill LMS — environment variables (Next.js app + /worker)
# Copy to .env and fill in. Vars prefixed NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3016
# The app's own public origin is the platform-standard pair set in the auth
# block below: NEXTAUTH_URL (server-side) + NEXT_PUBLIC_QUIKLMS_URL (client).
# All self-origin links (email, login, certificates, tenant URLs) derive from
# NEXTAUTH_URL. (Replaces the former app-local BASE_URL / FRONTEND_URL /
# NEXT_PUBLIC_API_URL — those names are no longer read anywhere.)

# ── Database (PostgreSQL + Prisma) ───────────────────────────────────────────
# Shared platform Postgres (ONE cluster for the whole cluster; the LMS domain
# lives in the app_quiklms schema alongside quikit/auth). DATABASE_URL = runtime
# (Neon pooler in prod); DATABASE_URL_DIRECT = migrations (unpooled). Same URL in dev.
# Encode special chars in the password (e.g. @ → %40).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quikit_dev
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/quikit_dev

# ── Redis (BullMQ queues + socket scaling) ───────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── QuikIT centralized auth (OAuth2 SSO consumer) ────────────────────────────
# Primary auth. NEXTAUTH_SECRET + INTERNAL_SECRET MUST be identical across every
# app in the cluster (copy from apps/admin/.env.local). QUIKIT_CLIENT_SECRET is
# the value seeded by packages/database/prisma/seed-oauth.ts (clientId=quiklms).
NEXTAUTH_SECRET="<shared-across-cluster: openssl rand -base64 32>"
NEXTAUTH_URL=http://localhost:3016
QUIKIT_URL=http://localhost:3000
NEXT_PUBLIC_QUIKIT_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
QUIKIT_CLIENT_ID=quiklms
QUIKIT_CLIENT_SECRET=quiklms-dev-secret-change-in-prod
INTERNAL_SECRET=<shared-across-cluster>
# This app's own public origin (per-app convention, mirrors NEXT_PUBLIC_QUIKSUPPORT_URL
# etc.). Must equal NEXTAUTH_URL. The AppSwitcher + socket client read the
# NEXT_PUBLIC_ variant. Identity dual-write now runs on the shared
# @quikit/database client (see lib/org-db.ts) — no separate ORG_DATABASE_URL.
#
# Deployed values — NEXT_PUBLIC_* is inlined at BUILD time, so a change here
# needs a rebuild, not just a restart:
#   Vercel prod  NEXT_PUBLIC_QUIKLMS_URL=https://quiklms.vercel.app
#   UAT (k8s)    NEXT_PUBLIC_QUIKLMS_URL=https://uatlms.quikit.ai  (.github/workflows/UAT.yml)
#
# IMPORTANT — sign-out/login redirects need this origin ALLOW-LISTED on the auth
# and quikit deployments, or both fall back to the QuikIT launcher and the user
# never lands back here. Four separate lists gate it (post-login, packages/auth,
# and the two signout-global routes); all four extend from one env var, set on
# the *auth* and *quikit* projects — not this one:
#   AUTH_ALLOWED_RETURN_ORIGINS=https://quiklms.vercel.app,https://uatlms.quikit.ai
QUIKLMS_URL=http://localhost:3016
NEXT_PUBLIC_QUIKLMS_URL=http://localhost:3016

# ── Legacy / crypto (still used by LMS features) ─────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# AES-256 key (32 bytes hex / base64) for encrypting stored secrets (aiApiKey, video credentials)
ENCRYPTION_KEY=change-me-32-byte-encryption-key

# ── OAuth: Google ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3016/api/auth/google/callback

# ── OAuth: Microsoft ─────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CALLBACK_URL=http://localhost:3016/api/auth/microsoft/callback

# ── Object storage: Google Cloud Storage (presigned PUT/GET + TUS) ───────────
# These four are REQUIRED — without them `lib/s3.ts` throws
# "GCS_BUCKET is not configured" and every upload 500s.
# GCS_PRIVATE_KEY is a single line with literal \n escapes; keep the quotes.
GCS_PROJECT_ID=red-seeker-477810-i0
GCS_BUCKET=quikit-bucket
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=""

# NOTE: browser→bucket direct PUT requires a CORS policy on the bucket itself.
# It is NOT set by app config — apply scripts/gcs-cors.json once per bucket:
#   gcloud storage buckets update gs://quikit-bucket --cors-file=scripts/gcs-cors.json

# Proxy/direct boundary for uploads (UPLOAD_PROXY_MAX_BYTES in
# lib/constants/uploads.ts). Files at or under it are proxied through our own API
# route and need NO bucket CORS policy; larger ones go browser→bucket and do.
#
# LEAVE UNSET IN PRODUCTION — the default 4MB keeps proxied bodies under Vercel's
# 4.5MB request cap, which rejects the request before our code runs. Set it in
# local dev (52428800 = 50MB = MAX_COURSE_RESOURCE_BYTES) to keep every upload on
# the proxied path while the bucket CORS policy is unapplied.
# NEXT_PUBLIC_UPLOAD_PROXY_MAX_BYTES=52428800

# Legacy AWS S3 — no bucket was ever provisioned; kept only so half-migrated
# environments don't silently resolve the bucket name to empty. Leave unset.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Email: SMTP (Nodemailer) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QuikSkill <no-reply@quikskill.ai>"
# Email: Resend (alternative/secondary provider)
RESEND_API_KEY=

# ── Twilio (voice escalation calls + SMS reminders) ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── OpenAI (Whisper transcription) ───────────────────────────────────────────
OPENAI_API_KEY=

# ── Video providers ──────────────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# ── Worker process ───────────────────────────────────────────────────────────
# Port for the standalone worker (Socket.IO + TUS server)
WORKER_PORT=3021
# Public URL the browser uses to reach the worker (sockets + tus uploads)
NEXT_PUBLIC_WORKER_URL=http://localhost:3021
# INTERNAL_SECRET (defined in the auth block above) also guards the worker's
# POST /internal/emit endpoint — the Next app persists chat over REST and calls
# that endpoint so the worker broadcasts `newMessage` to connected sockets. The
# caller must send it as the `x-internal-secret` header. If the var is UNSET the
# endpoint 401s everything (broadcasts are dropped, not opened up), so it must
# be identical in the app's and the worker's environment.
