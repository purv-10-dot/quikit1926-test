# Copy to .env.local and fill in your local-dev values. Never commit .env.local.
#
# DATABASE_URL — your local Postgres for dev. The integration owner moves this
# to Neon during integration; do not include cloud DB URLs in your repo.
DATABASE_URL="postgresql://postgres:sa%40123@localhost:5432/quikit_Moreyeahs_27.7.26"

# Non-pooled connection. packages/database/prisma/schema.prisma declares
# `directUrl = env("DATABASE_URL_DIRECT")`, so Prisma resolves it at generate
# and migrate time. Locally it is the same value as DATABASE_URL; on Neon it is
# the direct (non-PgBouncer) host.
DATABASE_URL_DIRECT="postgresql://postgres:sa%40123@localhost:5432/quikit_Moreyeahs_27.7.26"

# Same value as DATABASE_URL for Prisma migrate (per CLAUDE.md). Do not point at prod.
MIGRATION_DATABASE_URL="postgresql://postgres:sa%40123@localhost:5432/quikit_Moreyeahs_27.7.26"

# NextAuth — generate with `openssl rand -base64 32`. Replace before first run.
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3014"

# QuikIT OAuth (SSO from the launcher). The integration owner provides real
# values during integration; for local dev create your own dev client.
QUIKIT_URL="http://localhost:3000"
QUIKIT_CLIENT_ID="dev-client-id-placeholder"
QUIKIT_CLIENT_SECRET="dev-client-secret-placeholder"
QUIKIT_ISSUER_URL="http://localhost:3000"

# Cross-domain launcher hand-off (/auth-handoff) + remote session validation.
# INTERNAL_SECRET must match the value on the quikit launcher.
INTERNAL_SECRET="REPLACE_WITH_SHARED_INTERNAL_SECRET"
NEXT_PUBLIC_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_QUIKIT_URL="http://localhost:3000"

# This app's own public origin. Two names, two consumers — keep them in sync:
#   QUIKFLOW_URL            — server-side. Builds the OAuth connector callback
#                             URLs ({QUIKFLOW_URL}/api/connections/*/callback)
#                             and is what the quikit launcher / admin switcher
#                             read to route users to this app.
#   NEXT_PUBLIC_QUIKFLOW_URL — baked into the client bundle, and read by
#                             next.config.js at BUILD time to add this host to
#                             serverActions.allowedOrigins. Missing at build
#                             time = every Server Action 403s in UAT/prod.
# UAT values: https://uatflow.quikit.ai
QUIKFLOW_URL="http://localhost:3014"
NEXT_PUBLIC_QUIKFLOW_URL="http://localhost:3014"

# Redis — required by the BullMQ execution queue (worker + ingest enqueue).
# Local dev: `docker run -d -p 6379:6379 redis:7-alpine`.
# UAT: the managed BullMQ broker at https://bullmq.quikit.ai — inject the real
# credential-bearing connection string from the GitOps Secret, never from a
# build arg or this file.
QUIKSCALE_URL="http://localhost:3003"
REDIS_URL="redis://localhost:6379"

# Port for the execution worker's /health endpoint (worker/main.ts). Health and
# k8s probes only — it serves no application traffic. Defaults to 9101, next to
# the realtime gateway's 9100. Only set this if 9101 is taken locally.
WORKER_HEALTH_PORT="9101"

# Optional: only set if your app needs Sentry locally. Leave blank for dev.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# =====================================================================
# MAIL + CALENDAR CONNECTORS (Gmail / Outlook / Teams OAuth) — third-party
# integrations. GOOGLE_* from a Google Cloud OAuth 2.0 Web client; MICROSOFT_*
# from an Azure AD (Microsoft Entra) app registration.
#
# NAMING, as of 2026-08-17: these are the bare/global names, NOT prefixed
# (previously QUIKFLOW_GOOGLE_*/QUIKFLOW_MS_*/QUIKFLOW_TEAMS_*). That prefix
# existed specifically to avoid colliding with another app's own OAuth client
# of the same shape wherever env vars are shared across apps (e.g. a shared
# secrets store) — see git history / __tests__/unit/connectors-env-vars.test.ts
# for the incident that motivated it. This was a deliberate, informed decision
# to revert to the global names anyway; know the tradeoff before copying this
# pattern to another connector:
#   - MICROSOFT_CLIENT_ID/SECRET/TENANT_ID is now ALSO used by Teams below —
#     one Azure app registration backs both mail and calendar. Rotating or
#     revoking consent for one affects the other.
#   - If this app ever adds Microsoft/Google login SSO via @quikit/auth using
#     these same conventional names, that SSO client and this connector client
#     will collide on the same env var. Give SSO its own name if that happens.
#
# Register each provider's redirect URI as:
#   {QUIKFLOW_URL}/api/connections/{gmail|outlook|teams}/callback
#   e.g. http://localhost:3014/api/connections/outlook/callback
# Outlook delegated Graph scopes: Mail.Send, Mail.Read, User.Read, offline_access.
# Leave a provider's vars blank to disable that provider's "Connect" flow.
# =====================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" = multi-tenant + personal accounts; set a tenant id to restrict.
MICROSOFT_TENANT_ID="common"

# =====================================================================
# MICROSOFT TEAMS CALENDAR
# Delegated Graph scopes: Calendars.ReadWrite, User.Read, offline_access.
# Register the redirect URI: {QUIKFLOW_URL}/api/connections/teams/callback
#   e.g. http://localhost:3014/api/connections/teams/callback
# Reuses MICROSOFT_CLIENT_ID/MICROSOFT_CLIENT_SECRET/MICROSOFT_TENANT_ID
# above — same Azure app registration as Outlook mail, not a separate one.
# (Still NOT the MS_TEAMS_* names — those are QuikHRMS's own, unrelated
# app-only Graph integration on a different Azure app registration.)
# =====================================================================
# Default IANA time zone for calendar events when a workflow doesn't pass one
# (e.g. "Asia/Kolkata"). Falls back to UTC.
QUIKFLOW_DEFAULT_TIMEZONE="UTC"

# 32-byte key (64 hex chars, or base64) encrypting connection tokens at rest
# (WfConnection.accessToken/refreshToken). Generate: openssl rand -hex 32
WF_CONNECTION_ENC_KEY=""

# =====================================================================
# FATHOM.AI (meeting transcripts) — API-key connector, no OAuth.
# Users paste an API key on /connections (stored encrypted). Override the base
# only for testing/mocks. The real-time webhook is optional (poll covers dev);
# set FATHOM_WEBHOOK_INSECURE=true ONLY in dev to skip signature verification.
# =====================================================================
FATHOM_API_BASE="https://api.fathom.ai/external/v1"
FATHOM_WEBHOOK_INSECURE=""

# Optional: Fathom notetaker bot email. When set, every online meeting
# QuikFlow creates via calendar.event.create auto-invites this address as an
# attendee, so Fathom's bot auto-joins and starts recording — no manual
# "Start Recording" click. Find the address in Fathom's own
# calendar-connection settings. Leave blank to disable (no-op).
FATHOM_NOTETAKER_EMAIL=""
