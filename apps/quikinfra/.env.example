# ============================================================================
# GOOGLE CLOUD STORAGE — file uploads/downloads
# ============================================================================
# Bucket: gs://quikit-bucket (region asia-south1 / Mumbai). Inline SA key.
# The private key uses escaped \n newlines; the storage layer un-escapes them.
GCS_PROJECT_ID=red-seeker-477810-i0
GCS_BUCKET=quikit-bucket
GCS_CLIENT_EMAIL=quikit-bucket-sa@red-seeker-477810-i0.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Signed URL TTLs (seconds) — default 300 if unset.
STORAGE_UPLOAD_URL_TTL_SEC=300
STORAGE_DOWNLOAD_URL_TTL_SEC=300

# ============================================================================
# PUBLIC URLs — invite links, logout redirect, marketing nav
# ============================================================================
# This app's own public origin. Used to build Android App Link invite URLs
# (`/invite/{token}`) for mobile-enabled users, the post-logout redirect, and
# the marketing nav. UAT/prod inject these via CI; set them locally so an
# invite generated in dev points at this app rather than falling back to the
# launcher. No trailing slash.
NEXT_PUBLIC_QUIKINFRA_URL=http://localhost:3006
QUIKINFRA_URL=http://localhost:3006

# Central auth app (apps/auth) — hosts /invitations/accept and the invitation
# details API the /invite/{token} web fallback page reads.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
