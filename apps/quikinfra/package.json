{
  "name": "quikinfra",
  "version": "0.1.0",
  "private": true,
  "description": "QuikInfra — Infrastructure ERP inside QuikIT.",
  "scripts": {
    "dev": "next dev -p 3006",
    "prebuild": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "build": "next build",
    "start": "next start -p 3006",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@quikit/auth": "*",
    "@quikit/database": "*",
    "@quikit/shared": "*",
    "@quikit/ui": "*",
    "@tanstack/react-query": "^5.28.0",
    "@types/nodemailer": "^8.0.0",
    "lucide-react": "^0.294.0",
    "next": "14.0.4",
    "next-auth": "^4.24.0",
    "next-themes": "^0.2.1",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "prom-client": "^15.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
