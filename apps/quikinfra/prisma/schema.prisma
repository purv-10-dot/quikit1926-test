// ============================================================================
// LEDGERS & BALANCES â€” transaction-safe side-effect storage
// ============================================================================

// Fast current-quantity cache for (project, location, item).
// Updated ONLY as a side effect of appending to CnStockLedger, inside the
// same Prisma transaction. Never mutated directly from route handlers.
model CnStockBalance {
  orgId      String
