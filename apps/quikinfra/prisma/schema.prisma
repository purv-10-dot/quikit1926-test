// ============================================================================
// PURCHASE & PROCUREMENT
// ============================================================================

model CnPurchaseRequisition {
  id                   String    @id @default(cuid())
  orgId                String
  prNumber             String
  projectId            String
  requestedById        String
  requestDate          DateTime
  requiredDate         DateTime?
  purpose              String?
  isUrgent             Boolean   @default(false)
  urgencyJustification String?
  workCategoryId       String?
  deliveryLocationId   String?
  estimatedTotal       Decimal?  @db.Decimal(18, 2)
  stockCheckSummary    String?
  status               String    @default("draft")
  approvalId           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String
  updatedBy            String

  project CnProject                   @relation(fields: [projectId], references: [id])
  lines   CnPurchaseRequisitionLine[]

  @@unique([orgId, prNumber])
  @@index([orgId])
  @@index([projectId])
  @@index([status])
  // Composite indexes for the hot list queries â€” match the repo's
  // `WHERE tenantId=? AND orgId=? AND (status=?|projectId=?) ORDER BY createdAt DESC`
  // patterns so Postgres can satisfy filter + sort from a single index walk.
  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, projectId, createdAt(sort: Desc)])
  @@map("Purchase_requisitions")
  @@schema("app_quikinfra")
}

model CnPurchaseRequisitionLine {
  id               String   @id @default(cuid())
  prId             String
  itemId           String
  quantity         Decimal  @db.Decimal(18, 4)
  uomId            String
  estimatedRate    Decimal? @db.Decimal(18, 2)
  estimatedAmount  Decimal? @db.Decimal(18, 2)
  specification    String?
  priority         String?
  currentStock     Decimal? @db.Decimal(18, 4)
  stockCheckStatus String?
  remarks          String?

  pr CnPurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
  @@map("Purchase_requisition_lines")
  @@schema("app_quikinfra")
}

model CnPurchaseIndent {
  id                 String    @id @default(cuid())
  orgId              String
  indentNumber       String
  prId               String?
  sourceMrNumber     String?
  projectId          String
  requestedById      String
  indentDate         DateTime
  requiredDate       DateTime?
  isUrgent           Boolean   @default(false)
  directIndentReason String?
  estimatedTotal     Decimal?  @db.Decimal(18, 2)
  status             String    @default("draft")
  approvalId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String
  updatedBy          String

  project CnProject              @relation(fields: [projectId], references: [id])
  lines   CnPurchaseIndentLine[]

  @@unique([orgId, indentNumber])
  @@index([orgId])
  @@index([projectId])
  @@index([status])
  // Composite indexes â€” match `ORDER BY indentDate DESC` in the repo so
  // status-tab and project-scoped lists hit a single covering walk.
  @@index([orgId, status, indentDate(sort: Desc)])
  @@index([orgId, projectId, indentDate(sort: Desc)])
  @@map("Purchase_indents")
  @@schema("app_quikinfra")
}

model CnPurchaseIndentLine {
  id                String   @id @default(cuid())
  indentId          String
  prLineId          String?
  itemId            String
  requiredQty       Decimal  @db.Decimal(18, 4)
  indentedQty       Decimal  @db.Decimal(18, 4)
  orderedQty        Decimal  @default(0) @db.Decimal(18, 4)
  pendingQty        Decimal  @db.Decimal(18, 4)
  uomId             String
  estimatedRate     Decimal? @db.Decimal(18, 2)
  estimatedAmount   Decimal? @db.Decimal(18, 2)
  preferredVendorId String?
  qualitySpec       String?
  lineStatus        String?
  remarks           String?

  indent CnPurchaseIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  @@index([indentId])
  @@map("Purchase_indent_lines")
  @@schema("app_quikinfra")
}

// ============================================================================
// RFQ (Request for Quotation)
// ============================================================================

model CnRfq {
  id                 String    @id @default(cuid())
  orgId              String
  rfqNumber          String
  projectId          String
  sourceIndentId     String?
  sourceIndentNumber String?
  rfqDate            DateTime
  dueDate            DateTime?
  purpose            String?
  contactPerson      String?
  contactMobile      String?
  /// Delivery / site address printed on the outgoing RFQ PDF. Free
  /// text so the raiser can override whatever the project master has.
  /// Falls back to the project's address at PDF render time when null.
  address            String?
  /// Selected T&C template id (cn_terms_conditions.id). Frozen at RFQ
  /// create time so later edits to the template don't retroactively
  /// change what was sent to the vendor.
  termsTemplateId    String?
  status             String    @default("draft")
  approvalId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String
  updatedBy          String

  lines   CnRfqLine[]
  vendors CnRfqVendor[]

  @@unique([orgId, rfqNumber])
  @@index([orgId])
  @@index([projectId])
  @@index([sourceIndentId])
  @@index([status])
  // Composite indexes â€” match `ORDER BY rfqDate DESC` in listRfqs.
  @@index([orgId, status, rfqDate(sort: Desc)])
  @@index([orgId, projectId, rfqDate(sort: Desc)])
  @@map("Rfqs")
  @@schema("app_quikinfra")
}

model CnRfqLine {
  id                 String  @id @default(cuid())
  rfqId              String
  itemId             String
  uomId              String?
  quantity           Decimal @db.Decimal(18, 4)
  specification      String?
  sourceIndentLineId String?

  rfq CnRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@map("Rfq_lines")
  @@schema("app_quikinfra")
}

model CnRfqVendor {
  id              String    @id @default(cuid())
  rfqId           String
  vendorId        String
  email           String?
  vendorName      String?
  // Per-vendor item subset. Empty array = "send all RFQ items" (the
  // legacy default). Non-empty array = row ids from the RFQ's line
  // list for this specific vendor. Stored as a JSON string for
  // Postgres + SQLite portability via Prisma's String type.
  assignedItemIds Json      @default("[]")
  sentAt          DateTime?
  respondedAt     DateTime?

  /// The rates this vendor quoted, captured from the Add Quote modal.
  /// Shape: [{ lineId: string, rate: string, remarks?: string }].
  /// Stored as JSON so the shape can evolve without DB migrations.
  quotedRates  Json      @default("[]")
  /// Free-form remarks / terms the vendor sent with the quote â€” may
  /// include a marker like `[Attached quotation: <filename>]` once
  /// file upload is wired up.
  quoteRemarks String?
  /// Timestamp of the most recent rate save. Cleared back to null if
  /// every rate is removed.
  quotedAt     DateTime?

  rfq CnRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([vendorId])
  @@map("Rfq_vendors")
  @@schema("app_quikinfra")
}

model CnPurchaseOrder {
  id                   String    @id @default(cuid())
  orgId                String
  poNumber             String
  projectId            String
  vendorId             String
  indentId             String?
  rfqId                String?
  poDate               DateTime
  deliveryDate         DateTime?
  deliveryLocationId   String?
  /// Free-text delivery/site address â€” snapshot at PO create time so
  /// later edits to the project master don't retroactively change a
  /// PO that was already sent to a vendor.
  deliveryAddress      String?
  subtotal             Decimal   @db.Decimal(18, 2)
  taxAmount            Decimal   @db.Decimal(18, 2)
  totalAmount          Decimal   @db.Decimal(18, 2)
  /// Separated finance fields â€” the existing `subtotal` stores the
  /// material-value-ex-GST. Freight is priced alongside but kept
  /// separately so GST-on-freight and freight-less reports work.
  freightCharges       Decimal?  @db.Decimal(18, 2)
  /// Extra header-level charges (non-freight) shown on the PDF line
  /// above the GST block.
  otherCharges         Decimal?  @db.Decimal(18, 2)
  /// Advance paid to the vendor at PO issue â€” deducted from the first
  /// invoice amount.
  advanceAmount        Decimal?  @db.Decimal(18, 2)
  /// GST breakdown. Exactly one of (IGST) or (CGST+SGST) is non-zero
  /// depending on whether the vendor state matches the buyer state.
  totalIGST            Decimal?  @db.Decimal(18, 2)
  totalCGST            Decimal?  @db.Decimal(18, 2)
  totalSGST            Decimal?  @db.Decimal(18, 2)
  /// Subject / "Supply For" line printed on the PDF.
  purpose              String?
  /// Buyer-side contact(s). Comma-separated when multiple.
  contactPerson        String?
  contactMobile        String?
  status               String    @default("draft")
  approvalId           String?
  approvalThresholdMet Boolean   @default(false)
  paymentTermsDays     Int?
  termsConditionId     String?
  /// Snapshot of the T&C body at PO create time so later edits to the
  /// template master don't change what the vendor agreed to.
  termsAndConditions   String?
  remarks              String?
