  updatedAt  DateTime @updatedAt

  @@id([projectId, locationId, itemId])
  @@index([orgId])
  @@index([itemId])
  @@index([orgId, itemId])
  @@map("Stock_balances")
  @@schema("app_quikinfra")
}

// Append-only record of every BOQ progress posting from DPR approvals.
// Authoritative source for `subDoneQty`/`selfDoneQty` â€” the aggregate on
// CnBOQItemV2 is a cached rollup kept in sync by the same transaction.
//
// Reversals create a compensating row with direction = -1, never mutate.
model CnBOQProgressLedger {
  id             String   @id @default(cuid())
  orgId          String
  projectId      String
  boqItemId      String
  boqNo          String
  category       String
  qty            Decimal  @db.Decimal(18, 4)
  direction      Int // +1 for apply, -1 for reverse
  workType       String // "sub_contractor" | "self"
  dprId          String?
  dprLineId      String?
  overrideFlag   Boolean  @default(false)
  overrideReason String?
  createdAt      DateTime @default(now())
  createdBy      String

  @@index([orgId])
  @@index([projectId, boqNo])
  @@index([boqItemId])
  @@index([dprId])
  @@index([createdAt])
  @@map("Boq_progress_ledger")
  @@schema("app_quikinfra")
}

// Append-only record of every BOQ billing posting from RAB approvals.
// Same pattern as progress ledger.
model CnBOQBillingLedger {
  id             String   @id @default(cuid())
  orgId          String
  projectId      String
  boqItemId      String
  boqNo          String
  category       String
  qty            Decimal  @db.Decimal(18, 4)
  direction      Int // +1 for bill, -1 for reverse
  rabId          String?
  rabLineId      String?
  overrideFlag   Boolean  @default(false)
  overrideReason String?
  createdAt      DateTime @default(now())
  createdBy      String

  @@index([orgId])
  @@index([projectId, boqNo])
  @@index([boqItemId])
  @@index([rabId])
  @@index([createdAt])
  @@map("Boq_billing_ledger")
  @@schema("app_quikinfra")
}

// ============================================================================
// IDEMPOTENCY â€” HTTP idempotency keys for mutating routes
// ============================================================================
//
// Client sends an `Idempotency-Key` header on critical POSTs (approve, submit,
// confirm). Server hashes the request body and caches the response. Retries
// with the same key + body return the cached response; same key + different
// body returns 409.

model CnIdempotencyKey {
  key          String   @id
  orgId        String
  userId       String
  route        String
  bodyHash     String
  statusCode   Int
  responseJson Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([orgId, userId])
  @@index([expiresAt])
  @@map("Idempotency_keys")
  @@schema("app_quikinfra")
}

// ============================================================================
// DEMO USERS â€” seeded accounts with real login for testing role restrictions
// ============================================================================
//
// Not a platform-wide User table â€” this is a small, scoped table the
// QuikInfra app owns for demo + QA. When the root workspace User
// table becomes the authoritative source, this table disappears and the
// NextAuth CredentialsProvider switches to querying the root User model
// instead.
//
// Password is stored as scrypt hash (node:crypto built-in, no bcrypt dep).
// Format: "<salt_hex>:<hash_hex>".
// Demo password for every seeded row is "12345" â€” change via the seed or
// a /api/admin/password route (not yet built).
model CnDemoUser {
  id           String   @id @default(cuid())
  orgId        String   @default("default")
  email        String   @unique
  passwordHash String
  name         String
  displayRole  String // UI label: SUPER_ADMIN | ADMIN | HO_USER | SITE_ADMIN | USER
  roleKey      String // maps to cn_roles.key (super_admin, admin, ho_user, site_admin, user)
  department   String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@index([email])
  @@map("Demo_users")
  @@schema("app_quikinfra")
}

// ============================================================================
// USERS â€” tenant-invited user accounts (persisted)
// ============================================================================
//
// This is the real application user table. Rows are created by the
// "Settings â†’ Users â†’ Add User" invite flow (POST /api/settings/users)
// and live for the lifetime of the tenant.
//
// `cn_demo_users` stays as the seeded 5-account table used by the
// demo login page. Both are checked by NextAuth's `authorize()` â€” the
// seeded accounts first, then this table. Eventually cn_demo_users can
// be removed entirely once the login page is updated to stop advertising
// the seed accounts.
//
// A unique index on (tenantId, email) enforces "one account per email
// per tenant", matching how multi-tenant SaaS systems usually shape it.
// Plain `email` is also indexed for the NextAuth lookup path which
// doesn't carry tenant context at authorize-time.
model CnUser {
  id    String @id @default(cuid())
  orgId String @default("default")

  // Identity
  email        String
  username     String
  fullName     String
  mobile       String? // 10-digit Indian mobile (optional)
  department   String?
  passwordHash String // scrypt "salt:hash" â€” never plaintext

  // Authorisation
  userType         String // USER_TYPES key: ADMIN | HO_USER | SITE_ADMIN | USER
  roleKey          String // materialised at invite time from USER_TYPE_CATALOG.backingRole
  modulesAssigned  String[] @default([]) // scope: module keys this user is allowed to see
  projectsAssigned String[] @default([]) // scope: per-site restrictions

  // Account lifecycle
  status             String    @default("active") // active | inactive | suspended
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?

  // Invite metadata
  inviteToken        String?
  inviteTokenExpires DateTime?
  invitedAt          DateTime  @default(now())
  invitedBy          String? // user id of the admin who invited
  invitedByName      String?
  acceptedAt         DateTime?

  // Per-menu Add/Edit/Delete/View matrix edited on the Permissions page.
  // Shape: { [menuKey]: { add, edit, delete, view: boolean } }. Null until
  // the admin saves the matrix for the first time.
  permissionMatrix Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([orgId, email])
  @@unique([orgId, username])
  @@index([email])
  @@index([status])
  @@index([inviteToken])
  @@map("User")
  @@schema("app_quikinfra")
}

// ============================================================================
// FILE OBJECTS â€” generic attachment pointer (attaches to any entity)
// ============================================================================

model CnFileObject {
  id    String @id @default(cuid())
  orgId String

  // Optional parent scoping â€” lets the object key layout reflect ownership
  companyId String?
  projectId String?

  // The attached-to entity
  entityType String // "boq_import" | "grn" | "po" | "wo" | "dpr" | "rab" | "safety_incident" | "quality_inspection" | "project_document"
  entityId   String

  // Original file metadata
  fileName      String
  mimeType      String?
  sizeBytes     Int?
  checksum      String? // sha256 hex â€” optional integrity check
  storageKey    String // canonical object key, e.g. tenants/T123/companies/C1/projects/P1/grn/G1/2026/04/<uuid>-challan.pdf
  storageKind   String  @default("s3") // "s3" | "r2" | "local"
  storageBucket String? // logical bucket name â€” useful when one tenant has its own bucket

  // Lifecycle
  status     String    @default("active") // "pending_upload" | "active" | "deleted"
  uploadedBy String
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?
  deletedBy  String?

  @@index([orgId])
  @@index([entityType, entityId])
  @@index([projectId])
  @@index([status])
  @@map("File_objects")
  @@schema("app_quikinfra")
}

model CnAsset {
  id              String    @id @default(cuid())
  orgId           String
  assetCode       String
  name            String
  category        String?
  projectId       String?
  condition       String?
  currentLocation String?
  purchaseDate    DateTime?
  purchaseValue   Decimal?  @db.Decimal(18, 2)
  currentStock    Decimal?  @db.Decimal(18, 4)
  minStockLevel   Decimal?  @db.Decimal(18, 4)
  reorderLevel    Decimal?  @db.Decimal(18, 4)
  status          String    @default("In Use")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String
  updatedBy       String

  @@unique([orgId, assetCode])
  @@index([orgId])
  @@index([projectId])
  @@map("Assets")
  @@schema("app_quikinfra")
}
