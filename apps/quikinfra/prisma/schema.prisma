// QuikInfra â€” Prisma Schema
// Construction ERP Domain Models
//
// IMPORTANT DESIGN PRINCIPLES:
// - All qty/money fields use Decimal (never Float)
// - stock_ledger is APPEND-ONLY â€” never update/delete rows
// - All entities are tenant-scoped (tenantId + organizationId)
// - Soft delete via status = 'inactive' â€” no hard deletes on masters
// - System-managed computed fields are never written by frontend

generator client {
  provider        = "prisma-client-js"
  // Dedicated output path â€” avoids collision with the root workspace schema
  // in the pnpm virtual store. Multiple apps share @prisma/client in pnpm
  // and the last `prisma generate` wins, so our models get overwritten by
  // the root KPI schema on every workspace postinstall. Custom output solves it.
  output          = "../node_modules/.prisma-qc2/client"
  // Linux engine for Vercel's serverless runtime (rhel-openssl-3.0.x) on
  // top of `native` for local dev. Without this, deploys generate only the
  // host engine and Vercel functions crash with "Query Engine not found".
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  // multiSchema lets us address the dedicated `app_quikinfra` namespace
  // that physically holds every cn_* table in the shared quikit_dev cluster.
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app_quikinfra"]
}

// ============================================================================
// MASTER DATA
// ============================================================================

model CnCompany {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  legalName   String
  shortName   String?
  gstin       String
  pan         String
  cin         String?
  address     String
  city        String
  state       String
  pincode     String
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  bankName    String?
  branchName  String?
  accountNo   String?
  ifscCode    String?
  accountType String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String

  projects CnProject[]
  banks    CnBank[]
  finYears CnFinancialYear[]

  @@index([orgId])
  @@index([gstin])
  @@map("Companies")
  @@schema("app_quikinfra")
}

model CnFinancialYear {
  id        String   @id @default(cuid())
  orgId     String
  companyId String
  label     String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  company CnCompany @relation(fields: [companyId], references: [id])

  @@index([orgId])
  @@map("Financial_years")
  @@schema("app_quikinfra")
}

model CnProject {
  id               String    @id @default(cuid())
  orgId            String
  code             String
  name             String
  description      String?
  projectType      String?
  companyId        String
  clientId         String?
  departmentId     String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  siteGstin        String?
  startDate        DateTime?
  expectedEndDate  DateTime?
  actualEndDate    DateTime?
  projectValue     Decimal?  @db.Decimal(18, 2)
  budget           Decimal?  @db.Decimal(18, 2)
  purchaseLimit    Decimal?  @db.Decimal(18, 2)
  projectManagerId String?
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String
  updatedBy        String

  company          CnCompany               @relation(fields: [companyId], references: [id])
  client           CnCustomer?             @relation(fields: [clientId], references: [id])
  locations        CnLocation[]
  boqItems         CnBOQItem[]
  purchaseReqs     CnPurchaseRequisition[]
  indents          CnPurchaseIndent[]
  pos              CnPurchaseOrder[]
  grns             CnGoodsReceiptNote[]
  issues           CnMaterialIssue[]
  transfers        CnStockTransfer[]
  reconciliations  CnStockReconciliation[]
  workOrders       CnWorkOrder[]
  dprs             CnDailyProgressReport[]
  rabs             CnRunningAccountBill[]
  stockLedger      CnStockLedger[]
  estimations      CnMaterialEstimation[]
  dieselLogs       CnDieselLog[]
  gatePasses       CnGatePass[]
  goodReturns      CnGoodReturn[]
  internalReturns  CnInternalReturn[]
  boqRev2Items     CnBOQItemV2[]
  boqImportBatches CnBOQImportBatch[]
  boqLockState     CnBOQLockState?
  wbsTasks         CnWBSTask[]
  hindrances       CnHindrance[]
  documents        CnProjectDocument[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([companyId])
  @@map("Projects")
  @@schema("app_quikinfra")
}

model CnHindrance {
  id                   String    @id @default(cuid())
  orgId                String
  hindranceNo          String
  projectId            String
  category             String
  dateFrom             DateTime
  dateTo               DateTime?
  daysLost             Int       @default(0)
  status               String    @default("Active")
  description          String
  impactOnCriticalPath String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String
  updatedBy            String

  project CnProject @relation(fields: [projectId], references: [id])

  @@unique([orgId, hindranceNo])
  @@index([orgId])
  @@index([projectId])
  @@index([status])
  @@index([dateFrom])
  @@map("Hindrances")
  @@schema("app_quikinfra")
}

model CnItemGroup {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  parentId       String?
  depth          Int      @default(0)
  sortOrder      Int      @default(0)
  workCategoryId String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
  updatedBy      String

  parent    CnItemGroup?  @relation("ItemGroupHierarchy", fields: [parentId], references: [id])
  children  CnItemGroup[] @relation("ItemGroupHierarchy")
  items     CnItem[]
  locations CnLocation[]

  @@index([orgId])
  @@index([parentId])
  @@map("Item_groups")
  @@schema("app_quikinfra")
}

model CnItem {
  id            String   @id @default(cuid())
  orgId         String
  code          String
  name          String
  description   String?
  itemType      String?
  groupId       String
  /// Denormalized category label for reporting/export (kept in sync with group.name).
  category      String?
  uomId         String
  uomIds        String[] @default([])
  hsnCode       String?
  gstRate       Decimal? @db.Decimal(5, 2)
  minStockLevel Decimal? @db.Decimal(18, 4)
  reorderLevel  Decimal? @db.Decimal(18, 4)
  standardRate  Decimal? @db.Decimal(18, 2)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String
  updatedBy     String

  group       CnItemGroup     @relation(fields: [groupId], references: [id])
  uom         CnUOM           @relation(fields: [uomId], references: [id])
  stockLedger CnStockLedger[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([groupId])
  @@index([orgId, status, createdAt(sort: Desc)])
  @@map("Items")
  @@schema("app_quikinfra")
}

model CnUOM {
  id        String   @id @default(cuid())
  orgId     String
  code      String
  name      String
  type      String?
  precision Int      @default(0)
  isBase    Boolean  @default(false)
  status    String   @default("active")
