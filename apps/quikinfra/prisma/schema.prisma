// ============================================================================
// BOQ V2 â€” Canonical models per Aakar BOQ Import Developer Spec v2.0
// Replaces legacy CnBOQItem (kept for back-compat). See src/lib/boq/types.ts.
// ============================================================================

model CnBOQItemV2 {
  id        String @id @default(cuid())
  orgId     String
  projectId String
  category  String // "Civil Building" | "Electrical" | "Road Works"

  // Hierarchy
  boqNo       String // e.g. "4.1.1.4"
  parentBoqNo String?
  depth       Int     @default(0)
  sortOrder   Int     @default(0)
  isGroup     Boolean @default(false)

  // Display
  displayName String
  description String  @default("")
  unit        String? // null for groups

  // Imported (frozen once lock applied)
  tenderQty   Decimal? @db.Decimal(18, 4)
  rate        Decimal? @db.Decimal(18, 2)
  estimateAmt Decimal  @default(0) @db.Decimal(18, 2)

  // Operational (updated by DPR/RAB workflows)
  scopeQty    Decimal @default(0) @db.Decimal(18, 4)
  subDoneQty  Decimal @default(0) @db.Decimal(18, 4)
  selfDoneQty Decimal @default(0) @db.Decimal(18, 4)
  billedQty   Decimal @default(0) @db.Decimal(18, 4)

  // Schedule â€” optional planned start/end for this BOQ row. Both groups
  // and leaves can carry dates: a group's range is the phase-level
  // rollup the planner uses; a leaf's range is the executable window.
  startDate DateTime?
  endDate   DateTime?

  // Metadata
  isNegative    Boolean @default(false)
  sourceSheet   String  @default("")
  importBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  // Soft delete â€” rows with deletedAt != null are hidden from every read
  // path. Hard delete is never used so historical DPR/RAB postings that
  // reference the row stay coherent.
  deletedAt DateTime?
  deletedBy String?

  project     CnProject         @relation(fields: [projectId], references: [id])
  importBatch CnBOQImportBatch? @relation(fields: [importBatchId], references: [id])

  @@unique([projectId, category, boqNo])
  @@index([orgId])
  @@index([projectId, category])
  @@index([projectId, parentBoqNo])
  @@index([projectId, isGroup])
  @@index([importBatchId])
  @@index([deletedAt])
  @@map("Boq_items_v2")
  @@schema("app_quikinfra")
}

