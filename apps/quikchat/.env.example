# Copy to .env.local and fill in your local-dev values. Never commit .env.local.
#
# DATABASE_URL — your local Postgres for dev. The integration owner moves this
# to Neon during integration; do not include cloud DB URLs in your repo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# Unpooled URL for `npx prisma migrate` in packages/database (required — Prisma P1012 without it).
# Local dev: same host/db as DATABASE_URL. Copy both vars into packages/database/.env when migrating.
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# Legacy name in some docs — same as DATABASE_URL_DIRECT for local dev.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# NextAuth — generate with `openssl rand -base64 32`. Must match every app in the cluster.
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3011"

# QuikIT OAuth (SSO from the launcher). Run `npm run db:seed:oauth --workspace=@quikit/database`
# then set QUIKIT_CLIENT_SECRET to the seeded dev secret for this app.
QUIKIT_URL="http://localhost:3001"
NEXT_PUBLIC_QUIKIT_URL="http://localhost:3001"
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"
QUIKIT_CLIENT_ID="quikchat"
QUIKIT_CLIENT_SECRET="quikchat-dev-secret-change-in-prod"

# Launcher handoff — must match quikit + every other app in the cluster.
INTERNAL_SECRET="REPLACE_WITH_SHARED_INTERNAL_SECRET"

# ============================================================================
# REALTIME GATEWAY (QuikChat) — Batch 1 placeholders
# ============================================================================
# NEXT_PUBLIC_REALTIME_WS_URL — the realtime gateway's public WebSocket origin.
# MUST be NEXT_PUBLIC_* (the browser opens the socket) and is read by
# next.config.js at build time to whitelist the origin in the CSP connect-src.
# Fill with the real deployed gateway origin before deploy (Batch 4/5).
NEXT_PUBLIC_REALTIME_WS_URL="ws://localhost:9100"

# REALTIME_TOKEN_SECRET — HS256 secret QuikChat uses to mint the short-lived
# handshake token the browser presents to the gateway (identifies user + org +
# allowed rooms). Server-side only; never expose to the client.
REALTIME_TOKEN_SECRET="REPLACE_WITH_REALTIME_TOKEN_SECRET"

# REDIS_URL — the Redis bus the gateway and app publish/subscribe on
# (persist-then-publish fan-out). QuikChat uses ioredis directly (Batch 4).
REDIS_URL="redis://localhost:6379"

# ============================================================================
# GOOGLE CLOUD STORAGE — chat media/attachment uploads
# ============================================================================
# Bucket: gs://quikit-bucket (region asia-south1 / Mumbai). Inline SA key.
# GCS-hosted media serves over https, already covered by the CSP img-src https:.
GCS_PROJECT_ID=red-seeker-477810-i0
GCS_BUCKET=quikit-bucket
GCS_CLIENT_EMAIL=quikit-bucket-sa@red-seeker-477810-i0.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
