# Copy to .env.local and fill in your local-dev values. Never commit .env.local.
#
# DATABASE_URL — your local Postgres for dev. The integration owner moves this
# to Neon during integration; do not include cloud DB URLs in your repo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# Unpooled URL for `npx prisma migrate` in packages/database (required — Prisma P1012 without it).
# Local dev: same host/db as DATABASE_URL. Copy both vars into packages/database/.env when migrating.
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# Legacy name in some docs — same as DATABASE_URL_DIRECT for local dev.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# NextAuth — generate with `openssl rand -base64 32`. Must match every app in the cluster.
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3011"

# QuikIT OAuth (SSO from the launcher). Run `npm run db:seed:oauth --workspace=@quikit/database`
# then set QUIKIT_CLIENT_SECRET to the seeded dev secret for this app.
QUIKIT_URL="http://localhost:3001"
NEXT_PUBLIC_QUIKIT_URL="http://localhost:3001"
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"
QUIKIT_CLIENT_ID="quikchat"
QUIKIT_CLIENT_SECRET="quikchat-dev-secret-change-in-prod"

# Launcher handoff — must match quikit + every other app in the cluster.
INTERNAL_SECRET="REPLACE_WITH_SHARED_INTERNAL_SECRET"

# ============================================================================
# PRODUCTION-REQUIRED SIGNING SECRETS
# ============================================================================
# Both fall back to hardcoded, source-visible dev values when unset — fine for
# local work, so `next dev` runs without them, but `instrumentation.ts`
# (assertProductionSecrets) REFUSES TO BOOT in production if either is missing.
# That includes a local `next start`, which sets NODE_ENV=production. If the
# server dies at startup with "Refusing to start in production with missing
# secret(s)", these are why. Generate each with `openssl rand -base64 32`.

# UPLOAD_TOKEN_SECRET — HMAC secret signing upload + download tokens, shared by
# every app-proxied storage driver (local + GCS) so both resolve the same
# secret from one place. Read in lib/server/storage/tokens.ts.
UPLOAD_TOKEN_SECRET="REPLACE_WITH_UPLOAD_TOKEN_SECRET"

# AGENT_JWT_SECRET — HS256 secret for the short-lived JWTs minted for agent /
# runtime calls. Read in lib/server/runtime/token.ts. Server-side only.
AGENT_JWT_SECRET="REPLACE_WITH_AGENT_JWT_SECRET"

# ============================================================================
# REALTIME GATEWAY (QuikChat) — Batch 1 placeholders
# ============================================================================
# NEXT_PUBLIC_REALTIME_WS_URL — the realtime gateway's public WebSocket origin.
# MUST be NEXT_PUBLIC_* (the browser opens the socket) and is read by
# next.config.js at build time to whitelist the origin in the CSP connect-src.
# This is the SINGLE source of truth for the socket URL — all app code reads
# this var (do not reintroduce REALTIME_URL / NEXT_PUBLIC_REALTIME_URL).
# Port MUST match the gateway's listen port (services/realtime PORT=9100).
# 9100 avoids the quikasset app (:3012). Fill with the real deployed gateway
# origin before deploy.
NEXT_PUBLIC_REALTIME_WS_URL="ws://localhost:9100"

# REALTIME_TOKEN_SECRET — HS256 secret QuikChat uses to mint the short-lived
# handshake token the browser presents to the gateway (identifies user + org +
# allowed rooms). Server-side only; never expose to the client.
REALTIME_TOKEN_SECRET="REPLACE_WITH_REALTIME_TOKEN_SECRET"

# REDIS_URL — the Redis bus the gateway and app publish/subscribe on
# (persist-then-publish fan-out). MUST be the SAME instance as
# services/realtime REDIS_URL, or fan-out never reaches the gateway.
REDIS_URL="redis://localhost:6379"

# ============================================================================
# LIVEKIT — SFU for 1:1 and group calls
# ============================================================================
# SFU_MODE — "live" uses the real LiveKit SFU; anything else (default) uses
# the in-process stub (mock room/tokens, no real media). live requires ALL
# THREE vars below or the provider falls back to stub with a boot warning.
SFU_MODE="stub"

# LIVEKIT_URL — your LiveKit Cloud project's WebSocket URL (wss://<project>.livekit.cloud)
# or a self-hosted server's public wss:// origin. Server-only; the browser
# gets this value from the API response, never from a NEXT_PUBLIC_* var, so
# next.config.js reads it directly to whitelist the origin in the CSP.
LIVEKIT_URL="wss://REPLACE_WITH_YOUR_PROJECT.livekit.cloud"

# LIVEKIT_API_KEY / LIVEKIT_API_SECRET — from the LiveKit Cloud dashboard
# (Settings → Keys) or your self-hosted server's keys.yaml. Server-only —
# never expose to the client.
LIVEKIT_API_KEY="REPLACE_WITH_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="REPLACE_WITH_LIVEKIT_API_SECRET"

# ============================================================================
# GOOGLE CLOUD STORAGE — chat media/attachment uploads
# ============================================================================
# Bucket: gs://quikit-bucket (region asia-south1 / Mumbai). Inline SA key.
# GCS-hosted media serves over https, already covered by the CSP img-src https:.
GCS_PROJECT_ID=red-seeker-477810-i0
GCS_BUCKET=quikit-bucket
GCS_CLIENT_EMAIL=quikit-bucket-sa@red-seeker-477810-i0.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ============================================================================
# API REFERENCE (/api-docs)
# ============================================================================
# QUIKCHAT_API_DOCS — ops kill switch for the interactive Swagger UI page at
# /api-docs and its spec route. DEFAULT IS ON: leave unset (or set any other
# value) and the page is served. Set to "off", "0", or "false" — trimmed and
# case-insensitive — to make both 404.
#
# The page is already gated on an authenticated user holding QuikChat app
# access, so this is not the access control; it exists because NODE_ENV cannot
# tell UAT from production here (the Dockerfile sets NODE_ENV=production for
# both), and this is the only way to leave the docs on in UAT while turning
# them off in production.
#
# Read per-request in a force-dynamic route, NOT baked at build time — flipping
# it needs a container restart, not a rebuild, and it is not passed through the
# Dockerfile. Set it in the container environment.
QUIKCHAT_API_DOCS="on"
