{
  "name": "quikchat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "_comment_dev_disabled": "dev script disabled 2026-08-07 — port 3011 conflicts with quikflow; use 'dev:manual' to run quikchat standalone",
    "dev:manual": "next dev -p 3011",
    "prebuild": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "build": "next build",
    "start": "next start -p 3011",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --open"
  },
  "dependencies": {
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@google-cloud/storage": "7.12.1",
    "@quikit/auth": "*",
    "@quikit/database": "*",
    "@quikit/shared": "*",
    "@quikit/ui": "*",
    "@sentry/node": "8.26.0",
    "@tanstack/react-query": "^5.51.1",
    "@tiptap/extension-placeholder": "2.27.2",
    "@tiptap/pm": "2.27.2",
    "@tiptap/react": "2.27.2",
    "@tiptap/starter-kit": "2.27.2",
    "date-fns": "3.6.0",
    "date-holidays": "^3.32.0",
    "ioredis": "5.4.1",
    "jose": "^5.9.6",
    "jsonwebtoken": "9.0.2",
    "livekit-client": "^2.20.0",
    "livekit-server-sdk": "^2.15.5",
    "lucide-react": "^0.294.0",
    "next": "14.0.4",
    "next-auth": "^4.24.7",
    "pino": "9.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "4.7.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
