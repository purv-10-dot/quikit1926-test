    "@types/ioredis-mock": "^8.2.7",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "^20.17.10",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
