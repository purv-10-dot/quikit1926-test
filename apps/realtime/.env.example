# Port the relay listens on
PORT=4001

# Comma-separated list of allowed browser origins (your app URLs).
# Leave empty in local dev to reflect any origin.
REALTIME_ALLOWED_ORIGINS=http://localhost:3002

# Must match the apps so handshake tokens verify. Falls back to NEXTAUTH_SECRET.
# REALTIME_JWT_SECRET=
NEXTAUTH_SECRET=replace-with-shared-secret

# Same Redis the apps use (for the Pub/Sub bridge + Socket.io adapter).
REDIS_URL=redis://localhost:6379
