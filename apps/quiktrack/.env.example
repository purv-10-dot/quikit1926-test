# Copy to .env.local and fill in your local-dev values. Never commit .env.local.
#
# DATABASE_URL — your local Postgres for dev. The integration owner moves this
# to Neon during integration; do not include cloud DB URLs in your repo.
DATABASE_URL="postgresql://postgres:Atharva09@localhost:5432/quikit_dev"

# Same value as DATABASE_URL for Prisma migrate (per CLAUDE.md). Do not point at prod.
MIGRATION_DATABASE_URL="postgresql://postgres:Atharva09@localhost:5432/quikit_dev"

# NextAuth — generate with `openssl rand -base64 32`. Replace before first run.
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3004"

# This app's own public origin. Consumed by the marketing landing Nav's
# buildLoginUrl() to build the post-SSO callbackUrl. Must equal NEXTAUTH_URL
# in dev. In prod set to e.g. https://track.quikit.ai.
NEXT_PUBLIC_QUIKTRACK_URL="http://localhost:3004"

# QuikIT OAuth (SSO from the launcher). The integration owner provides real
# values during integration; for local dev create your own dev client.
QUIKIT_CLIENT_ID="dev-client-id-placeholder"
QUIKIT_CLIENT_SECRET="dev-client-secret-placeholder"
# Base URL of the QuikIT IdP. QUIKIT_URL is the primary name; QUIKIT_ISSUER_URL
# is the accepted OIDC-conventional alias (lib/auth.ts reads QUIKIT_URL first,
# then falls back to QUIKIT_ISSUER_URL). Set ONE of them — in prod e.g.
# https://quik-it-auth.vercel.app.
QUIKIT_URL="http://localhost:3000"

# Optional: only set if your app needs Sentry locally. Leave blank for dev.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Google Cloud Storage — document/asset uploads (bucket gs://quikit-bucket,
# region asia-south1). Get the service-account key from the integration owner.
# GCS_PRIVATE_KEY is single-line with escaped `\n` (kept inside double quotes);
# lib/storage.ts un-escapes it before signing.
GCS_PROJECT_ID="red-seeker-477810-i0"
GCS_BUCKET="quikit-bucket"
GCS_CLIENT_EMAIL="quikit-bucket-sa@red-seeker-477810-i0.iam.gserviceaccount.com"
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# AI Runtime integration (Quikverse AI team, #ai-integration). Get real values
# from Suyash.
# INTERNAL_AI_RUNTIME_URL — base URL of the AI Runtime service, for QuikTrack
# to call out to it (use cases, execute()).
# INTERNAL_AI_RUNTIME_SECRET — this is the *storage* name only. The runtime
# sends it on the wire as the `x-internal-secret` header (same pattern as
# INTERNAL_SECRET / provision-roles), validated with a constant-time compare,
# fail-closed on empty. Do NOT name the HTTP header INTERNAL_AI_RUNTIME_SECRET.
INTERNAL_AI_RUNTIME_URL="https://uataiengine.quikit.ai"
INTERNAL_AI_RUNTIME_SECRET="REPLACE_WITH_VALUE_FROM_SUYASH"

# ALLOW_AGENT_JWT_DEBUG — set to "true" to make lib/api/agentJwt.ts log WHICH
# check rejected an agent JWT (empty token, decrypt/alg failure, claim-shape
# mismatch with the payload's key NAMES, missing iat/exp, over the age bound).
# Off by default; safe to enable in a deployed environment — reasons and key
# names only, never a token, a payload, or a claim value.
#
# Turn this on FIRST when the AI Runtime reports a 401 it cannot explain.
# verifyAgentJwt returns null for eight distinct failures and is otherwise
# silent about which; a claim-shape mismatch (`id` where `sub` was expected)
# once cost both teams an afternoon that this flag would have ended in minutes.
ALLOW_AGENT_JWT_DEBUG=""

# QuikPilot — the absolute base URL that the CUSTOMER'S GitHub Actions runner
# calls back to. It is handed to a third-party system, so it is read from the
# environment and NEVER derived from a request header (a Host header from an
# untrusted caller would be an SSRF vector).
#
# Falls back to NEXT_PUBLIC_QUIKTRACK_URL when unset. In production a localhost
# value is rejected at dispatch time rather than silently producing a callback
# that never arrives — GitHub's runners cannot reach your machine. For local
# end-to-end testing point this at a tunnel (e.g. an ngrok https URL).
QUIKPILOT_CALLBACK_BASE_URL=""
