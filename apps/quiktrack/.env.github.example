# ─── QuikTrack GitHub integration ────────────────────────────────────────────
# Copy this block into apps/quiktrack/.env.local and fill in the values from the
# GitHub App you created at https://github.com/settings/apps/new
# (see docs/github-app-setup.md for the field-by-field mapping).
#
# After pasting real values, RESTART the dev server (npm run dev) so Next.js
# picks them up. The "Connect GitHub" button then appears in
# Settings → Integrations → GitHub.
#
# DO NOT commit .env.local — it is gitignored. This .example file is safe to
# commit (no real secrets in it).

# App ID — the numeric "App ID" at the top of the App settings page.
GITHUB_APP_ID=

# The slug in the App URL github.com/apps/<slug>
GITHUB_APP_SLUG=

# OAuth "Client ID" on the App settings page.
GITHUB_APP_CLIENT_ID=

# "Generate a new client secret" on the App settings page.
GITHUB_APP_CLIENT_SECRET=

# The generated private key (.pem). Paste the WHOLE file contents on one line,
# replacing each real newline with \n. The app un-escapes it automatically.
# Example: "-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=

# Only needed once you enable webhooks (a public URL / tunnel). Leave blank for
# localhost-only testing. If set, paste the SAME value into the App's webhook
# secret field on GitHub.
GITHUB_APP_WEBHOOK_SECRET=

# 32-byte base64 key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional — falls back to NEXTAUTH_SECRET if omitted. Leave blank to use that.
# GITHUB_OAUTH_STATE_SECRET=
