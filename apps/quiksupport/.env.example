# Copy to .env.local and fill in your local-dev values. Never commit .env.local.

# ============================================================================
# DATABASE — the shared cluster DB (auth / quikit / public / app_quiksupport
# schemas live in the SAME database). In dev this is your local Postgres or the
# shared Neon cluster; the integration owner provides the Neon URL.
# ============================================================================
DATABASE_URL="postgresql://postgres:Atharva09@localhost:5432/quikit_dev"
# Direct (non-pooler) endpoint — required by Prisma for migrate / DDL.
DATABASE_URL_DIRECT="postgresql://postgres:Atharva09@localhost:5432/quikit_dev"

# ============================================================================
# NEXTAUTH — NEXTAUTH_SECRET must be identical across every app in the cluster.
# ============================================================================
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3010"

# App URLs (cross-app navigation).
NEXT_PUBLIC_SUPER_ADMIN_URL="http://localhost:3000"
NEXT_PUBLIC_QUIKIT_URL="http://localhost:3000"
# This app's own origin (used by the marketing Nav buildLoginUrl()). MUST equal NEXTAUTH_URL.
NEXT_PUBLIC_QUIKSUPPORT_URL="http://localhost:3010"

# Server-side per-app URL overrides for /api/apps/switcher (dev localhost values).
ADMIN_URL="http://localhost:3002"
QUIKSCALE_URL="http://localhost:3003"
QUIKTRACK_URL="http://localhost:3004"
QUIKVC_URL="http://localhost:3005"
QUIKINFRA_URL="http://localhost:3006"
QUIKSOCIAL_URL="http://localhost:3007"
QUIKCRM_URL="http://localhost:3008"
QUIKHRMS_URL="http://localhost:3009"
QUIKSUPPORT_URL="http://localhost:3010"
QUIKASSET_URL="http://localhost:3012"

# ============================================================================
# QUIKIT PLATFORM SSO (OAuth2) — IdP is the launcher on :3000.
# ============================================================================
QUIKIT_URL="http://localhost:3000"
QUIKIT_CLIENT_ID="quiksupport"
QUIKIT_CLIENT_SECRET="quiksupport-dev-secret-change-in-prod"

# Central credentials login service (apps/auth).
NEXT_PUBLIC_AUTH_URL="http://localhost:3001"

# ============================================================================
# CROSS-APP INFRASTRUCTURE — must match auth/quikit/quikscale/...
# ============================================================================
INTERNAL_SECRET=shared-secret-for-internal-calls
REDIS_URL=redis://localhost:6379

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL="info"
SENTRY_DSN=""

# ============================================================================
# HELPDESK — email (optional; queue is a no-op without REDIS_URL + a worker).
# NEXT_PUBLIC_APP_URL is used in email deep-links; MUST equal this app's origin.
# ============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3010"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS="MoreYeahs@123"
SMTP_FROM="QuikSupport <support@quikit.ai>"

# ============================================================================
# GOOGLE CLOUD STORAGE — support-request attachments
# ============================================================================
# Required for the Contact Support widget's file/image upload. Without these
# the support form still works, but attaching a file returns a clear
# "storage is not configured" error instead of silently dropping it.
# Ask the platform team for the shared bucket's service-account credentials.
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_CLIENT_EMAIL=
# Escaped 
 newlines, wrapped in double quotes.
GCS_PRIVATE_KEY=""

# Signed URL TTLs (seconds) — default 300 if unset.
STORAGE_UPLOAD_URL_TTL_SEC=300
STORAGE_DOWNLOAD_URL_TTL_SEC=300
