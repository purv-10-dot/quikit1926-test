# =============================================================
# QuikSocial (monorepo) — Environment Variables
# Copy this file to .env.local for local dev. Never commit .env.local.
# =============================================================

# ── Postgres (Prisma) ────────────────────────────────────────
# DATABASE_URL is the runtime connection (pgbouncer-friendly).
# DATABASE_URL_DIRECT is the direct connection used by `prisma migrate`
# (must bypass any connection pooler). Pointing both at the same local
# Postgres is fine for dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quikit_dev"
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# ── NextAuth ─────────────────────────────────────────────────
# Generate with `openssl rand -base64 32`. MUST match every other QuikIT
# app so the shared session cookie decrypts here.
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3007"

# ── Central auth + cross-app handoff (monorepo platform) ─────
# The launcher (apps/quikit) mints handoff JWTs and bounces unauthenticated
# users here through a cross-domain hand-off. See middleware.ts.
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"
QUIKIT_URL="http://localhost:3001"
NEXT_PUBLIC_QUIKIT_URL="http://localhost:3001"

# QuikIT OAuth (SSO from the launcher). Integration owner provides real
# values; for local dev create your own dev client in apps/quikit.
QUIKIT_CLIENT_ID="quiksocial"
QUIKIT_CLIENT_SECRET="quiksocial-dev-secret-change-in-prod"
QUIKIT_ISSUER_URL="http://localhost:3000"

# Shared internal-call secret across launcher + auth + admin + apps.
INTERNAL_SECRET="shared-secret-for-internal-calls"

# ── Default tenant (Org) ─────────────────────────────────────
# Used by cron routes that run without a session (publish-scheduled,
# auto-reply-monitor). Must match a row in quikit.Org. The legacy
# DEFAULT_TENANT_ID name is read as a fallback for v2-era .env files.
DEFAULT_ORG_ID="cmor2pmif0000fajrijnuizqi"
# DEFAULT_TENANT_ID=  # legacy alias — only set if migrating an old env file

# ── Cron auth ────────────────────────────────────────────────
# Bearer token the in-process cron driver (lib/cron/scheduler.ts) sends
# to /api/cron/publish-scheduled and /api/cron/auto-reply-monitor.
CRON_SECRET="quiksocial-cron-secret-dev"

# ── Python AI service (Railway) ──────────────────────────────
# AI_SERVICE_URL — base URL of the FastAPI service that owns campaign
# generation, post idea gen, image gen, brand scrape, auto-reply replies.
# AI_SERVICE_WS_URL — WebSocket endpoint (ws:// locally, wss:// on Railway).
# QS_INTERNAL_TOKEN — shared with the Python side; used in BOTH directions
# (Next.js → Python: X-QS-Internal-Token; Python → Next.js /api/internal/*:
# same header).
AI_SERVICE_URL="https://quiksocial-v2-production.up.railway.app"
AI_SERVICE_WS_URL="wss://quiksocial-v2-production.up.railway.app"
QS_INTERNAL_TOKEN=""

# ── Cloudinary (asset upload) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Meta Graph OAuth (Facebook + Instagram) ──────────────────
# From https://developers.facebook.com/apps — Settings → Basic.
# OAuth redirect URIs on the Facebook Login product:
#   {NEXTAUTH_URL}/api/integrations/callback/facebook
#   {NEXTAUTH_URL}/api/integrations/callback/instagram
META_APP_ID=""
META_APP_SECRET=""
# Legacy aliases (still read as a fallback during the META_APP_* migration).
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""

# ── LinkedIn OAuth (optional) ────────────────────────────────
# Redirect URI on https://www.linkedin.com/developers/apps:
#   {NEXTAUTH_URL}/api/integrations/callback/linkedin
LINKEDIN_APP_ID=""
LINKEDIN_APP_SECRET=""

# ── YouTube / Google OAuth (optional) ────────────────────────
# Redirect URI on Google Cloud Console:
#   {NEXTAUTH_URL}/api/integrations/callback/youtube
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── SMTP (workspace invites + scrape-ready emails) ───────────
# Gmail app password via smtp.gmail.com:465 (used by lib/utils/email.ts).
EMAIL_USER=""
EMAIL_PASSWORD=""
SMTP_FROM=""

# ── Misc ─────────────────────────────────────────────────────
# Lower environments often hit a self-signed cert chain on the AI service;
# only set to "0" when you understand the trade-off (never in prod).
NODE_TLS_REJECT_UNAUTHORIZED="1"
LOG_LEVEL="info"
ENVIRONMENT="development"

# Optional: Sentry. Leave blank for dev.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
