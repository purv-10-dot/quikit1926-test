# Copy to .env.local and fill in your local-dev values. Never commit .env.local.
#
# DATABASE_URL — your local Postgres for dev. The integration owner moves this
# to Neon during integration; do not include cloud DB URLs in your repo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# Same value as DATABASE_URL for Prisma migrate (per CLAUDE.md). Do not point at prod.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quikit_dev"

# NextAuth — generate with `openssl rand -base64 32`. Replace before first run.
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3013"

# QuikIT OAuth (SSO from the launcher). The integration owner provides real
# values during integration; for local dev create your own dev client.
# lib/auth.ts reads QUIKIT_URL/CLIENT_ID/CLIENT_SECRET (same as quiktrack).
QUIKIT_URL="http://localhost:3000"
QUIKIT_CLIENT_ID="quikfinance"
QUIKIT_CLIENT_SECRET="quikfinance-dev-secret-change-in-prod"

# Middleware SSO + launcher cross-domain handoff. NEXT_PUBLIC_* are inlined at
# build time. INTERNAL_SECRET must match the launcher's value.
NEXT_PUBLIC_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_QUIKIT_URL="http://localhost:3000"
INTERNAL_SECRET="REPLACE_WITH_LAUNCHER_INTERNAL_SECRET"

# Portal subdomain hosts → rewritten onto /client | /vendor | /ca route groups.
NEXT_PUBLIC_PORTAL_HOST_CLIENT="client.quikit.ai"
NEXT_PUBLIC_PORTAL_HOST_VENDOR="vendor.quikit.ai"
NEXT_PUBLIC_PORTAL_HOST_CA="ca.quikit.com"

# Optional: only set if your app needs Sentry locally. Leave blank for dev.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
