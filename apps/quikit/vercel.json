{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npx turbo build --filter=quikit",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/super/cron/cleanup-api-calls",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/super/cron/generate-invoices",
      "schedule": "0 1 1 * *"
    }
  ]
}
