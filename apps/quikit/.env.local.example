# QuikIT Gateway — Environment Variables
DATABASE_URL="postgresql://user:password@localhost:5432/quikscale_dev"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth IdP — JWT signing keys (optional in dev — auto-generated if unset)
# Generate with: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
# JWT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_SIGNING_KEY_PUBLIC="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# App URLs (for redirecting to apps from the launcher)
QUIKSCALE_URL="http://localhost:3004"
ADMIN_URL="http://localhost:3005"
