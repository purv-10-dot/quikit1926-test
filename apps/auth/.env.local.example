# ── auth.quikit.ai (v4 common auth service) ──────────────────
# Same Postgres as other apps (encode special chars in password, e.g. @ → %40)
DATABASE_URL="postgresql://postgres:Atharva09@localhost:5432/quikit_dev"
DATABASE_URL_DIRECT="postgresql://postgres:Atharva09@localhost:5432/quikit_dev"


# Shared across ALL apps so the same JWT is trusted everywhere
NEXTAUTH_SECRET=your-shared-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Public URL of this service — other apps redirect unauthenticated users here
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# Where to redirect after successful login (the launcher app)
NEXT_PUBLIC_LAUNCHER_URL=http://localhost:3001/apps
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Shared secret for internal token-verify calls from other apps
INTERNAL_SECRET=shared-secret-for-internal-calls

# ── Outbound email ──────────────────────────────────────────────
# Two transports supported, picked at runtime. SMTP wins when both are set.
#
# Option A (preferred — same config used by apps/quikit):
#   SMTP via nodemailer. Office365 example below.
# SMTP — Office365 (support@quikit.ai). Backslash-escapes $ to prevent dotenv expansion.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=support@quikit.ai
SMTP_PASS="MoreYeahs@123"
SMTP_FROM=support@quikit.ai
#
# Option B (fallback):
#   Resend. Used only if SMTP_HOST is unset.
# RESEND_API_KEY=

# Without either configured, sends are no-ops in dev — the OTP / link is
# printed to the auth-app server console as `[auth-email] ... → <code>`.

# ── Google / Microsoft SSO ──────────────────────────────────────
# OAuth flow: User clicks "Continue with Google" / "Continue with Microsoft"
# → NextAuth redirects to provider → provider redirects back to
#   /api/auth/callback/google   (Google)
#   /api/auth/callback/azure-ad (Microsoft)
# → signIn callback rejects unknown emails ("Invalid user information").
# Existing users land on /select-org which gates profile completeness.
#
# IMPORTANT: register the NextAuth callback URLs above (NOT /auth/google/callback)
# in Google Cloud Console → OAuth client → Authorized redirect URIs, and in
# Azure Entra → App registration → Redirect URIs. Multiple URIs are allowed,
# so you can keep any old ones registered alongside.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant scoping for the Azure AD / Entra ID provider:
#   organizations  → any work/school tenant (recommended for SaaS multi-tenant login)
#   common         → work/school + personal Microsoft accounts (@outlook.com, @hotmail.com)
#   <tenant-GUID>  → restrict sign-in to a single organization
MICROSOFT_TENANT_ID=common
