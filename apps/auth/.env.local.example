# ── auth.quikit.ai (v4 common auth service) ──────────────────
# Same Postgres as other apps (encode special chars in password, e.g. @ → %40)
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/quikscale_dev
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@localhost:5432/quikscale_dev

# Shared across ALL apps so the same JWT is trusted everywhere
NEXTAUTH_SECRET=your-shared-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3004

# Public URL of this service — other apps redirect unauthenticated users here
NEXT_PUBLIC_AUTH_URL=http://localhost:3004

# Where to redirect after successful login (the launcher app)
NEXT_PUBLIC_LAUNCHER_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Shared secret for internal token-verify calls from other apps
INTERNAL_SECRET=shared-secret-for-internal-calls

# Optional — email provider (Resend)
RESEND_API_KEY=

# Optional — Google / Microsoft SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
