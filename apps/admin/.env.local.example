# NextAuth
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3005

# Database (local PostgreSQL)
DATABASE_URL="postgresql://postgres:Atharva09@localhost:5432/quikit_dev"

# Redis (local)
REDIS_URL=redis://localhost:6379

# Email (SMTP) — invitation emails are sent via nodemailer (lib/email.ts).
# Use the same account as the quikit launcher. `secure` is derived from the
# port (465 = implicit TLS, 587 = STARTTLS), so set SMTP_PORT to match.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=support@quikit.ai
SMTP_PASS="Q!kH#eLp3r$26%X7"
SMTP_FROM=support@quikit.ai

# App URL (admin's own host).
APP_URL=http://localhost:3005

# Cross-app navigation URLs — override the DB's stored App.baseUrl (prod
# Vercel URLs) in /api/apps/switcher so the app-switcher grid routes to local
# dev ports. One per provisioned app.
QUIKSCALE_URL=http://localhost:3003
QUIKTRACK_URL=http://localhost:3004
QUIKINFRA_URL=http://localhost:3006
QUIKASSET_URL=http://localhost:3012

# Invitation links — the "Set Up My Account" button in onboarding emails
# points at `${NEXT_PUBLIC_QUIKIT_URL}/invitations/accept?token=…`. This must
# resolve to the QuikIT launcher (which auto-opens its marketing-page
# LoginModal on `?next=`), NOT the central auth host. :3001 in dev.
NEXT_PUBLIC_QUIKIT_URL=http://localhost:3001
QUIKIT_URL=http://localhost:3001

# Sentry (optional)
# SENTRY_DSN=

# QuikIT OAuth (leave blank for local CredentialsProvider mode).
# QUIKIT_URL / NEXT_PUBLIC_QUIKIT_URL are also used by the invitation-email
# renderer above — keep them in sync.
# QUIKIT_CLIENT_ID=
# QUIKIT_CLIENT_SECRET=
