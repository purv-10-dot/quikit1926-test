# QuikCRMExpress — environment template
#
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# This file contains PLACEHOLDERS ONLY — no real secret belongs here.
#
# Full per-variable documentation (including which controls fail OPEN when left
# blank) lives in the header of `.env.local`. Ask the integration owner for a
# populated copy when provisioning a new environment.
#
# MANDATORY: DATABASE_URL, DATABASE_URL_DIRECT, JWT_SECRET, NEXTAUTH_SECRET,
# NEXTAUTH_URL, INTERNAL_SECRET, QUIKIT_URL, QUIKIT_CLIENT_ID,
# QUIKIT_CLIENT_SECRET, NEXT_PUBLIC_AUTH_URL, NEXT_PUBLIC_QUIKIT_URL,
# NEXT_PUBLIC_QUIKCRMEXPRESS_URL, NEXT_PUBLIC_APP_URL.
#
# This app's dev port is 3017.

ADMIN_URL=<http://localhost:PORT>
DATABASE_URL=<postgresql://user:password@host:5432/dbname>
DATABASE_URL_DIRECT=<postgresql://user:password@host:5432/dbname>
FEATURE_AI_INSIGHTS=<value>
FEATURE_POWER_OF_ONE=<value>
FEATURE_SLACK_INTEGRATION=<value>
GCS_BUCKET=<value>
GCS_CLIENT_EMAIL=<value>
GCS_PRIVATE_KEY=<set-in-prod>
GCS_PROJECT_ID=<value>
INTERNAL_SECRET=<set-in-prod>
JWT_SECRET=<set-in-prod>
LOG_LEVEL=<value>
MAIL_FROM=<value>
MIGRATION_DATABASE_URL=<postgresql://user:password@host:5432/dbname>
NEXTAUTH_SECRET=<set-in-prod>
NEXTAUTH_URL=<http://localhost:PORT>
NEXT_PUBLIC_APP_URL=<http://localhost:PORT>
NEXT_PUBLIC_AUTH_URL=<http://localhost:PORT>
NEXT_PUBLIC_QUIKCRMEXPRESS_URL=<http://localhost:PORT>
NEXT_PUBLIC_QUIKIT_URL=<http://localhost:PORT>
QUEUE_REDIS_URL=<redis://localhost:6379>
QUIKCRM_URL=<http://localhost:PORT>
QUIKHRMS_URL=<http://localhost:PORT>
QUIKINFRA_URL=<http://localhost:PORT>
QUIKIT_CLIENT_ID=<set-in-prod>
QUIKIT_CLIENT_SECRET=<set-in-prod>
QUIKIT_URL=<http://localhost:PORT>
QUIKSCALE_URL=<http://localhost:PORT>
QUIKSOCIAL_URL=<http://localhost:PORT>
QUIKSUPPORT_URL=<http://localhost:PORT>
QUIKTRACK_URL=<http://localhost:PORT>
QUIKVC_URL=<http://localhost:PORT>
REDIS_URL=<redis://localhost:6379>
RP_DIGITAL_AUTHCODE=<value>
RP_DIGITAL_BASE_URL=<http://localhost:PORT>
RP_DIGITAL_BASIC_PASSWORD=<set-in-prod>
RP_DIGITAL_BASIC_USER=<value>
RP_DIGITAL_CALLING_PARTY_A=<value>
RP_DIGITAL_CALL_LIMIT=<value>
RP_DIGITAL_DESKPHONE=<value>
RP_DIGITAL_UID=<value>
RP_DIGITAL_WEBHOOK_SECRET=<set-in-prod>
SMTP_FROM=<value>
SMTP_HOST=<value>
SMTP_PASS=<set-in-prod>
SMTP_PORT=<value>
SMTP_SECURE=<value>
SMTP_USER=<value>
STORAGE_DOWNLOAD_URL_TTL_SEC=<value>
STORAGE_UPLOAD_URL_TTL_SEC=<value>
WEBHOOK_DEFAULT_ORG_ID=<value>
WEBHOOK_REQUIRE_SECRET=<set-in-prod>
