# Copy to `.env.local` and fill in values. Never commit `.env.local`.
#
# DATABASE_URL — local Postgres for dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/first_db_crm"

# Prisma 5.22+ uses this for migrations when set in schema; use same DB as
# DATABASE_URL when not using a pooler.
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5432/first_db_crm"

# Same value as DATABASE_URL for Prisma migrate (per project docs).
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/first_db_crm"

# NextAuth — generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3076"

# Optional: only set if your app needs Sentry locally. Leave blank for dev.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
