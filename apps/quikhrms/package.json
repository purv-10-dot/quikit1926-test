{
  "name": "quikit-hrms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3009",
    "prebuild": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "build": "next build",
    "start": "next start -p 3009",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=../../packages/database/prisma/schema.prisma",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:leaves": "tsx --env-file=.env.local scripts/seed-leaves-demo.ts",
    "seed:recruit": "tsx --env-file=.env.local scripts/seed-recruit-demo.ts",
    "migrate:tds-challans": "tsx --env-file=.env.local scripts/migrate-tds-challans.ts",
    "oauth:register": "tsx --env-file=.env.local scripts/register-oauth-client.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@google-cloud/storage": "^7.14.0",
    "@google/generative-ai": "^0.24.1",
    "@openrouter/sdk": "^0.12.19",
    "@quikit/auth": "*",
    "@quikit/database": "*",
    "@quikit/redis": "*",
    "@quikit/shared": "*",
    "@quikit/ui": "*",
    "@tanstack/react-query": "^5.28.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "geist": "^1.3.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "14.0.4",
    "next-auth": "^4.24.0",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.4",
