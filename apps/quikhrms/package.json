    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^2.4.3",
    "eslint": "^8.55.0",
    "eslint-config-next": "14.0.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  }
