# quikhrms environment template — placeholders only, never commit real secrets.
# This documents the storage variables added in the S3 → GCS migration. Other
# runtime vars (DATABASE_URL, NEXTAUTH_*, SMTP_*, etc.) live in .env.local — get
# their values from the integration owner.

# ============================================================================
# GOOGLE CLOUD STORAGE — document/asset uploads
# ============================================================================
# Bucket: gs://quikit-bucket (region asia-south1 / Mumbai). Inline SA key.
# GCS_PRIVATE_KEY is single-line with escaped \n inside double quotes; the
# storage layer (lib/storage.ts) un-escapes it before signing.
GCS_PROJECT_ID=red-seeker-477810-i0
GCS_BUCKET=quikit-bucket
GCS_CLIENT_EMAIL=quikit-bucket-sa@red-seeker-477810-i0.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional: override the public object base URL. Defaults to
# https://storage.googleapis.com/${GCS_BUCKET} when unset.
# GCS_PUBLIC_URL=
