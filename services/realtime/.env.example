# @quikit/realtime-gateway — environment contract (plan §5).
# Copy to `.env` (auto-loaded by `npm run dev` via --env-file-if-exists) and fill in.
# Placeholders only — never commit real secrets. `.env` is gitignored at the repo root.

# Postgres connection used by @quikit/database for membership / presence / call reads.
DATABASE_URL="postgresql://user:password@localhost:5432/quikit"
# Non-pooled Postgres URL (Prisma directUrl). Same as DATABASE_URL for local dev.
DATABASE_URL_DIRECT="postgresql://user:password@localhost:5432/quikit"

# REQUIRED — HMAC secret for the handshake JWT. The process exits on boot if unset.
REALTIME_TOKEN_SECRET="change-me-dev-only-secret"

# Redis for the Socket.IO adapter, fan-out subscribe, presence, and ringing state.
# MUST be the SAME instance apps/quikchat publishes fan-out to (its REDIS_URL),
# otherwise published events never reach the gateway. Aligned to 6379.
REDIS_URL="redis://localhost:6379"

# CSV of allowed CORS origins for the Socket.IO handshake. Default: http://localhost:3011
REALTIME_ALLOWED_ORIGINS="http://localhost:3011"

# HTTP/WS listen port. Default 9100 (REALTIME_PORT is also accepted as an alias).
# 9100 avoids the quikasset app (:3012); must match apps/quikchat
# NEXT_PUBLIC_REALTIME_WS_URL.
PORT="9100"

# Max inbound Socket.IO frame size in bytes. Default 1000000 (1 MB).
REALTIME_MAX_BUFFER_BYTES="1000000"
