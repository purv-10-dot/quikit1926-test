{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // Retained from the SDK's own tsconfig — the source was written under both
    // flags, so keeping them preserves the author's intent while the rest of
    // the config comes from tsconfig.base.json like every other package.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
