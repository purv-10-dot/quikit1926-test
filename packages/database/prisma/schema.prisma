// ─── ATTENDANCE ─────────────────────────────────────────

model AttendanceRecord {
  id         String   @id @default(cuid())
  orgId   String
  employeeId String
  date       DateTime @db.Date

  checkIn        DateTime?
  checkOut       DateTime?
  punches        Json?
  effectiveHours Decimal?  @db.Decimal(5, 2)
  grossHours     Decimal?  @db.Decimal(5, 2)
  breakDuration  Decimal?  @db.Decimal(5, 2)
  overtime       Decimal?  @db.Decimal(5, 2)

  status AttendanceStatus  @default(NotMarked)
  source AttendanceSource?

  checkInLocation  Json?
  checkOutLocation Json?
  ipAddress        String?

  regularizationStatus RegularizationStatus @default(None)
  regularizationReason String?

  remarks         String?
  isLateCheckIn   Boolean @default(false)
  isEarlyCheckOut Boolean @default(false)
  lateByMinutes   Int     @default(0)
  earlyByMinutes  Int     @default(0)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([orgId, employeeId, date])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, employeeId])
  @@index([orgId, date])
  @@index([orgId, employeeId, date])
  @@schema("app_quikhrms")
}

model AttendancePolicy {
  id       String @id @default(cuid())
  orgId String
  name     String

  applicableTo Json?

  graceMinutes          Int     @default(15)
  halfDayThresholdHours Decimal @default(4) @db.Decimal(4, 2)
  fullDayThresholdHours Decimal @default(8) @db.Decimal(4, 2)
  minHoursForOvertime   Decimal @default(9) @db.Decimal(4, 2)

  ipWhitelist              Json?
  geoFenceRadius           Int?
  geoFenceCoordinates      Json?
  allowWebCheckin          Boolean @default(true)
  allowMobileCheckin       Boolean @default(true)
  requireLocationForMobile Boolean @default(false)

  latePenalization   Json?
  absentPenalization Json?

  allowRegularization          Boolean @default(true)
  regularizationApprovalLevels Int     @default(1)
  maxRegularizationsPerMonth   Int     @default(3)

  isDefault Boolean @default(false)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orgId])
  @@index([orgId, deletedAt])
  @@schema("app_quikhrms")
}

// ─── SHIFT MANAGEMENT ───────────────────────────────────

model ShiftPolicy {
  id       String  @id @default(cuid())
