// ─── TDS Liability / Challan / Reconciliation (v2) ────────────────────
// New design — see docs/architecture-tds.md (also reflected in the original
// design conversation). Legacy `TDSChallan` model is retained for backward
// compatibility; this is the production-grade replacement.

enum TdsPeriodStatus {
  Pending
  Overdue
  Partial
  Paid
