}

model SWTEntry {
  id             String   @id @default(cuid())
  orgId          String
  quarter        String
  year           Int
  type           String
  content        String
  impact         String?
  category       String?
  trendDirection String?
  sortOrder      Int      @default(0)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

