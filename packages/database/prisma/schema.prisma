/// QuikIT RBAC v2 — org-scoped role definition for QuikSocial. Sits on top
/// of the per-brand BrandMembership (which keeps owning brand-level
/// admin/approver/member); this AppRole gates org-wide "QuikSocial admin"
/// capabilities. DB table is `AppRole` in `app_quiksocial` (via @@map);
/// Prisma model name is prefixed `Qs` so it can coexist with QuikScale's
/// AppRole + QuikTrack's QtAppRole etc. in a single schema.prisma.
model QsAppRole {
  id          String             @id @default(cuid())
  orgId       String
  appId       String
  name        String
  description String?
  isSystem    Boolean            @default(false)
  isDefault   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   String?
  app         App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  org         Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  navigations QsRoleNavigation[]
  permissions QsRolePermission[]
  members     QsUserAppRole[]

  @@unique([orgId, appId, name])
  @@index([orgId, appId])
  @@map("AppRole")
  @@schema("app_quiksocial")
}

model QsUserAppRole {
  id         String    @id @default(cuid())
