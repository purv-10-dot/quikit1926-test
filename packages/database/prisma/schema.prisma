  employee Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, roleId])
  @@index([roleId])
  @@index([userId, orgId])
  @@index([expiresAt])
  @@schema("app_quikhrms")
}

enum PermissionGrantKind {
