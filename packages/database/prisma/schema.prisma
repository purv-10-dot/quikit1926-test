// ============================================================================
// AUTO-REPLY (Phase 1) — Meta Graph polling + template/AI reply pipeline.
// Ported from quiksocial-v2. Polling is driven by instrumentation.ts cron
// tick → /api/cron/auto-reply-monitor → internal API routes → Python AI
// service on Railway (no BullMQ/Redis on the Next.js side).
// ============================================================================

enum AutoReplyTriggerType {
  ANY_COMMENT
  KEYWORD_MATCH

  @@schema("app_quiksocial")
}

enum AutoReplyMode {
  TEMPLATE
  AI

  @@schema("app_quiksocial")
}

enum AutoReplyKeywordMatch {
  ANY
  ALL

  @@schema("app_quiksocial")
}

enum AutoReplyLogStatus {
  PENDING
  SENT
  FAILED
  SKIPPED

  @@schema("app_quiksocial")
}

model AutoReplyRule {
  id               String                @id @default(cuid())
  orgId            String
  brandId          String
  socialAccountId  String
  name             String
  triggerType      AutoReplyTriggerType
  replyMode        AutoReplyMode
  isActive         Boolean               @default(true)
  priority         Int                   @default(0)
  templateBody     String?
  keywords         String[]              @default([])
  keywordMatch     AutoReplyKeywordMatch @default(ANY)
  caseSensitive    Boolean               @default(false)
  toneGuidance     String?
  cooldownMinutes  Int                   @default(0)
  maxRepliesPerDay Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  createdBy        String?
  updatedBy        String?
  brand            Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount         @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  logs             AutoReplyLog[]

  @@index([orgId])
  @@index([orgId, brandId, isActive])
  @@index([orgId, socialAccountId, isActive])
  @@index([orgId, brandId, isActive, priority(sort: Desc)])
  @@schema("app_quiksocial")
}

model AutoReplyPostControl {
  id               String   @id @default(cuid())
  orgId            String
  postId           String   @unique
