model CnPurchaseOrder {
  id                   String    @id @default(cuid())
  orgId                String
  poNumber             String
  projectId            String
  vendorId             String
  indentId             String?
  rfqId                String?
  poDate               DateTime
  deliveryDate         DateTime?
  deliveryLocationId   String?
  /// Free-text delivery/site address â€” snapshot at PO create time so
  /// later edits to the project master don't retroactively change a
  /// PO that was already sent to a vendor.
  deliveryAddress      String?
  subtotal             Decimal   @db.Decimal(18, 2)
  taxAmount            Decimal   @db.Decimal(18, 2)
  totalAmount          Decimal   @db.Decimal(18, 2)
  /// Separated finance fields â€” the existing `subtotal` stores the
  /// material-value-ex-GST. Freight is priced alongside but kept
  /// separately so GST-on-freight and freight-less reports work.
  freightCharges       Decimal?  @db.Decimal(18, 2)
  /// Extra header-level charges (non-freight) shown on the PDF line
  /// above the GST block.
  otherCharges         Decimal?  @db.Decimal(18, 2)
  /// Advance paid to the vendor at PO issue â€” deducted from the first
  /// invoice amount.
  advanceAmount        Decimal?  @db.Decimal(18, 2)
  /// GST breakdown. Exactly one of (IGST) or (CGST+SGST) is non-zero
  /// depending on whether the vendor state matches the buyer state.
  totalIGST            Decimal?  @db.Decimal(18, 2)
  totalCGST            Decimal?  @db.Decimal(18, 2)
  totalSGST            Decimal?  @db.Decimal(18, 2)
  /// Subject / "Supply For" line printed on the PDF.
  purpose              String?
  /// Buyer-side contact(s). Comma-separated when multiple.
  contactPerson        String?
  contactMobile        String?
  status               String    @default("draft")
  approvalId           String?
  approvalThresholdMet Boolean   @default(false)
  paymentTermsDays     Int?
  termsConditionId     String?
  /// Snapshot of the T&C body at PO create time so later edits to the
  /// template master don't change what the vendor agreed to.
  termsAndConditions   String?
  remarks              String?
  isUrgentLocal        Boolean   @default(false)
  urgentLocalReason    String?
  /// Manual closure metadata â€” set when the user closes a PO via the
  /// detail-page "Close PO" action (typically because the delivery
  /// date passed without a complete GRN). `closeReason` is required
  /// at close-time so the audit trail captures why each PO was killed.
  closedAt             DateTime?
  closedBy             String?
  closeReason          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String
  updatedBy            String

  project CnProject             @relation(fields: [projectId], references: [id])
  vendor  CnVendor              @relation(fields: [vendorId], references: [id])
  lines   CnPurchaseOrderLine[]
  grns    CnGoodsReceiptNote[]

  // --- grafted: cross-schema relations (Org/User) ---
  org                Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@unique([orgId, poNumber])
  @@index([orgId])
  @@index([projectId])
  @@index([vendorId])
  @@index([status])
  // Composite indexes â€” match `ORDER BY poDate DESC` in listPOs. Vendor
  // composite covers the "POs from this vendor" drill-down.
  @@index([orgId, status, poDate(sort: Desc)])
  @@index([orgId, projectId, poDate(sort: Desc)])
  @@index([orgId, vendorId, poDate(sort: Desc)])
  @@map("Purchase_orders")
  @@schema("app_quikinfra")
}

model CnPurchaseOrderLine {
