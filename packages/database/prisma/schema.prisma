}

// ============================================================================
// Custom Fields (a.k.a. Customer Fields) — see FRD "Customer Fields" v2.
// Two-tier scope: scope="global" (org-wide, projectId NULL) or scope="space"
// (one project). Values live in QtIssueFieldValue with typed columns so the
// backlog filter can index by value (NFR-02). Name/key uniqueness within a
// scope is enforced in the service layer (case-insensitive — FRD §5.1).
// ============================================================================

model QtCustomField {
  id           String                @id @default(cuid())
  orgId        String
  scope        String                @default("space") // "global" | "space"
  projectId    String? // NULL when scope = "global"
  name         String
  key          String // immutable, generated from name (e.g. "customer_tier")
  type         String // SHORT_TEXT | LONG_TEXT | NUMBER | DATE | DROPDOWN_SINGLE | DROPDOWN_MULTI | CHECKBOX | URL | USER_PICKER | LABELS
  description  String?
  icon         String? // optional emoji icon (JPD field editor). TODO(integration): sign-off before Neon.
  status       String                @default("active") // "active" | "archived"
  isRequired   Boolean               @default(false)
  defaultValue Json? // type-dependent default (string | number | bool | string[])
  placeholder  String?
  helpText     String?
  position     Int                   @default(0)
  isDeleted    Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  createdBy    String?
  updatedBy    String?
  org          Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      QtProject?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  options      QtCustomFieldOption[]
  values       QtIssueFieldValue[]
  ideaValues   QtIdeaFieldValue[]
  audits       QtCustomFieldAudit[]

  @@unique([projectId, key])
  @@index([orgId, scope, status])
  @@index([projectId, status])
  @@schema("app_quiktrack")
}

model QtCustomFieldOption {
  id        String        @id @default(cuid())
  fieldId   String
  label     String
  value     String // stored value (slug); kept stable across label renames
  position  Int           @default(0)
  isActive  Boolean       @default(true)
  weight    Int? // TODO(integration): discovery weighted multi-select — 0–5 strategic weight per option (None..Highest). Additive, nullable; needs owner sign-off before Neon.
  color     String? // TODO(integration): discovery per-option color (hex, e.g. Theme/Roadmap chips). Additive, nullable; needs owner sign-off before Neon.
  icon      String? // TODO(integration): discovery per-option icon/emoji (Theme/Roadmap). Additive, nullable; needs owner sign-off before Neon.
  highlight Boolean       @default(false) // TODO(integration): discovery "Highlight ideas with this color" — tint the row bg. Additive, default false; needs owner sign-off before Neon.
  createdAt DateTime      @default(now())
  field     QtCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, isActive])
  @@schema("app_quiktrack")
}

model QtIssueFieldValue {
  id           String        @id @default(cuid())
  orgId        String
  issueId      String
  fieldId      String
  valueText    String? // SHORT_TEXT, LONG_TEXT, URL, DROPDOWN_SINGLE, USER_PICKER
  valueNumber  Float? // NUMBER
  valueDate    DateTime? // DATE
  valueBoolean Boolean? // CHECKBOX
  valueJson    Json? // DROPDOWN_MULTI, LABELS (string[])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdBy    String?
  updatedBy    String?
  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  issue        QtIssue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  field        QtCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([issueId, fieldId])
  @@index([fieldId, valueText])
  @@index([fieldId, valueNumber])
  @@index([fieldId, valueDate])
  @@index([fieldId, valueBoolean])
  @@index([orgId])
  @@schema("app_quiktrack")
}

model QtCustomFieldAudit {
  id         String         @id @default(cuid())
  orgId      String
  fieldId    String?
  action     String // created | updated | archived | restored | deleted
  actorId    String?
  oldValue   Json?
  newValue   Json?
  occurredAt DateTime       @default(now())
  org        Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  field      QtCustomField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@index([orgId, occurredAt])
  @@index([fieldId])
  @@schema("app_quiktrack")
}

// ═══════════════════ QuikTrack — Product Discovery ═══════════════════════
// Dedicated Idea models for the "discovery" project template (a Jira Product
// Discovery clone). Purpose-built and intentionally SEPARATE from QtIssue.
// Scoring/Theme/Roadmap/Score fields reuse the shared QtCustomField definitions
// via QtIdeaFieldValue (a parallel of QtIssueFieldValue). orgId is a scalar
// (no Org relation) — cascade flows Org → QtProject → these rows.
//
// TODO(integration): PENDING integration-owner sign-off. Migration lands
// separately from app code (idempotent raw SQL), per apps/quiktrack/CLAUDE.md.

/// Discovery idea funnel status. Per-project, ordered. Mirrors the real JPD
/// template workflow (Parking Lot → Discovery → Ready for Delivery → Delivery
/// → Impact → Archived). Separate from QtIssueStatus by design.
model QtIdeaStatus {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  color      String    @default("#94a3b8")
  /// Coarse bucket for roll-ups: PARKING_LOT | DISCOVERY | READY | DELIVERY | IMPACT | ARCHIVED
  category   String    @default("DISCOVERY")
  orderIndex Int       @default(0)
  isHidden   Boolean   @default(false)
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  ideas      QtIdea[]
  project    QtProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, orderIndex])
  @@schema("app_quiktrack")
}

/// The primary work item of a discovery project. Roadmap (Now/Next/Later/Won't
/// do), Theme, Impact, Effort, Reach, Confidence and the computed Score all live
/// as QtCustomField values (QtIdeaFieldValue) so admins can add their own fields
/// exactly like the seeded ones. Score is recomputed server-side on every write.
model QtIdea {
  id           String             @id @default(cuid())
  orgId        String
  projectId    String
  key          String
  title        String
  description  String?
  statusId     String
  assigneeId   String?
  reporterId   String?
  archivedFlag Boolean            @default(false)
  orderIndex   Int                @default(0)
  isDeleted    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    String?
  updatedBy    String?
  project      QtProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       QtIdeaStatus       @relation(fields: [statusId], references: [id])
  fieldValues  QtIdeaFieldValue[]
  comments     QtIdeaComment[]
  insights     QtIdeaInsight[]
  deliveries   QtIdeaDelivery[]
  attachments  QtIdeaAttachment[]
  links        QtIdeaLink[]

  @@unique([projectId, key])
  @@index([orgId])
  @@index([projectId, statusId])
  @@index([projectId, archivedFlag])
  @@index([assigneeId])
  @@schema("app_quiktrack")
}

/// Typed value of a QtCustomField on an idea. Parallel to QtIssueFieldValue.
model QtIdeaFieldValue {
  id           String        @id @default(cuid())
  orgId        String
  ideaId       String
  fieldId      String
  valueText    String?
  valueNumber  Float?
  valueDate    DateTime?
  valueBoolean Boolean?
  valueJson    Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdBy    String?
  updatedBy    String?
  idea         QtIdea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  field        QtCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([ideaId, fieldId])
  @@index([fieldId, valueText])
  @@index([fieldId, valueNumber])
  @@index([orgId])
  @@schema("app_quiktrack")
}

/// A saved lens over a project's ideas. v1 ships one Table view per project;
/// board/timeline/matrix are later phases and share this model (`type`).
model QtIdeaView {
  id         String    @id @default(cuid())
  orgId      String
  projectId  String
  name       String
  /// table | board | timeline | matrix
  type       String    @default("table")
  /// Presentation config: { columns[], columnOrder[], hiddenColumns[], groupBy,
  /// sort[], filters[], axisBindings } — shape validated in lib/validation.
  config     Json?
  /// shared | private
  visibility String    @default("shared")
  ownerId    String?
  orderIndex Int       @default(0)
  isDefault  Boolean   @default(false)
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  project    QtProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, orderIndex])
  @@schema("app_quiktrack")
}

/// A comment on an idea (JPD "Comments" tab). Threaded via optional parentId.
/// TODO(integration): PENDING integration-owner sign-off before this migration
/// lands on the shared/Neon DB.
model QtIdeaComment {
  id        String          @id @default(cuid())
  orgId     String
  ideaId    String
  parentId  String?
  body      String
  isDeleted Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  createdBy String?
  idea      QtIdea                  @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  parent    QtIdeaComment?          @relation("QtIdeaCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   QtIdeaComment[]         @relation("QtIdeaCommentReplies")
  reactions QtIdeaCommentReaction[]

  @@index([ideaId, createdAt])
  @@index([orgId])
  @@schema("app_quiktrack")
}

/// An emoji reaction on an idea comment. One row per (comment, user, emoji);
/// toggled on/off. TODO(integration): PENDING integration-owner sign-off.
model QtIdeaCommentReaction {
  id        String        @id @default(cuid())
  orgId     String
  commentId String
  emoji     String
  userId    String
  createdAt DateTime      @default(now())
  comment   QtIdeaComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@schema("app_quiktrack")
}

/// A research insight attached to an idea (JPD "Insights" tab): a snippet of
/// evidence with an optional source URL (rendered as a link-preview card), an
/// Impact rating (0–5), and freeform labels. TODO(integration): PENDING
/// integration-owner sign-off before this migration lands on the shared/Neon DB.
model QtIdeaInsight {
  id        String   @id @default(cuid())
  orgId     String
  ideaId    String
  body      String
  url       String?
  impact    Int      @default(0)
  labels    Json? // string[]
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  idea      QtIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId, createdAt])
  @@index([orgId])
  @@schema("app_quiktrack")
}

/// Delivery link between a discovery idea and a QtIssue (work item). The issue
/// may live in ANOTHER project (JPD "Delivery" tab tracks delivery work across
/// spaces). No FK to QtIssue (cross-project + soft-delete tolerant); the issueId
/// is resolved at read time. TODO(integration): PENDING integration-owner sign-off.
model QtIdeaDelivery {
  id        String   @id @default(cuid())
  orgId     String
  ideaId    String
  issueId   String
  createdAt DateTime @default(now())
  createdBy String?
  idea      QtIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, issueId])
  @@index([ideaId])
  @@index([issueId])
  @@index([orgId])
  @@schema("app_quiktrack")
}

// TODO(integration): discovery view-level comments (JPD "All ideas" About/
// Comments drawer). Additive; needs owner sign-off before Neon.
model QtIdeaViewComment {
  id        String   @id @default(cuid())
  orgId     String
  viewId    String
  body      String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([viewId, createdAt])
  @@index([orgId])
  @@schema("app_quiktrack")
}

// TODO(integration): discovery idea attachments. Additive; owner sign-off before Neon.
model QtIdeaAttachment {
  id        String   @id @default(cuid())
  orgId     String
  ideaId    String
  fileName  String
  url       String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  createdBy String?
  idea      QtIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId, createdAt])
  @@index([orgId])
  @@schema("app_quiktrack")
}

// TODO(integration): discovery idea "Linked work items" (JPD) — linkType + a
// cross-project QtIssue reference (no FK; resolved at read time). Additive.
model QtIdeaLink {
  id        String   @id @default(cuid())
  orgId     String
  ideaId    String
  issueId   String
  linkType  String   @default("relates to")
  createdAt DateTime @default(now())
  createdBy String?
  idea      QtIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, issueId, linkType])
  @@index([ideaId])
  @@index([orgId])
  @@schema("app_quiktrack")
}

