/// ─────────────────────────────────────────────────────────────────────────
/// Centralized audit trail (Phase 1: KPI). One AuditEvent per business action,
/// with field-level diffs stored as AuditChange child rows (only changed
/// fields). Designed to scale to millions of rows and serve entity timelines,
/// user-activity history, and compliance/forensic queries. Written via the
/// reusable audit service (apps/quikscale/lib/audit). Actor name is
/// denormalized to preserve the name AS IT WAS at the time of the event.
model AuditEvent {
  id          String        @id @default(cuid())
  orgId       String
  teamId      String?
  entityType  String // "KPI" | "Priority" | "Goal" | "OPSPlan" | ...
  entityId    String
  action      String // CREATE|UPDATE|DELETE|ARCHIVE|RESTORE|STATUS_CHANGE|ASSIGNMENT_CHANGE|OWNERSHIP_CHANGE|PERMISSION_CHANGE|WEEKLY_UPDATE|BULK_UPDATE|COMMENT
  actorUserId String
  actorName   String // denormalized name at time of event
  source      String        @default("web") // web|api|system|import
  ipAddress   String?
  userAgent   String?
  reason      String?
  snapshot    Json? // optional full post-state for forensics
  createdAt   DateTime      @default(now())
  changes     AuditChange[]
  org         Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType, entityId, createdAt(sort: Desc)])
  @@index([orgId, actorUserId, createdAt(sort: Desc)])
  @@index([orgId, teamId, createdAt(sort: Desc)])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, action, createdAt(sort: Desc)])
  @@schema("app_quikscale")
}

/// One row per changed field on an AuditEvent. oldValue/newValue are JSONB so
/// scalars, arrays (ownerIds), and JSON blobs (weeklyTargets) are all captured.
model AuditChange {
  id           String     @id @default(cuid())
  auditEventId String
  fieldName    String
  oldValue     Json?
  newValue     Json?
  event        AuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Cascade)

  @@index([auditEventId])
  @@index([fieldName])
  @@schema("app_quikscale")
}

/// Per-user read state for an entity's audit timeline — a high-water mark.
/// One row per (user, entity); `lastReadAt` is the moment the user last opened
/// that entity's Change History. Unread = AuditEvents for the entity created
/// after lastReadAt AND not authored by the user (editors implicitly read
/// their own actions). Scales to millions of events: one row per user per
/// viewed entity, never per event.
model AuditEventRead {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  entityType String
  entityId   String
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([orgId, userId, entityType])
  @@schema("app_quikscale")
}

