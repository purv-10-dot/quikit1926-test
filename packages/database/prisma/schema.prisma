  @@index([orgId])
  @@schema("app_quiktrack")
}

model QtTeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
