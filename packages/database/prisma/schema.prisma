  sortOrder   Int     @default(0)
  isGroup     Boolean @default(false)

  // Display
  displayName String
  description String  @default("")
  unit        String? // null for groups

  // Imported (frozen once lock applied)
  tenderQty   Decimal? @db.Decimal(18, 4)
  rate        Decimal? @db.Decimal(18, 2)
