// ── Phase 9 — Quality ───────────────────────────────────────────────────

model CnQCInspection {
  id               String   @id @default(cuid())
  tenantId         String
  inspectionNumber String
  grnId            String?
  projectId        String?
  inspectorId      String
  inspectionDate   DateTime
  decision         String   @default("pending") // pending | accepted | rejected | conditional
  remarks          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grn     CnGoodsReceiptNote? @relation(fields: [grnId], references: [id])
  project CnProject?          @relation(fields: [projectId], references: [id])
  defects CnQCDefect[]

  @@unique([tenantId, inspectionNumber])
  @@index([tenantId])
  @@index([grnId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnQCDefect {
  id           String   @id @default(cuid())
  inspectionId String
  itemId       String?
  defectType   String
  severity     String   @default("minor") // minor | major | critical
  quantity     Decimal? @db.Decimal(18, 4)
  remarks      String?

  inspection CnQCInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item       CnItem?        @relation(fields: [itemId], references: [id])

  @@index([inspectionId])
  @@schema("app_quikconstruction")
}

// ── Phase 10 — Safety ───────────────────────────────────────────────────

model CnSafetyIncident {
  id             String    @id @default(cuid())
  tenantId       String
  projectId      String?
  incidentNumber String
  incidentDate   DateTime
  category       String // injury | near_miss | property_damage | environmental | other
  severity       String    @default("low") // low | medium | high | critical
  title          String
  description    String?
  reportedBy     String
  status         String    @default("open") // open | investigating | resolved | closed
  resolvedAt     DateTime?
  resolvedBy     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project CnProject? @relation(fields: [projectId], references: [id])

  @@unique([tenantId, incidentNumber])
  @@index([tenantId])
  @@index([status])
  @@index([deletedAt])
