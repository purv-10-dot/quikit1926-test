/// Per-user additive permission grants — applied ON TOP of the user's role
/// grants. Used by admins to extend an individual user's access without
/// changing the role for everyone on it.
model UserPermissionExtra {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  resource  String
  action    String
  grantedBy String?
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, resource, action])
  @@index([userId, orgId])
  @@schema("app_quikscale")
}

/// Per-user, per-table column preferences (sort / hidden / frozen / widths)
/// for QuikScale list pages. Lives inside app_quikscale (NOT auth.User) so
/// adding a new table to the app doesn't require touching the shared User
/// model. Migrates the legacy User.kpiFrozenCol / User.priorityFrozenCol /
/// User.wwwFrozenCol (and matching) columns — those stay in place for
/// rollback safety but are no longer read by the app.
model UserTablePreference {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  tableName  String
  frozenCol  String?
  hiddenCols String?
  sort       String?
  colWidths  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, tableName])
  @@index([userId, orgId])
  @@schema("app_quikscale")
}

model Client {
  id              String                @id @default(cuid())
  orgId           String
