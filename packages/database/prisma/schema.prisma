// ─── EMPLOYEE ───────────────────────────────────────────

model Employee {
  id           String @id @default(cuid())
  orgId     String
  // Central QuikIT SSO link: the central auth `User.id` this employee maps to.
  // Populated on first SSO login by matching workEmail (see resolveEmployeeByAuthUser
  // in lib/with-auth.ts). Null until linked. RBAC still keys on Employee.id; this
  // only bridges the central identity → the HRMS employee.
  authUserId   String?
  employeeCode String

  // Primary Info
  firstName           String
  middleName          String?
  lastName            String
  displayName         String?
  gender              Gender?
  dateOfBirth         DateTime?
  bloodGroup          BloodGroup?
  maritalStatus       MaritalStatus?
  nationality         String?
  isHandicapped       Boolean        @default(false)
  isSeniorCitizen     Boolean        @default(false)

  // Per-employee statutory applicability overrides. Default `true` for all —
  // payroll-compute respects these flags and skips the corresponding block
  // when `false`. Set to `false` only for legitimate exclusions:
  //   epfApplicable=false → "Excluded Employee" (joined > ₹15k, never an EPF member); contractors; expats
  //   esiApplicable=false → contractors / consultants on non-salary engagement
  //   ptApplicable=false  → expats / non-residents; some PwD exemptions per state
  epfApplicable       Boolean        @default(true)
  esiApplicable       Boolean        @default(true)
  ptApplicable        Boolean        @default(true)

  // EPF rate override. Null = use org default from EPFConfig.
  // Values: "TwelvePercentActual" | "TwelvePercentRestricted"
  epfContributionRate String?
  profilePhoto        String?
  coverImage          String?
  bio                 String?

  // Auth — bcrypt hash of the login password. Null = login not yet provisioned.
  passwordHash String?
  // Forces a password change on next login (e.g. admin-set temporary password).
  mustChangePassword Boolean   @default(false)
  // When the admin-set temporary password stops working (null = no temp pw).
  tempPasswordExpiresAt DateTime?
  // Account lockout — 3 wrong passwords locks for 1 hour. Reset on any
  // successful login or admin password reset.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Contact
  personalEmail String?
  workEmail     String
  personalPhone String?
  workPhone     String?
  linkedinUrl   String?
  githubUrl     String?
  portfolioUrl  String?

  // Address (JSON for flexibility)
  currentAddress   Json?
  permanentAddress Json?

  // Emergency Contacts (JSON array)
  emergencyContacts Json?

  // Professional
  jobTitle             String?
  departmentId         String?
  teamId               String?
  designationId        String?
  gradeId              String?
  reportingManagerId   String?
  dottedLineManagerId  String?
  employmentType       EmploymentType @default(FullTime)
  workerType           WorkerType     @default(Permanent)
  workLocation         WorkLocation   @default(Office)
  officeLocationId     String?
  dateOfJoining        DateTime
  tentativeJoiningDate DateTime?      @db.Date
  confirmationDate     DateTime?
  probationEndDate     DateTime?
  noticePeriodDays     Int            @default(0)
  lastWorkingDate      DateTime?
  previousExperience   Int            @default(0) // months
  sourceOfHire         SourceOfHire?
  referredById         String?

  // Candidate stage fields
  currentSalary        Decimal? @db.Decimal(15, 2)
  expectedSalary       Decimal? @db.Decimal(15, 2)
  offerLetterUrl       String?
  highestQualification String?
  skillSet             String?
  additionalInfo       String?

  // Identity & Financial (JSON arrays for multi-value)
  identityDocuments       Json?
  bankAccounts            Json?
  panNumber               String?
  aadhaarNumber           String?
  taxIdentificationNumber String?
  uanNumber               String?
  pfAccountNumber         String?
  esiNumber               String?

  // Multi-entity + cross-border
  legalEntityId        String?
  taxResidencyStatus   TaxResidencyStatus @default(Resident)
  payFrequencyOverride PayFrequency? // override tenant default per employee

  // Skills (JSON arrays)
  skills         Json?
  certifications Json?
  languages      Json?

  // Education & Experience (JSON arrays)
  educations      Json?
  pastExperiences Json?

  // Custom Fields
  customFields Json?

  // System
  status       EmployeeStatus @default(Active)
  inviteStatus InviteStatus   @default(NotInvited)
  // ── Central QuikIT membership sync (lib/rbac/central-sync.ts) ──
  // Last central membership role observed by sync ("member" | "org_admin" | ...).
  // Lets sync act only on central role TRANSITIONS, so locally-made HRMS role
  // changes are never clobbered by a re-sync of an unchanged central role.
  centralRole          String?
  // Set when sync deactivated this employee because their central org
  // membership / app access was removed. Cleared (and status restored to
  // Active) if central access comes back. Distinguishes sync-driven
  // deactivation from a deliberate local one, which sync must not undo.
  centralDeactivatedAt DateTime?
  lastLoginAt  DateTime?
  // Single active session: holds the jti of the currently valid session token.
  // A new login overwrites it, invalidating any older token (and its tab).
  // Legacy custom-auth field — unused once central QuikIT SSO is the sole login.
  activeSessionId String?

  // Audit
  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  department        Department?     @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  team              HrmsTeam?           @relation("EmployeeTeam", fields: [teamId], references: [id])
  designation       Designation?    @relation("EmployeeDesignation", fields: [designationId], references: [id])
  grade             Grade?          @relation("EmployeeGrade", fields: [gradeId], references: [id])
  officeLocation    OfficeLocation? @relation("EmployeeOfficeLocation", fields: [officeLocationId], references: [id])
  reportingManager  Employee?       @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  directReports     Employee[]      @relation("ReportingManager")
  dottedLineManager Employee?       @relation("DottedLineManager", fields: [dottedLineManagerId], references: [id])
  dottedLineReports Employee[]      @relation("DottedLineManager")
  referredBy        Employee?       @relation("Referral", fields: [referredById], references: [id])
  referrals         Employee[]      @relation("Referral")

  // Reverse relations for org structure
  headOfDepartments Department[] @relation("DepartmentHead")
  leadOfTeams       HrmsTeam[]       @relation("TeamLead")

  // Phase 2 relations
  attendanceRecords AttendanceRecord[]
  shiftAssignments  ShiftAssignment[]
  rosterEntries     RosterEntry[]
  /// Default weekly off days, e.g. ["Saturday","Sunday"]. Seeds the duty roster.
  weeklyOffDays     Json?
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  leaveApprovals    LeaveApproval[]    @relation("LeaveApprover")
  wfhRequests       WfhRequest[]
  wfhApprovals      WfhApproval[]      @relation("WfhApprover")
  wfhQuotaGroupId   String?
  wfhQuotaGroup     WfhQuotaGroup?     @relation("WfhQuotaGroupMembers", fields: [wfhQuotaGroupId], references: [id])

  // Phase 3 relations
  expenseClaims ExpenseClaim[]

  // Phase 4 relations
  goals            HrmsGoal[]
  goalCheckIns     GoalCheckIn[]        @relation("CheckInUpdater")
  appraisals       EmployeeAppraisal[]
  feedbackGiven    ContinuousFeedback[] @relation("FeedbackFrom")
  feedbackReceived ContinuousFeedback[] @relation("FeedbackTo")
  pips             PIP[]                @relation("PIPEmployee")
  pipsInitiated    PIP[]                @relation("PIPInitiator")

  // Phase 5 relations
  requisitionsCreated     JobRequisition[]      @relation("RequisitionCreator")
  requisitionsManaged     JobRequisition[]      @relation("HiringManager")
  requisitionsRecruited   JobRequisition[]      @relation("Recruiter")
  requisitionsRaised      JobRequisition[]      @relation("RequisitionRaiser")
  requisitionApprovals    RequisitionApproval[] @relation("RequisitionApprover")
  interviewsAsInterviewer Interview[]           @relation("Interviewer")
  candidateReferrals      Candidate[]           @relation("CandidateReferrer")

  // Phase 6 relations
  socialPosts          SocialPost[]
  postComments         PostComment[]
  announcements        Announcement[]   @relation("AnnouncementAuthor")
  surveyResponses      HrmsSurveyResponse[]
  recognitionsGiven    Recognition[]    @relation("RecognitionFrom")
  recognitionsReceived Recognition[]    @relation("RecognitionTo")

  // Phase 7 relations
  notifications HrmsNotification[]

  // Ticket / Help Desk relations
  ticketsRaised    Ticket[]         @relation("TicketRaiser")
  ticketsAssigned  Ticket[]         @relation("TicketAssignee")
  ticketComments   TicketComment[]
  ticketActivities TicketActivity[]

  // RBAC v2 — quikscale mirror
  appRoles            HrmsUserAppRole[]
  permissionOverrides HrmsUserPermissionExtra[]

  @@unique([orgId, employeeCode])
  // One Employee per central user per tenant — stops the first-login race from
  // creating duplicate records. authUserId is nullable (manual employees), and
  // Postgres treats NULLs as distinct, so manual records are unaffected.
  @@unique([orgId, authUserId])
  @@index([orgId, workEmail])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, departmentId])
  @@index([orgId, status])
  @@index([orgId, reportingManagerId])
  // Performance: composite indexes for common query patterns
  @@index([orgId, deletedAt, status])
  @@index([orgId, deletedAt, departmentId, status])
  @@index([orgId, dateOfJoining])
  @@index([orgId, lastWorkingDate])
  @@index([orgId, deletedAt, employmentType])
  @@schema("app_quikhrms")
}

