// ===== app_quikcrm RBAC models (authored to match app_quikcrm.* tables + apps/Quikcrm rbac code) =====
// These map to the app_quikcrm RBAC tables (AppRole/RolePermission/RoleNavigation/
// UserAppRole/UserPermissionExtra). They are Crm-prefixed because the unprefixed
// model names are already taken by app_quikscale. Cross-schema FKs (appId->quikit.App,
// orgId->quikit.Org, userId->auth.User) are kept as scalars (no @relation) to avoid
// back-relation fields on shared models — matching the rest of the restored block.
model CrmAppRole {
  id          String              @id @default(cuid())
  orgId       String
  appId       String
  name        String
  description String?
  isSystem    Boolean             @default(false)
  isDefault   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   String?
  permissions CrmRolePermission[]
  navigations CrmRoleNavigation[]
  members     CrmUserAppRole[]

  @@unique([orgId, appId, name])
  @@index([orgId, appId])
  @@map("AppRole")
  @@schema("app_quikcrm")
}

model CrmRolePermission {
  id       String     @id @default(cuid())
  roleId   String
  resource String
  action   String
  role     CrmAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("RolePermission")
  @@schema("app_quikcrm")
}

model CrmRoleNavigation {
  id     String     @id @default(cuid())
  roleId String
  navKey String
  role   CrmAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, navKey])
  @@index([roleId])
  @@map("RoleNavigation")
  @@schema("app_quikcrm")
}

model CrmUserAppRole {
  id         String     @id @default(cuid())
  userId     String
  orgId      String
  roleId     String
  assignedAt DateTime   @default(now())
  assignedBy String?
  role       CrmAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, roleId])
  @@index([roleId])
  @@index([userId, orgId])
  @@map("UserAppRole")
  @@schema("app_quikcrm")
}

model CrmUserPermissionExtra {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  resource  String
  action    String
  grantedBy String?
  createdAt DateTime @default(now())

  @@unique([orgId, userId, resource, action])
  @@index([userId, orgId])
  @@map("UserPermissionExtra")
  @@schema("app_quikcrm")
}


