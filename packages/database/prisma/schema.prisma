// One row per (year, month, natureOfPayment). System-owned — refreshed
// every time payroll runs for that period. Never directly edited by users.
model TdsLiabilityPeriod {
  id              String   @id @default(cuid())
  orgId        String

  periodYear      Int
  periodMonth     Int                  // 1-12
  natureOfPayment String   @default("92B")

  totalDeducted   Decimal  @default(0) @db.Decimal(15, 2)
  totalAllocated  Decimal  @default(0) @db.Decimal(15, 2)
  employeeCount   Int      @default(0)
  payslipIds      Json     @default("[]")

  dueDate         DateTime @db.Date    // 7th of (periodMonth+1)
  status          TdsPeriodStatus @default(Pending)
  lastComputedAt  DateTime @default(now())

  allocations     TdsChallanAllocation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, periodYear, periodMonth, natureOfPayment])
  @@index([orgId, status])
  @@index([orgId, periodYear, periodMonth])
  @@schema("app_quikhrms")
}

// One row per challan deposited. Created by finance after bank payment.
model TdsChallan {
  id                   String   @id @default(cuid())
  orgId             String

  cin                  String                // unique business key per tenant
  bsrCode              String                // 7-digit bank branch
  challanSerial        String
  depositDate          DateTime @db.Date
  assessmentYear       String                // "2027-28" — derived from depositDate
  natureOfPayment      String   @default("92B")
  tanNumber            String                // snapshot from CompanySettings at create time

  basicTax             Decimal  @db.Decimal(15, 2)
  surcharge            Decimal  @default(0) @db.Decimal(15, 2)
  educationCess        Decimal  @default(0) @db.Decimal(15, 2)
  interest             Decimal  @default(0) @db.Decimal(15, 2)
  lateFee              Decimal  @default(0) @db.Decimal(15, 2)
  others               Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount          Decimal  @db.Decimal(15, 2)

  paymentMode          TdsPaymentMode
  bankName             String?
  acknowledgmentNumber String?

  // Denormalized — updated transactionally with allocations.
  remainingAmount      Decimal  @db.Decimal(15, 2)
  status               TdsChallanStatus @default(Recorded)

  allocations          TdsChallanAllocation[]

  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  @@unique([orgId, cin])
  @@index([orgId, depositDate])
  @@index([orgId, assessmentYear])
  @@index([orgId, status])
  @@schema("app_quikhrms")
}

// The bridge: how a challan's amount is split across liability periods.
model TdsChallanAllocation {
  id                String   @id @default(cuid())
  orgId          String
  challanId         String
  liabilityPeriodId String

  allocatedAmount   Decimal  @db.Decimal(15, 2)
  isAutoAllocated   Boolean  @default(true)
  allocatedBy       String?
  allocatedAt       DateTime @default(now())

  challan TdsChallan         @relation(fields: [challanId], references: [id], onDelete: Cascade)
  period  TdsLiabilityPeriod @relation(fields: [liabilityPeriodId], references: [id])

  @@unique([challanId, liabilityPeriodId])
  @@index([orgId, challanId])
  @@index([orgId, liabilityPeriodId])
  @@schema("app_quikhrms")
}

// User invitation: admin invites a person by email; they accept via a
// tokenized link, set a password, and an Employee account is activated.
model Invitation {
  id            String           @id @default(cuid())
  orgId      String

  // Invitee details (prefilled on the accept page)
  email         String
  firstName     String?
  lastName      String?
  roleIds       String[]
  departmentId  String?
  designationId String?
  managerId     String?

  // Token & lifecycle
  token         String           @unique // store a hash of the emailed token; never return raw
  // Central QuikIT accept-flow token (OrgMember.invitationToken) for brand-new
  // native users. Persisted so resend can rebuild the same /invitations/accept
  // link without re-provisioning. Null for existing/SSO users (they get /login).
  centralInviteToken String?
  expiresAt     DateTime
  status        InvitationStatus @default(Pending)

  // Tracking
  invitedBy     String           // admin Employee id
  acceptedAt    DateTime?
  employeeId    String?          // linked employee once accepted

  // Audit
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?        // soft delete (revoke)

  @@index([orgId, status])
  @@index([orgId, email])
  @@schema("app_quikhrms")
}

// Long-lived refresh token. The raw token is sent to the client; only its
// SHA-256 hash is stored. Rotation chain: when a refresh is used, it's marked
// `replacedById = next.id`. Presenting an already-replaced or revoked refresh
// is a theft signal — the whole `familyId` is revoked.

// NOTE: legacy custom-auth models `BackupCode` (2FA backup codes) and
// `OtpChallenge` (login OTP) were removed during the QuikIT central-SSO
// migration — HRMS no longer has its own login/2FA. They had zero code
// references and no DB tables (schema-only drift). `RefreshToken` was also
// removed (custom-auth refresh tokens, superseded by central SSO).
