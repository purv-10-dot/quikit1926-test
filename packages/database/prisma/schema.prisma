// ============================================================================
// QUIKCONSTRUCTION — Phase 3 (Procurement + Store)
// ============================================================================
// Vertical P2P slice: PR → PO → GRN → StockLedger → Material Issue.
// Approval workflow = simple status machine per document (no engine yet).
// Stock Ledger is the source of truth for inventory — every GRN/Issue writes
// a row inside the same transaction as the document itself.
// ============================================================================

model CnPurchaseRequisition {
  id            String    @id @default(cuid())
  tenantId      String
  prNumber      String
  projectId     String
  requestedById String
  requestDate   DateTime
  requiredDate  DateTime?
  purpose       String?
  status        String    @default("draft") // draft | submitted | approved | rejected | converted | cancelled

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project CnProject                   @relation(fields: [projectId], references: [id])
  lines   CnPurchaseRequisitionLine[]
  pos     CnPurchaseOrder[]

  @@unique([tenantId, prNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnPurchaseRequisitionLine {
  id              String   @id @default(cuid())
  prId            String
  itemId          String
  quantity        Decimal  @db.Decimal(18, 4)
  uomId           String
  estimatedRate   Decimal? @db.Decimal(18, 2)
  estimatedAmount Decimal? @db.Decimal(18, 2)
  specification   String?
  currentStock    Decimal? @db.Decimal(18, 4)
  remarks         String?

  pr   CnPurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  item CnItem                @relation(fields: [itemId], references: [id])
  uom  CnUOM                 @relation(fields: [uomId], references: [id])

  @@index([prId])
  @@index([itemId])
  @@schema("app_quikconstruction")
}

model CnPurchaseOrder {
  id                 String    @id @default(cuid())
  tenantId           String
  poNumber           String
  projectId          String
  vendorId           String
  prId               String?
  poDate             DateTime
  deliveryDate       DateTime?
  deliveryLocationId String?
  subtotal           Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount          Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal   @default(0) @db.Decimal(18, 2)
  status             String    @default("draft") // draft | sent | partially_received | fully_received | closed | cancelled
  paymentTermsDays   Int?
  termsConditionId   String?
  remarks            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project          CnProject              @relation(fields: [projectId], references: [id])
  vendor           CnVendor               @relation(fields: [vendorId], references: [id])
  pr               CnPurchaseRequisition? @relation(fields: [prId], references: [id])
  deliveryLocation CnLocation?            @relation(fields: [deliveryLocationId], references: [id])
  lines            CnPurchaseOrderLine[]
  grns             CnGoodsReceiptNote[]
  bills            CnVendorBill[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([vendorId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnPurchaseOrderLine {
  id           String    @id @default(cuid())
  poId         String
  itemId       String
  orderedQty   Decimal   @db.Decimal(18, 4)
  receivedQty  Decimal   @default(0) @db.Decimal(18, 4)
  pendingQty   Decimal   @db.Decimal(18, 4)
  unitRate     Decimal   @db.Decimal(18, 2)
  amount       Decimal   @db.Decimal(18, 2)
  gstRate      Decimal?  @db.Decimal(5, 2)
  taxAmount    Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount  Decimal   @db.Decimal(18, 2)
  uomId        String
  deliveryDate DateTime?
  remarks      String?

  po   CnPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item CnItem          @relation(fields: [itemId], references: [id])
  uom  CnUOM           @relation(fields: [uomId], references: [id])

  @@index([poId])
  @@index([itemId])
  @@schema("app_quikconstruction")
}

model CnGoodsReceiptNote {
  id                  String    @id @default(cuid())
  tenantId            String
  grnNumber           String
  poId                String
  projectId           String
  vendorId            String
  grnDate             DateTime
  locationId          String
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?
  challanNo           String?
  challanDate         DateTime?
  receivedById        String
  inspectedById       String?
  status              String    @default("draft") // draft | posted (posted = stock ledger written, immutable)
  remarks             String?
  postedAt            DateTime?
  postedBy            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  po            CnPurchaseOrder  @relation(fields: [poId], references: [id])
  project       CnProject        @relation(fields: [projectId], references: [id])
  vendor        CnVendor         @relation(fields: [vendorId], references: [id])
  location      CnLocation       @relation(fields: [locationId], references: [id])
  lines         CnGRNLine[]
  goodReturns   CnGoodReturn[]
  bill          CnVendorBill?
  qcInspections CnQCInspection[]

  @@unique([tenantId, grnNumber])
  @@index([tenantId])
  @@index([poId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnGRNLine {
  id            String  @id @default(cuid())
  grnId         String
  poLineId      String?
  itemId        String
  receivedQty   Decimal @db.Decimal(18, 4)
  acceptedQty   Decimal @db.Decimal(18, 4)
  rejectedQty   Decimal @default(0) @db.Decimal(18, 4)
  uomId         String
  unitRate      Decimal @db.Decimal(18, 2)
  amount        Decimal @db.Decimal(18, 2)
  qualityStatus String  @default("pending") // pending | accepted | rejected | conditional
  batchNo       String?
  remarks       String?

  grn  CnGoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item CnItem             @relation(fields: [itemId], references: [id])
  uom  CnUOM              @relation(fields: [uomId], references: [id])

  @@index([grnId])
  @@index([itemId])
  @@schema("app_quikconstruction")
}

model CnStockLedger {
  id                   String   @id @default(cuid())
  tenantId             String
  projectId            String
  locationId           String
  itemId               String
  transactionType      String // grn | issue | return_vendor | return_internal | transfer_out | transfer_in | reconciliation_adj | opening_balance
  transactionRefId     String
  transactionRefNumber String
  transactionDate      DateTime
  qtyIn                Decimal  @default(0) @db.Decimal(18, 4)
  qtyOut               Decimal  @default(0) @db.Decimal(18, 4)
  unitRate             Decimal  @db.Decimal(18, 2)
  amount               Decimal  @db.Decimal(18, 2)
  uomId                String

  createdAt DateTime @default(now())
  createdBy String

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  CnProject  @relation(fields: [projectId], references: [id])
  location CnLocation @relation(fields: [locationId], references: [id])
  item     CnItem     @relation(fields: [itemId], references: [id])
  uom      CnUOM      @relation(fields: [uomId], references: [id])

  @@index([tenantId])
  @@index([tenantId, projectId, locationId, itemId])
  @@index([itemId])
  @@index([transactionRefId])
  @@schema("app_quikconstruction")
}

model CnMaterialIssue {
  id          String   @id @default(cuid())
  tenantId    String
  issueNumber String
  projectId   String
  locationId  String
  issuedToId  String
  issuedById  String
  issueDate   DateTime
  purpose     String?
  status      String   @default("draft") // draft | posted

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?
  postedAt  DateTime?
  postedBy  String?

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         CnProject             @relation(fields: [projectId], references: [id])
  location        CnLocation            @relation(fields: [locationId], references: [id])
  lines           CnMaterialIssueLine[]
  internalReturns CnInternalReturn[]

  @@unique([tenantId, issueNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnMaterialIssueLine {
  id        String  @id @default(cuid())
  issueId   String
  itemId    String
  issuedQty Decimal @db.Decimal(18, 4)
  uomId     String
  unitRate  Decimal @db.Decimal(18, 2)
  amount    Decimal @db.Decimal(18, 2)
  remarks   String?

  issue CnMaterialIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  item  CnItem          @relation(fields: [itemId], references: [id])
  uom   CnUOM           @relation(fields: [uomId], references: [id])

  @@index([issueId])
  @@index([itemId])
  @@schema("app_quikconstruction")
}

// ============================================================================
// QUIKCONSTRUCTION — Phase 3b (extended procurement + store)
// ============================================================================
// Purchase Indent (PR → Indent → PO), RFQ (solicit quotes), Gate Pass (gate
// register), Returns (vendor + internal), Stock Transfer (paired ledger),
// Stock Reconciliation, Diesel Log.
// ============================================================================

model CnPurchaseIndent {
  id            String    @id @default(cuid())
  tenantId      String
  indentNumber  String
  prId          String?
  projectId     String
  requestedById String
  requestDate   DateTime
  requiredDate  DateTime?
  purpose       String?
  status        String    @default("draft") // draft | submitted | approved | converted | cancelled

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project CnProject              @relation(fields: [projectId], references: [id])
  lines   CnPurchaseIndentLine[]

  @@unique([tenantId, indentNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnPurchaseIndentLine {
  id            String   @id @default(cuid())
  indentId      String
  itemId        String
  quantity      Decimal  @db.Decimal(18, 4)
  uomId         String
  estimatedRate Decimal? @db.Decimal(18, 2)
  remarks       String?

  indent CnPurchaseIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  item   CnItem           @relation(fields: [itemId], references: [id])
  uom    CnUOM            @relation(fields: [uomId], references: [id])

  @@index([indentId])
  @@index([itemId])
  @@schema("app_quikconstruction")
}

model CnRFQ {
  id          String    @id @default(cuid())
  tenantId    String
  rfqNumber   String
  indentId    String?
  projectId   String
  rfqDate     DateTime
  closingDate DateTime?
  status      String    @default("draft") // draft | sent | quotations_received | awarded | cancelled
  remarks     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project CnProject     @relation(fields: [projectId], references: [id])
  lines   CnRFQLine[]
  vendors CnRFQVendor[]

  @@unique([tenantId, rfqNumber])
  @@index([tenantId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnRFQLine {
  id            String  @id @default(cuid())
  rfqId         String
  itemId        String
  quantity      Decimal @db.Decimal(18, 4)
  uomId         String
  specification String?

  rfq  CnRFQ  @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  item CnItem @relation(fields: [itemId], references: [id])
  uom  CnUOM  @relation(fields: [uomId], references: [id])

  @@index([rfqId])
  @@schema("app_quikconstruction")
}

model CnRFQVendor {
  id           String   @id @default(cuid())
  rfqId        String
  vendorId     String
  quotationRef String?
  totalAmount  Decimal? @db.Decimal(18, 2)
  isAwarded    Boolean  @default(false)

  rfq    CnRFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor CnVendor @relation(fields: [vendorId], references: [id])

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@schema("app_quikconstruction")
}

model CnGatePass {
  id              String   @id @default(cuid())
  tenantId        String
  gatePassNumber  String
  projectId       String
  locationId      String
  type            String // inward | outward | returnable | non_returnable
  referenceType   String? // grn | issue | return | transfer
  referenceId     String?
  referenceNumber String?
  vehicleNo       String?
  driverName      String?
  driverPhone     String?
  purpose         String?
  gatePassDate    DateTime
  status          String   @default("open") // open | closed | cancelled

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  CnProject  @relation(fields: [projectId], references: [id])
  location CnLocation @relation(fields: [locationId], references: [id])

  @@unique([tenantId, gatePassNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnGoodReturn {
  id           String    @id @default(cuid())
  tenantId     String
  returnNumber String
  grnId        String
  projectId    String
  vendorId     String
  locationId   String
  returnDate   DateTime
  reason       String?
  status       String    @default("draft") // draft | posted
  postedAt     DateTime?
  postedBy     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grn      CnGoodsReceiptNote @relation(fields: [grnId], references: [id])
  project  CnProject          @relation(fields: [projectId], references: [id])
  vendor   CnVendor           @relation(fields: [vendorId], references: [id])
  location CnLocation         @relation(fields: [locationId], references: [id])
  lines    CnGoodReturnLine[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([grnId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnGoodReturnLine {
  id        String  @id @default(cuid())
  returnId  String
  itemId    String
  returnQty Decimal @db.Decimal(18, 4)
  uomId     String
  unitRate  Decimal @db.Decimal(18, 2)
  amount    Decimal @db.Decimal(18, 2)
  remarks   String?

  return CnGoodReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item   CnItem       @relation(fields: [itemId], references: [id])
  uom    CnUOM        @relation(fields: [uomId], references: [id])

  @@index([returnId])
  @@schema("app_quikconstruction")
}

model CnInternalReturn {
  id           String    @id @default(cuid())
  tenantId     String
  returnNumber String
  issueId      String
  projectId    String
  locationId   String
  returnDate   DateTime
  returnedBy   String
  reason       String?
  status       String    @default("draft") // draft | posted
  postedAt     DateTime?
  postedBy     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issue    CnMaterialIssue        @relation(fields: [issueId], references: [id])
  project  CnProject              @relation(fields: [projectId], references: [id])
  location CnLocation             @relation(fields: [locationId], references: [id])
  lines    CnInternalReturnLine[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([issueId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnInternalReturnLine {
  id        String  @id @default(cuid())
  returnId  String
  itemId    String
  returnQty Decimal @db.Decimal(18, 4)
  uomId     String
  unitRate  Decimal @db.Decimal(18, 2)
  amount    Decimal @db.Decimal(18, 2)
  remarks   String?

  return CnInternalReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item   CnItem           @relation(fields: [itemId], references: [id])
  uom    CnUOM            @relation(fields: [uomId], references: [id])

  @@index([returnId])
  @@schema("app_quikconstruction")
}

model CnStockTransfer {
  id             String    @id @default(cuid())
  tenantId       String
  transferNumber String
  projectId      String
  fromLocationId String
  toLocationId   String
  transferDate   DateTime
  reason         String?
  status         String    @default("draft") // draft | in_transit | received (fully posted)
  inTransitAt    DateTime?
  receivedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      CnProject             @relation(fields: [projectId], references: [id])
  fromLocation CnLocation            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   CnLocation            @relation("TransferTo", fields: [toLocationId], references: [id])
  lines        CnStockTransferLine[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnStockTransferLine {
  id         String  @id @default(cuid())
  transferId String
  itemId     String
  quantity   Decimal @db.Decimal(18, 4)
  uomId      String
  unitRate   Decimal @db.Decimal(18, 2)
  amount     Decimal @db.Decimal(18, 2)
  remarks    String?

  transfer CnStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     CnItem          @relation(fields: [itemId], references: [id])
  uom      CnUOM           @relation(fields: [uomId], references: [id])

  @@index([transferId])
  @@schema("app_quikconstruction")
}

model CnStockReconciliation {
  id                   String    @id @default(cuid())
  tenantId             String
  reconciliationNumber String
  projectId            String
  locationId           String
  reconciliationDate   DateTime
  reason               String?
  status               String    @default("draft") // draft | posted
  postedAt             DateTime?
  postedBy             String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant   Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  CnProject                   @relation(fields: [projectId], references: [id])
  location CnLocation                  @relation(fields: [locationId], references: [id])
  lines    CnStockReconciliationLine[]

  @@unique([tenantId, reconciliationNumber])
  @@index([tenantId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnStockReconciliationLine {
  id               String  @id @default(cuid())
  reconciliationId String
  itemId           String
  systemQty        Decimal @db.Decimal(18, 4)
  physicalQty      Decimal @db.Decimal(18, 4)
  /// positive = extra found, negative = shortage
  adjustmentQty    Decimal @db.Decimal(18, 4)
  uomId            String
  unitRate         Decimal @db.Decimal(18, 2)
  amount           Decimal @db.Decimal(18, 2)
  remarks          String?

  reconciliation CnStockReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  item           CnItem                @relation(fields: [itemId], references: [id])
  uom            CnUOM                 @relation(fields: [uomId], references: [id])

  @@index([reconciliationId])
  @@schema("app_quikconstruction")
}

model CnDieselLog {
  id             String   @id @default(cuid())
  tenantId       String
  logNumber      String
  projectId      String
  locationId     String
  logDate        DateTime
  machineryId    String?
  driverName     String?
  vehicleNo      String?
  fuelQty        Decimal  @db.Decimal(18, 4)
  unitRate       Decimal? @db.Decimal(18, 2)
  amount         Decimal? @db.Decimal(18, 2)
  openingReading Decimal? @db.Decimal(18, 2)
  closingReading Decimal? @db.Decimal(18, 2)
  remarks        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   CnProject    @relation(fields: [projectId], references: [id])
  location  CnLocation   @relation(fields: [locationId], references: [id])
  machinery CnMachinery? @relation(fields: [machineryId], references: [id])

  @@unique([tenantId, logNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

// ============================================================================
// QUIKCONSTRUCTION — Phase 4 (Projects core)
// ============================================================================
// BOQ: Bill of Quantities — hierarchical item list with qty × rate per project.
// Locked once approved so downstream docs (Work Order, RAB) can reference it.
// DPR: Daily Progress Report — site-level daily entry of activities, labour,
// machinery. One header per (project, date). Informational, no stock effect.
// Hindrance: blocker log — weather, permit, material shortage, etc. Used for
// delay claims.
// ============================================================================

model CnBOQ {
  id        String    @id @default(cuid())
  tenantId  String
  projectId String
  boqNumber String
  boqDate   DateTime
  currency  String    @default("INR")
  subtotal  Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount Decimal   @default(0) @db.Decimal(18, 2)
  total     Decimal   @default(0) @db.Decimal(18, 2)
  status    String    @default("draft") // draft | locked
  lockedAt  DateTime?
  lockedBy  String?
  remarks   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         CnProject      @relation(fields: [projectId], references: [id])
  items           CnBOQItem[]
  rabs            CnRAB[]
  fromEstimations CnEstimation[] @relation("EstimationToBoq")

  @@unique([tenantId, boqNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnBOQItem {
  id              String    @id @default(cuid())
  boqId           String
  /// Parent in the BOQ tree (null for top-level). Children's rates/amounts
  /// roll up to the parent's `amount` (computed, not stored).
  parentId        String?
  /// Display order within siblings.
  sortOrder       Int       @default(0)
  /// When kind="group" description is a header, quantity/rate/uom are null.
  /// When kind="item" everything must be present.
  kind            String    @default("item") // item | group
  code            String?
  description     String
  itemId          String?
  uomId           String?
  quantity        Decimal?  @db.Decimal(18, 4)
  rate            Decimal?  @db.Decimal(18, 2)
  amount          Decimal   @default(0) @db.Decimal(18, 2)
  gstRate         Decimal?  @db.Decimal(5, 2)
  // Phase 13 — schedule + progress
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  percentComplete Decimal?  @db.Decimal(5, 2)

  boq      CnBOQ       @relation(fields: [boqId], references: [id], onDelete: Cascade)
  parent   CnBOQItem?  @relation("CnBOQItemHierarchy", fields: [parentId], references: [id])
  children CnBOQItem[] @relation("CnBOQItemHierarchy")
  item     CnItem?     @relation(fields: [itemId], references: [id])
  uom      CnUOM?      @relation(fields: [uomId], references: [id])
  dprLines CnDPRLine[]
  rabLines CnRABLine[]

  @@index([boqId])
  @@index([parentId])
  @@index([itemId])
  @@schema("app_quikconstruction")
}

model CnDPR {
  id                    String    @id @default(cuid())
  tenantId              String
  projectId             String
  dprDate               DateTime
  weather               String?
  reportedById          String
  remarks               String?
  /// Default consumption location — single source for this DPR's material
  /// lines. Required at post-time; may be null in draft.
  consumptionLocationId String?
  status                String    @default("draft") // draft | submitted | posted
  postedAt              DateTime?
  postedBy              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   CnProject       @relation(fields: [projectId], references: [id])
  location  CnLocation?     @relation("DprConsumptionLocation", fields: [consumptionLocationId], references: [id])
  lines     CnDPRLine[]
  materials CnDPRMaterial[]

  @@unique([tenantId, projectId, dprDate])
  @@index([tenantId])
  @@index([projectId])
  @@index([dprDate])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

/// Materials consumed on a DPR. On post, each row writes a `dpr_consumption`
/// qtyOut row to CnStockLedger against (projectId, consumptionLocationId,
/// itemId). Rate snapshot taken from moving avg at post-time.
model CnDPRMaterial {
  id       String  @id @default(cuid())
  dprId    String
  itemId   String
  uomId    String
  quantity Decimal @db.Decimal(18, 4)
  /// Snapshot unit rate (populated at post-time from prior ledger avg).
  unitRate Decimal @default(0) @db.Decimal(18, 2)
  amount   Decimal @default(0) @db.Decimal(18, 2)
  remarks  String?

  dpr  CnDPR  @relation(fields: [dprId], references: [id], onDelete: Cascade)
  item CnItem @relation(fields: [itemId], references: [id])
  uom  CnUOM  @relation(fields: [uomId], references: [id])

  @@index([dprId])
  @@index([itemId])
  @@schema("app_quikconstruction")
}

model CnDPRLine {
  id            String   @id @default(cuid())
  dprId         String
  /// What was done: can reference a BOQ item or a free-text description.
  boqItemId     String?
  activity      String
  /// Quantity of work completed today (in uom).
  quantityDone  Decimal  @db.Decimal(18, 4)
  uomId         String?
  /// Labour used today (count of persons).
  labourCount   Int?
  labourHours   Decimal? @db.Decimal(8, 2)
  /// Machinery used today (free-text summary; ties to CnMachinery later).
  machineryUsed String?
  /// Free-text remarks.
  remarks       String?

  dpr     CnDPR      @relation(fields: [dprId], references: [id], onDelete: Cascade)
  boqItem CnBOQItem? @relation(fields: [boqItemId], references: [id])
  uom     CnUOM?     @relation(fields: [uomId], references: [id])

  @@index([dprId])
  @@index([boqItemId])
  @@schema("app_quikconstruction")
}

model CnHindrance {
  id            String    @id @default(cuid())
  tenantId      String
  projectId     String
  hindranceDate DateTime
  category      String // weather | permit | material_shortage | design_change | labour | equipment | external | other
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  daysImpacted  Int?
  status        String    @default("open") // open | resolved | closed
  resolvedAt    DateTime?
  resolvedBy    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project CnProject @relation(fields: [projectId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

// ============================================================================
// QUIKCONSTRUCTION — Phase 4b (Estimation, Work Orders, RAB)
// ============================================================================

model CnEstimation {
  id               String   @id @default(cuid())
  tenantId         String
  projectId        String
  estimationNumber String
  estimationDate   DateTime
  subtotal         Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(18, 2)
  total            Decimal  @default(0) @db.Decimal(18, 2)
  currency         String   @default("INR")
  status           String   @default("draft") // draft | submitted | approved | converted | rejected
  convertedBoqId   String?
  remarks          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      CnProject          @relation(fields: [projectId], references: [id])
  convertedBoq CnBOQ?             @relation("EstimationToBoq", fields: [convertedBoqId], references: [id])
  items        CnEstimationItem[]

  @@unique([tenantId, estimationNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnEstimationItem {
  id           String   @id @default(cuid())
  estimationId String
  parentId     String?
  sortOrder    Int      @default(0)
  kind         String   @default("item") // item | group
  code         String?
  description  String
  itemId       String?
  uomId        String?
  quantity     Decimal? @db.Decimal(18, 4)
  rate         Decimal? @db.Decimal(18, 2)
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  gstRate      Decimal? @db.Decimal(5, 2)

  estimation CnEstimation       @relation(fields: [estimationId], references: [id], onDelete: Cascade)
  parent     CnEstimationItem?  @relation("CnEstimationItemHierarchy", fields: [parentId], references: [id])
  children   CnEstimationItem[] @relation("CnEstimationItemHierarchy")
  item       CnItem?            @relation(fields: [itemId], references: [id])
  uom        CnUOM?             @relation(fields: [uomId], references: [id])

  @@index([estimationId])
  @@index([parentId])
  @@schema("app_quikconstruction")
}

model CnWorkOrder {
  id               String    @id @default(cuid())
  tenantId         String
  woNumber         String
  projectId        String
  contractorId     String
  workCategoryId   String?
  woDate           DateTime
  startDate        DateTime?
  endDate          DateTime?
  subtotal         Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount      Decimal   @default(0) @db.Decimal(18, 2)
  status           String    @default("draft") // draft | sent | in_progress | completed | closed | cancelled
  paymentTermsDays Int?
  termsConditionId String?
  remarks          String?
  completedAt      DateTime?
  completedBy      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      CnProject         @relation(fields: [projectId], references: [id])
  contractor   CnContractor      @relation(fields: [contractorId], references: [id])
  workCategory CnWorkCategory?   @relation(fields: [workCategoryId], references: [id])
  lines        CnWorkOrderLine[]

  @@unique([tenantId, woNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([contractorId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnWorkOrderLine {
  id           String   @id @default(cuid())
  woId         String
  itemId       String?
  description  String
  quantity     Decimal  @db.Decimal(18, 4)
  uomId        String?
  rate         Decimal  @db.Decimal(18, 2)
  amount       Decimal  @db.Decimal(18, 2)
  gstRate      Decimal? @db.Decimal(5, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount  Decimal  @db.Decimal(18, 2)
  completedQty Decimal  @default(0) @db.Decimal(18, 4)
  remarks      String?

  wo   CnWorkOrder @relation(fields: [woId], references: [id], onDelete: Cascade)
  item CnItem?     @relation(fields: [itemId], references: [id])
  uom  CnUOM?      @relation(fields: [uomId], references: [id])

  @@index([woId])
  @@schema("app_quikconstruction")
}

model CnRAB {
  id                String    @id @default(cuid())
  tenantId          String
  rabNumber         String
  projectId         String
  boqId             String
  rabDate           DateTime
  /// Sequential bill number per project (1st RAB, 2nd RAB, …)
  billSeqNo         Int
  billedTillDate    DateTime
  /// Snapshot at time of RAB: cumulative billed before THIS bill.
  priorBilledAmount Decimal   @default(0) @db.Decimal(18, 2)
  /// This period's amount = sum of lines' currentPeriodAmount
  currentBillAmount Decimal   @default(0) @db.Decimal(18, 2)
  subtotal          Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal   @default(0) @db.Decimal(18, 2)
  total             Decimal   @default(0) @db.Decimal(18, 2)
  status            String    @default("draft") // draft | submitted | approved | paid | rejected
  remarks           String?
  approvedAt        DateTime?
  approvedBy        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  CnProject         @relation(fields: [projectId], references: [id])
  boq      CnBOQ             @relation(fields: [boqId], references: [id])
  lines    CnRABLine[]
  invoices CnClientInvoice[]

  @@unique([tenantId, rabNumber])
  @@unique([projectId, billSeqNo])
  @@index([tenantId])
  @@index([projectId])
  @@index([boqId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnRABLine {
  id                  String   @id @default(cuid())
  rabId               String
  boqItemId           String
  /// Cumulative work done (in uom) TILL the end of this RAB's period.
  cumulativeQtyDone   Decimal  @db.Decimal(18, 4)
  /// Snapshot at time of RAB: cumulative qty before THIS bill.
  priorCumulativeQty  Decimal  @default(0) @db.Decimal(18, 4)
  /// = cumulative − prior. The qty billed in THIS period.
  currentPeriodQty    Decimal  @db.Decimal(18, 4)
  /// Rate taken from the BOQ at time of RAB creation (so historical RABs are stable).
  rate                Decimal  @db.Decimal(18, 2)
  /// currentPeriodQty × rate
  currentPeriodAmount Decimal  @db.Decimal(18, 2)
  gstRate             Decimal? @db.Decimal(5, 2)
  taxAmount           Decimal  @default(0) @db.Decimal(18, 2)
  remarks             String?

  rab     CnRAB     @relation(fields: [rabId], references: [id], onDelete: Cascade)
  boqItem CnBOQItem @relation(fields: [boqItemId], references: [id])

  @@index([rabId])
  @@index([boqItemId])
  @@schema("app_quikconstruction")
}

// ── Phase 5 — Finance ───────────────────────────────────────────────────

model CnClientInvoice {
  id            String    @id @default(cuid())
  tenantId      String
  invoiceNumber String
  customerId    String
  projectId     String?
  rabId         String?
  invoiceDate   DateTime
  dueDate       DateTime?
  subtotal      Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount     Decimal   @default(0) @db.Decimal(18, 2)
  /// GST split (additive; legacy rows zero, taxAmount stays authoritative total).
  cgstAmount    Decimal   @default(0) @db.Decimal(18, 2)
  sgstAmount    Decimal   @default(0) @db.Decimal(18, 2)
  igstAmount    Decimal   @default(0) @db.Decimal(18, 2)
  /// 2-char state code — intra-state (CGST+SGST) vs inter-state (IGST).
  placeOfSupply String?
  total         Decimal   @default(0) @db.Decimal(18, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(18, 2)
  status        String    @default("draft") // draft | sent | partial | paid | cancelled
  remarks       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    CnCustomer                  @relation(fields: [customerId], references: [id])
  project     CnProject?                  @relation(fields: [projectId], references: [id])
  rab         CnRAB?                      @relation(fields: [rabId], references: [id])
  allocations CnClientReceiptAllocation[]
  lines       CnClientInvoiceLine[]
  creditNotes CnCreditNote[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([projectId])
  @@index([rabId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnClientReceipt {
  id              String   @id @default(cuid())
  tenantId        String
  receiptNumber   String
  customerId      String
  receiptDate     DateTime
  amount          Decimal  @db.Decimal(18, 2)
  allocatedAmount Decimal  @default(0) @db.Decimal(18, 2)
  mode            String // cash | cheque | bank | upi | other
  reference       String? // cheque #, UTR, txn id
  remarks         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    CnCustomer                  @relation(fields: [customerId], references: [id])
  allocations CnClientReceiptAllocation[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnClientReceiptAllocation {
  id        String  @id @default(cuid())
  receiptId String
  invoiceId String
  amount    Decimal @db.Decimal(18, 2)

  receipt CnClientReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice CnClientInvoice @relation(fields: [invoiceId], references: [id])

  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
  @@schema("app_quikconstruction")
}

model CnVendorBill {
  id                  String    @id @default(cuid())
  tenantId            String
  billNumber          String // internal bill #
  vendorId            String
  projectId           String?
  grnId               String?
  poId                String?
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?
  billDate            DateTime
  dueDate             DateTime?
  subtotal            Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount           Decimal   @default(0) @db.Decimal(18, 2)
  /// GST split (additive).
  cgstAmount          Decimal   @default(0) @db.Decimal(18, 2)
  sgstAmount          Decimal   @default(0) @db.Decimal(18, 2)
  igstAmount          Decimal   @default(0) @db.Decimal(18, 2)
  placeOfSupply       String?
  total               Decimal   @default(0) @db.Decimal(18, 2)
  paidAmount          Decimal   @default(0) @db.Decimal(18, 2)
  status              String    @default("draft") // draft | approved | partial | paid | cancelled
  remarks             String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor      CnVendor                    @relation(fields: [vendorId], references: [id])
  project     CnProject?                  @relation(fields: [projectId], references: [id])
  grn         CnGoodsReceiptNote?         @relation(fields: [grnId], references: [id])
  po          CnPurchaseOrder?            @relation(fields: [poId], references: [id])
  allocations CnVendorPaymentAllocation[]
  lines       CnVendorBillLine[]
  debitNotes  CnDebitNote[]

  @@unique([tenantId, billNumber])
  @@unique([grnId])
  @@index([tenantId])
  @@index([vendorId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnVendorPayment {
  id              String   @id @default(cuid())
  tenantId        String
  paymentNumber   String
  vendorId        String
  paymentDate     DateTime
  amount          Decimal  @db.Decimal(18, 2)
  allocatedAmount Decimal  @default(0) @db.Decimal(18, 2)
  mode            String
  reference       String?
  remarks         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor      CnVendor                    @relation(fields: [vendorId], references: [id])
  allocations CnVendorPaymentAllocation[]

  @@unique([tenantId, paymentNumber])
  @@index([tenantId])
  @@index([vendorId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnVendorPaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  billId    String
  amount    Decimal @db.Decimal(18, 2)

  payment CnVendorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    CnVendorBill    @relation(fields: [billId], references: [id])

  @@unique([paymentId, billId])
  @@index([billId])
  @@schema("app_quikconstruction")
}

// ── Phase 7 — HRMS ──────────────────────────────────────────────────────

model CnEmployee {
  id           String    @id @default(cuid())
  tenantId     String
  empCode      String
  firstName    String
  lastName     String?
  email        String?
  phone        String?
  designation  String?
  departmentId String?
  joinDate     DateTime?
  exitDate     DateTime?
  empType      String    @default("permanent") // permanent | contract | daily_wage
  monthlyWage  Decimal?  @db.Decimal(18, 2)
  dailyWage    Decimal?  @db.Decimal(18, 2)
  hourlyWage   Decimal?  @db.Decimal(18, 2)
  status       String    @default("active")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   CnDepartment?   @relation(fields: [departmentId], references: [id])
