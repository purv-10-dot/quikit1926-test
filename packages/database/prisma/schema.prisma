model PayRun {
  id            String  @id @default(cuid())
  orgId      String
  legalEntityId String?

  periodStart     DateTime     @db.Date
  periodEnd       DateTime     @db.Date
  payDate         DateTime     @db.Date
  payFrequency    PayFrequency @default(Monthly)
  status          PayRunStatus @default(Draft)
  employeeCount   Int          @default(0)
  totalGross      Decimal      @default(0) @db.Decimal(15, 2)
  totalNet        Decimal      @default(0) @db.Decimal(15, 2)
  totalDeductions Decimal      @default(0) @db.Decimal(15, 2)
  currency        String       @default("INR")
  notes           String?
  processedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?

  // Transient payroll-compute job state (queued → running → done | failed) for
  // status polling of a background compute. Formerly the separate
  // PayrollComputeState table (1:1, keyed by PayRun id); folded in here.
  // computeStatus = null means no compute has been run/queued for this run.
  computeStatus          String?
  computeStartedAt       DateTime?
  computeFinishedAt      DateTime?
  computeEmployeeCount   Int?
  computeTotalGross      Float?
  computeTotalNet        Float?
  computeTotalDeductions Float?
