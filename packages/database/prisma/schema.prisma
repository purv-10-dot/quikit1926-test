  @@unique([roleId, resource, action])
  @@index([roleId])
  @@schema("app_quikhrms")
}

model HrmsRoleNavigation {
  @@map("RoleNavigation")
  id     String @id @default(cuid())
  roleId String
  navKey String

  role HrmsAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, navKey])
