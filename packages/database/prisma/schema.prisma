// Manual TDS overrides per (period, employee). HR can lower (or raise) the
// computed TDS for one month, then choose a recovery strategy so the deficit
// flows back into future payslips. Survives recompute.
model TdsOverride {
  id         String @id @default(cuid())
  orgId   String
  employeeId String

  // Where the override is applied (the "this month" decision).
  setOnPayRunId String
  setOnPeriod   DateTime @db.Date
  fy            String // "2026-2027" — locks the recovery window to one FY

  // What changed in setOnPeriod
  originalTds Decimal @db.Decimal(15, 2)
  overrideTds Decimal @db.Decimal(15, 2)
  // shortfall = originalTds - overrideTds. Positive = underdeducted (to be recovered).
  // Negative = HR over-deducted (no recovery, just a one-month higher TDS).
  shortfall Decimal @db.Decimal(15, 2)

  // Recovery plan
  recoveryStrategy TdsRecoveryStrategy
  recoveryMonths   Int // 1 for NextMonth, N for Spread (capped to months left in FY)
  perMonthAmount   Decimal  @db.Decimal(15, 2)
  recoveryStart    DateTime @db.Date // typically setOnPeriod + 1 month
  recoveryEnd      DateTime @db.Date // recoveryStart + (recoveryMonths-1) months

  reason String?
  status TdsOverrideStatus @default(Active)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orgId, employeeId, status])
  @@index([orgId, fy, status])
  @@index([orgId, setOnPayRunId])
  @@schema("app_quikhrms")
}

enum TdsRecoveryStrategy {
  NextMonth        // single lump-sum recovery in the month after the override
  SpreadOverMonths // even split across N months starting next month

  @@schema("app_quikhrms")
}

enum TdsOverrideStatus {
  Active     // current — either being applied this month or in recovery
  Recovered  // shortfall fully recovered (all recovery months past)
  Cancelled  // HR deleted before it took effect
  Superseded // a newer override replaced this one (cancels remaining recovery)

  @@schema("app_quikhrms")
}

