  remarks       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project CnProject? @relation(fields: [projectId], references: [id])

  @@unique([tenantId, expenseNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([deletedAt])
