/// User.wwwFrozenCol (and matching) columns — those stay in place for
/// rollback safety but are no longer read by the app.
model UserTablePreference {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  tableName  String
  frozenCol  String?
  hiddenCols String?
