  createdBy  String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, fiscalYear, quarter])
  @@index([orgId])
  @@index([fiscalYear])
  @@index([status])
  @@schema("app_quikscale")
}

model PerformanceReview {
  id              String   @id @default(cuid())
  orgId           String
  reviewerId      String
  revieweeId      String
  quarter         String
  year            Int
  kpiScore        Float?
  priorityScore   Float?
  attendanceScore Float?
