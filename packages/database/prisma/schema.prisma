  @@schema("app_quikinfra")
}

model CnGoodsReceiptNote {
  id                   String    @id @default(cuid())
  orgId                String
  grnNumber            String
  poId                 String
  projectId            String
  vendorId             String
  grnDate              DateTime
  locationId           String
  storageLocationId    String?
  supplierInvoiceNo    String?
  supplierInvoiceDate  DateTime?
  challanNo            String?
  challanDate          DateTime?
  receivedById         String
  /// Free-text fallback when the receiver isn't a platform user yet.
  /// Written when the form's "Received By / Inspector" field gets a
  /// name rather than a user-id â€” UI collects the name directly.
  receivedByName       String?
  inspectedById        String?
  weighbridgeSlipNo    String?
  /// Vehicle / truck number that delivered the goods.
  vehicleNo            String?
  /// GSTN E-Way Bill number (12 digits) â€” mandatory when the invoice
  /// value is >= \u20B950,000.
  ewayBillNo           String?
  /// Approximate invoice value quoted by the supplier at receipt
  /// time. Used as the basis for the E-Way Bill gate above.
  approxInvoiceValue   Decimal?  @db.Decimal(18, 2)
  /// Filename(s) of the uploaded challan scan / photo attachment.
  /// Stored comma-separated when the user picks multiple files. The
  /// full-blob upload pipeline is TBD; for now this is the
  /// reference the validator and detail page both read.
  challanAttachment    String?
  /// Overall quality verdict captured at GRN create time â€”
  /// complements the per-line Condition field and is used to route
  /// the approval workflow (rejections â†’ QC step).
  overallQualityStatus String?   @default("Accepted")
  status               String    @default("draft")
  approvalId           String?
  remarks              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String
  updatedBy            String

  po       CnPurchaseOrder @relation(fields: [poId], references: [id])
  project  CnProject       @relation(fields: [projectId], references: [id])
  vendor   CnVendor        @relation(fields: [vendorId], references: [id])
  location CnLocation      @relation(fields: [locationId], references: [id])
  lines    CnGRNLine[]

  // --- grafted: cross-schema relations (Org/User) ---
  org                 Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@unique([orgId, grnNumber])
  @@index([orgId])
  @@index([poId])
  @@index([projectId])
  @@index([status])
  // Composite indexes â€” match `ORDER BY grnDate DESC` in listGRNs.
  @@index([orgId, status, grnDate(sort: Desc)])
  @@index([orgId, projectId, grnDate(sort: Desc)])
  @@map("Goods_receipt_notes")
  @@schema("app_quikinfra")
}

