// ============================================================================
// AUTO-REPLY (Phase 1) — Meta Graph polling + template/AI reply pipeline.
// Ported from quiksocial-v2. Polling is driven by instrumentation.ts cron
// tick → /api/cron/auto-reply-monitor → internal API routes → Python AI
// service on Railway (no BullMQ/Redis on the Next.js side).
// ============================================================================

enum AutoReplyTriggerType {
  ANY_COMMENT
  KEYWORD_MATCH

  @@schema("app_quiksocial")
}

enum AutoReplyMode {
  TEMPLATE
  AI

  @@schema("app_quiksocial")
}

enum AutoReplyKeywordMatch {
  ANY
  ALL

  @@schema("app_quiksocial")
}

enum AutoReplyLogStatus {
  PENDING
  SENT
  FAILED
  SKIPPED

  @@schema("app_quiksocial")
}

model AutoReplyRule {
  id               String                @id @default(cuid())
  orgId            String
  brandId          String
  socialAccountId  String
  name             String
  triggerType      AutoReplyTriggerType
  replyMode        AutoReplyMode
  isActive         Boolean               @default(true)
  priority         Int                   @default(0)
  templateBody     String?
  keywords         String[]              @default([])
  keywordMatch     AutoReplyKeywordMatch @default(ANY)
  caseSensitive    Boolean               @default(false)
  toneGuidance     String?
  cooldownMinutes  Int                   @default(0)
  maxRepliesPerDay Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  createdBy        String?
  updatedBy        String?
  brand            Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount         @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  logs             AutoReplyLog[]

  @@index([orgId])
  @@index([orgId, brandId, isActive])
  @@index([orgId, socialAccountId, isActive])
  @@index([orgId, brandId, isActive, priority(sort: Desc)])
  @@schema("app_quiksocial")
}

model AutoReplyPostControl {
  id               String   @id @default(cuid())
  orgId            String
  postId           String   @unique
  autoReplyEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedBy        String?
  post             Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@schema("app_quiksocial")
}

model AutoReplyLog {
  id                String             @id @default(cuid())
  orgId             String
  ruleId            String
  postId            String
  socialAccountId   String
  platformCommentId String
  commentAuthor     String?
  commentAuthorId   String?
  commentText       String?
  replyText         String?
  replyMode         AutoReplyMode
  status            AutoReplyLogStatus @default(PENDING)
  failureReason     String?
  providerUsed      String?
  latencyMs         Int?
  costUsd           Float?
  platformReplyId   String?
  sentAt            DateTime           @default(now())
  rule              AutoReplyRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  post              Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount     SocialAccount      @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformCommentId])
  @@index([orgId, ruleId, sentAt(sort: Desc)])
  @@index([orgId, postId, sentAt(sort: Desc)])
  @@index([orgId, sentAt(sort: Desc)])
  @@index([orgId, status, sentAt])
  @@schema("app_quiksocial")
}

model AutoReplyCursor {
  id                   String        @id @default(cuid())
  orgId                String
  socialAccountId      String
  postId               String
  platformPostId       String
  lastPolledAt         DateTime
  lastCommentTimestamp DateTime?
  lastPollError        String?
  consecutiveErrors    Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  socialAccount        SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  post                 Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([orgId, socialAccountId, postId])
  @@index([orgId, socialAccountId])
  @@schema("app_quiksocial")
}

/// QuikIT RBAC v2 — org-scoped role definition for QuikSocial. Sits on top
/// of the per-brand BrandMembership (which keeps owning brand-level
/// admin/approver/member); this AppRole gates org-wide "QuikSocial admin"
/// capabilities. DB table is `AppRole` in `app_quiksocial` (via @@map);
/// Prisma model name is prefixed `Qs` so it can coexist with QuikScale's
/// AppRole + QuikTrack's QtAppRole etc. in a single schema.prisma.
model QsAppRole {
  id          String             @id @default(cuid())
  orgId       String
  appId       String
  name        String
  description String?
  isSystem    Boolean            @default(false)
  isDefault   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   String?
  app         App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  org         Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  navigations QsRoleNavigation[]
  permissions QsRolePermission[]
  members     QsUserAppRole[]

  @@unique([orgId, appId, name])
  @@index([orgId, appId])
  @@map("AppRole")
  @@schema("app_quiksocial")
}

model QsUserAppRole {
  id         String    @id @default(cuid())
  userId     String
  orgId      String
  roleId     String
  assignedAt DateTime  @default(now())
  assignedBy String?
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role       QsAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, roleId])
  @@index([roleId])
  @@index([userId, orgId])
  @@map("UserAppRole")
  @@schema("app_quiksocial")
}

model QsRolePermission {
  id       String    @id @default(cuid())
  roleId   String
  resource String
  action   String
  role     QsAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("RolePermission")
  @@schema("app_quiksocial")
}

model QsRoleNavigation {
  id     String    @id @default(cuid())
  roleId String
  navKey String
  role   QsAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, navKey])
  @@index([roleId])
  @@map("RoleNavigation")
  @@schema("app_quiksocial")
}

model QtFeedback {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  projectId  String?
  category   String
  content    String
  contactOk  Boolean  @default(false)
  researchOk Boolean  @default(false)
  url        String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([userId])
  @@schema("app_quiktrack")
}

/// Radio-style tri-state used by every format / punctuality / quality flag.
enum ClientMeetingFlag {
  YES
  NO
  NA

  @@schema("app_quikscale")
}

/// Call status for daily huddles and weekly meetings.
enum ClientMeetingStatus {
  HELD
  NOT_HELD
  CALL_CANCELLED_BY_CLIENT
  HOLIDAY_FOR_CLIENT
  HOLIDAY_FOR_SUCCESS_ALCHEMIST
  OTHER

  @@schema("app_quikscale")
}
