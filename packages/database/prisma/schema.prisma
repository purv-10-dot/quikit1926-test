}

model CnSafetyChecklist {
  id            String   @id @default(cuid())
  tenantId      String
  projectId     String?
  templateName  String // e.g. "Daily site safety walk"
  checklistDate DateTime
  completedBy   String
  /// JSON: [{ item: string, ok: bool, remarks?: string }]
  items         Json
  overallStatus String   @default("pass") // pass | fail | partial
  remarks       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project CnProject? @relation(fields: [projectId], references: [id])

  @@index([tenantId])
  @@index([checklistDate])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

// ── Phase 12 — Documents (local disk MVP) ───────────────────────────────

model CnDocument {
