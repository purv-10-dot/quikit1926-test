model LeaveType {
  id    String  @id @default(cuid())
  orgId String
  name        String
  code        String
  color       String?
  description String?

  isPaid          Boolean @default(true)
  isCarryForward  Boolean @default(false)
  maxCarryForward Int?
  isEncashable    Boolean @default(false)
  maxEncashment   Int?

  accrualType  LeaveAccrualType @default(Yearly)
  accrualCount Decimal          @default(0) @db.Decimal(5, 2)
  maxBalance   Int              @default(0)

  minConsecutiveDays Int?
  maxConsecutiveDays Int?

  // Frequency caps — max approved leave REQUESTS of this type per period.
  // Null = unlimited. e.g. maxPerMonth=2, maxPerYear=12.
  maxPerMonth Int?
  maxPerYear  Int?

  // Once-in-a-lifetime leave (e.g. Marriage): an employee may take it only a
  // single time, ever. Enforced across all their Pending/Approved requests.
  isOnceInLifetime Boolean @default(false)

  applicableGender         String? // All|Male|Female|Other
  applicableMaritalStatus  String? // All|Single|Married
  applicableEmploymentType Json?
  applicableAfterDays      Int     @default(0)

  requiresDocumentation  Boolean @default(false)
  documentationAfterDays Int?
  documentationType      String? // which document is required (e.g. "Medical Certificate", "Birth Proof")

  isNegativeBalanceAllowed Boolean @default(false)
  maxNegativeBalance       Int?

  includesHolidays Boolean @default(false)
  includesWeekoffs Boolean @default(false)

  isHalfDayAllowed Boolean @default(true)
  isHourlyAllowed  Boolean @default(false)

  clubbingRestrictions Json?

  isCompOff         Boolean @default(false)
  compOffExpiryDays Int?

  isDefault Boolean @default(false)

  // ── Leave rules wizard (per-leave-type config) ──────────────────────────
  // Step 1 — Accrual & accumulation
  isUnlimited           Boolean @default(false) // no yearly cap on entitlement
  noAccrualJoinAfterDay Int? // no credit if the employee joins after this day-of-month

  // Step 2 — Applying leave & approvals
  selfApplyAllowed  Boolean @default(true) // employee can see + apply for this leave
  requiresApproval  Boolean @default(true) // request needs approval (else auto-approved)
  advanceNoticeDays Int? // must apply at least N days before the leave start (null = off)
  applicableAfterRef String? @default("JoiningDate") // JoiningDate|ConfirmationDate — anchor for applicableAfterDays
  backdateCutoffDay  Int? // block back-dated leave after this day-of-month
  blockIfBalanceLeaveTypeId String? // not available while balance remains in this leave type
  requiresComment    Boolean @default(false) // comment mandatory when applying

  // Step 3 — Additional restrictions
  maxDaysPerMonth    Int? // max leave DAYS of this type per calendar month
  applyCutoffDay     Int? // cannot apply for this leave after this day-of-month
  minGapDays         Int? // minimum gap (days) required between two instances
  blockedDuringNotice Boolean @default(false) // notice-period employees cannot avail

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  leaveGroupItems LeaveGroupItem[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@schema("app_quikhrms")
}

