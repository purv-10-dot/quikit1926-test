/// Personal to-do checklist (OneNote-style), NOT tied to any project. Private
/// to the owner (userId) — only its creator ever sees it. Items are NOT
/// timesheet targets. Reminders are in-app only and are materialized on the
/// notifications poll when `dueDate` has passed.
model QtChecklistItem {
  id             String             @id @default(cuid())
  orgId          String
  userId         String
