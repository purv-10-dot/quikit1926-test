  name     String
  code     String
  color    String?

  startTime String
  endTime   String

  breakDuration    Int     @default(60)
  breakStartTime   String?
  breakEndTime     String?
  graceMinutes     Int     @default(15)
  minHoursRequired Decimal @default(8) @db.Decimal(4, 2)

  isFlexible          Boolean @default(false)
  flexibleWindowStart String?
  flexibleWindowEnd   String?

  isNightShift Boolean @default(false)
  weekOffs     Json?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  isDefault Boolean @default(false)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignments   ShiftAssignment[]
  rosterEntries RosterEntry[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@schema("app_quikhrms")
}

model ShiftAssignment {
