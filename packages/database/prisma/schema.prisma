model User {
  id                      String                           @id @default(cuid())
  email                   String                           @unique
  emailVerified           DateTime?
  password                String?
  firstName               String
  lastName                String
  avatar                  String?
  isSuperAdmin            Boolean                          @default(false)
  country                 String?
  timezone                String?
  bio                     String?
  themeMode               String?                          @default("light")
  accentColor             String?                          @default("#0066cc")
  kpiFrozenCol            String?
  priorityFrozenCol       String?
  wwwFrozenCol            String?
  kpiHiddenCols           String?
  priorityHiddenCols      String?
  wwwHiddenCols           String?
  kpiSort                 String?
  prioritySort            String?
  wwwSort                 String?
  kpiColWidths            String?
  priorityColWidths       String?
  wwwColWidths            String?
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  lastSignInAt            DateTime?
  /// FRD FR-SA-009 / BR-008 — true when the user was created via a native
  /// email invite and is still on the system default password (Quikit2026).
  /// On first login the auth flow routes them to /set-password instead of
  /// the dashboard. Cleared once they save a new password (or click Skip,
  /// because BR-008 says the screen is shown only once).
  mustChangePassword      Boolean                          @default(false)
  accountabilityFunctions AccountabilityFunction[]
  dailyHuddleAbsences     ClientDailyHuddleAbsence[]
  clientMemberships       ClientMembership[]
  weeklyMeetingAbsences   ClientWeeklyMeetingAbsence[]
  weeklyDashboardNAs      ClientWeeklyMeetingDashboardNA[]
  feedbackGiven           FeedbackEntry[]                  @relation("FeedbackFrom")
  feedbackReceived        FeedbackEntry[]                  @relation("FeedbackTo")
  goalsOwned              Goal[]                           @relation("GoalOwner")
  kpisOwned               KPI[]                            @relation("KPIOwner")
  kpiNotes                KPINote[]
  wwwNotes                WWWNote[]
  opspData                OPSPData[]
  opspUserSections        OPSPUserSection[]
  opppPlan                OPSPPlan?
  opspReviewEntries       OPSPReviewEntry[]
  oneOnOnesAsManager      OneOnOne[]                       @relation("OneOnOneManager")
  oneOnOnesAsReport       OneOnOne[]                       @relation("OneOnOneReport")
  reviewsReceived         PerformanceReview[]              @relation("ReviewsReceived")
  reviewsGiven            PerformanceReview[]              @relation("ReviewsGiven")
  prioritiesOwned         Priority[]                       @relation("PriorityOwner")
  talentAssessor          TalentAssessment[]               @relation("TalentAssessor")
  talentAssessed          TalentAssessment[]               @relation("TalentAssessed")
  appRoles                UserAppRole[]
  permissionExtras        UserPermissionExtra[]
  tablePreferences        UserTablePreference[]
  UserAppRole             QtUserAppRole[]
  UserPermissionExtra     QtUserPermissionExtra[]
  cnUserAppRoles          CnUserAppRole[]
  cnUserPermissionExtras  CnUserPermissionExtra[]
  qsUserAppRoles          QsUserAppRole[]
  qcUserAppRoles          QcUserAppRole[]
  qcPermissionExtras      QcUserPermissionExtra[]
  cnUserProfiles          CnUserProfile[]
  cnUserProjectAccess     CnUserProjectAccess[]
  qtProjectUserRoles      QtProjectUserRole[]
  accounts                Account[]
  sessions                Session[]
  verificationTokens      VerificationToken[]
  sessionEvents           SessionEvent[]
  authLogs                AuthLog[]
  auditEventReads         AuditEventRead[]
  userTeams               UserTeam[]
  qsUserTeams             QsUserTeam[]
  memberships             OrgMember[]
  appAccess               UserAppAccess[]
  astEmployees            AstEmployee[]

  @@index([email])
  @@schema("auth")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  token_type        String?
  scope             String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("auth")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("auth")
}

/// Email verification + password reset tokens for the central auth app (`apps/auth`).
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("auth")
}

/// Audit row written by `POST /api/auth/internal/issue-agent-jwt` on every
/// attempt — success and failure. `status` distinguishes outcomes; `errorCode`
/// is set on non-success rows to mirror the API error envelope. No FK to User
/// because we want to log issuance attempts even for unknown userIds (which is
/// itself a useful security signal).
model AgentJwtIssuance {
  id                String   @id @default(cuid())
  requestingService String
  userId            String
  orgId             String
  agentId           String?
  reason            String
  ttlSeconds        Int
  actingAs          String
  traceId           String?
  status            String
  errorCode         String?
  issuedAt          DateTime @default(now())

  @@index([userId, issuedAt])
  @@index([requestingService, issuedAt])
  @@schema("auth")
}

model OrgMember {
  id                String    @id @default(cuid())
  orgId             String
  userId            String
  role              String
  teamId            String?
  customPermissions String[]
  invitationToken   String?   @unique
  invitedAt         DateTime?
  acceptedAt        DateTime?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  /// FRD FR-SA-002 / FR-OA-002 — apps to grant on accept. Replaces the old
  /// auto-grant-all-active-apps behaviour. Empty = no app access (only valid
  /// for role=member per FR-OA-003).
  inviteAppIds      String[]  @default([])
  /// FRD §3.3 / §3.4 — "sso" or "native". Drives which onboarding email is sent,
  /// which CTA is rendered, and whether the accept flow goes through the
  /// Set-Password screen. Null for legacy memberships created before the FRD.
  inviteMethod      String?
  /// FRD §3.3 — for SSO invites we classify the invited email's provider at
  /// invite time so the email template can render "Sign in with Google" vs
  /// "Sign in with Microsoft". One of: "google" | "microsoft" | null.
  inviteProvider    String?
  org               Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // QuikScale owns its team data in app_quikscale."Team" (model QsTeam). This
  // membership pointer is written ONLY by QuikScale — Admin/QuikTrack track
  // membership via the UserTeam join, and packages/auth never sets teamId.
  team              QsTeam?   @relation(fields: [teamId], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, orgId, status])
  @@index([teamId])
  @@index([role])
  @@index([orgId, role])
  @@schema("quikit")
}

model UserTeam {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  teamId    String
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, teamId])
  @@index([orgId])
  @@index([userId])
  @@index([teamId])
  @@schema("public")
}

// Shared, platform-level teams. Managed by the Admin Portal and shared with
// QuikTrack (via the UserTeam join). QuikScale no longer reads this table —
// it owns its own copy in app_quikscale."Team" (model QsTeam). The KPI /
// Priority / AccountabilityFunction / OrgMember relations that used to point
// here now point at QsTeam, so those back-relations live on QsTeam.
model Team {
  id           String     @id @default(cuid())
  orgId        String
  name         String
  description  String?
  slug         String
  parentTeamId String?
  headId       String?
  color        String?    @default("#0066cc")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    String?
  deletedAt    DateTime?
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentTeam   Team?      @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams   Team[]     @relation("TeamHierarchy")
  userTeams    UserTeam[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([parentTeamId])
  @@index([deletedAt])
  @@schema("public")
}

// <-------------------------------------------> quikscale schema started <--------------------------------------------------->

// QuikScale-owned copy of Team. Physical table: app_quikscale."Team". Seeded
// once from public.Team (ids preserved) by the quikscale_own_teams migration.
// QuikScale is fully independent of shared team data from here on.
model QsTeam {
  id                      String                   @id @default(cuid())
  orgId                   String
  name                    String
  description             String?
  slug                    String
  parentTeamId            String?
  headId                  String?
  color                   String?                  @default("#0066cc")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  createdBy               String?
  deletedAt               DateTime?
  accountabilityFunctions AccountabilityFunction[]
  kpis                    KPI[]
  priorities              Priority[]
  org                     Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentTeam              QsTeam?                  @relation("QsTeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams              QsTeam[]                 @relation("QsTeamHierarchy")
  userTeams               QsUserTeam[]
  members                 OrgMember[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([parentTeamId])
  @@index([deletedAt])
  @@map("Team")
  @@schema("app_quikscale")
}

// QuikScale-owned copy of UserTeam. Physical table: app_quikscale."UserTeam".
model QsUserTeam {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  teamId    String
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team      QsTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, teamId])
  @@index([orgId])
  @@index([userId])
  @@index([teamId])
  @@map("UserTeam")
  @@schema("app_quikscale")
}

model AccountabilityFunction {
  id                String                   @id @default(cuid())
  orgId             String
  name              String
  description       String?
  teamId            String?
  parentFunctionId  String?
  assignedToUserId  String?
  chartType         String                   @default("face")
  sortOrder         Int                      @default(0)
  expectedOutcomes  String?
  leadingIndicators String?
  deletedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  assignedTo        User?                    @relation(fields: [assignedToUserId], references: [id])
  org               Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentFunction    AccountabilityFunction?  @relation("FunctionHierarchy", fields: [parentFunctionId], references: [id])
  childFunctions    AccountabilityFunction[] @relation("FunctionHierarchy")
  team              QsTeam?                  @relation(fields: [teamId], references: [id])

  @@unique([orgId, chartType, name])
  @@index([orgId])
  @@index([orgId, chartType])
  @@index([assignedToUserId])
  @@index([deletedAt])
  @@schema("app_quikscale")
}

model KPI {
  id                 String           @id @default(cuid())
  orgId              String
  name               String
  description        String?
  kpiLevel           String           @default("individual")
  owner              String?
  ownerIds           String[]         @default([])
  ownerContributions Json?
  teamId             String?
  parentKPIId        String?
  quarter            String           @default("Q1")
  year               Int
  measurementUnit    String
  target             Float?
  quarterlyGoal      Float?
  qtdGoal            Float?
  qtdAchieved        Float?
  currentWeekValue   Float?
  progressPercent    Float?           @default(0)
  status             String           @default("active")
  healthStatus       String           @default("on-track")
  divisionType       String           @default("Cumulative")
  weeklyTargets      Json?
  weeklyOwnerTargets Json?
  currency           String?
  targetScale        String?
  // Display label for non-currency (Number) KPIs, chosen from UnitMaster
  // (e.g. "Leads", "Calls", "kg"). Null = none. Label only — no calculation.
  unit               String?
  // When true (Currency KPI with a chosen targetScale), weekly breakdown,
  // Updates, Stats, list grid + dashboard cards display/accept values in the
  // chosen scale unit (e.g. ₹ Cr). Display/input only — stored values stay RAW.
  scaledDisplay      Boolean          @default(false)
  reverseColor       Boolean          @default(false)
  frequency          String           @default("weekly")
  // Classification of the KPI's role in the metric chain: "Leading" (predictive,
  // an input you can act on now) vs "Lagging" (outcome, measured after the fact).
  // "NA" = unclassified (default). Plain string + app-level enum validation,
  // matching every other KPI single-select (never a Prisma enum).
  kpiType            String           @default("NA")
  // True when this KPI was created via the OPSP "Export → Create KPIs" flow.
  // Display-only (shown in the KPI grid); never edited from the Add/Edit form.
  importedFromOpsp   Boolean          @default(false)
  lastNotes          String?
  lastNotesAt        DateTime?
  lastNotedBy        String?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdBy          String
  updatedBy          String?
  org                Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner_user         User?            @relation("KPIOwner", fields: [owner], references: [id])
  parentKPI          KPI?             @relation("KPICascade", fields: [parentKPIId], references: [id])
  childKPIs          KPI[]            @relation("KPICascade")
  team               QsTeam?          @relation(fields: [teamId], references: [id])
  logs               KPILog[]
  notes              KPINote[]
  weeklyValues       KPIWeeklyValue[]

  // Manual drag-to-reorder rank within the org (shared). Null = unpositioned.
  position           Float?

  @@index([orgId])
  @@index([orgId, position])
  @@index([orgId, deletedAt])
  @@index([orgId, kpiLevel, deletedAt])
  @@index([owner])
  @@index([teamId])
