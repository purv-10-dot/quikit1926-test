  documentId      String
  sectionType     String
  content         String
  notes           String?
  stakeholderType String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  updatedBy       String?
  document        OPSPDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sectionType])
  @@schema("app_quikscale")
}

model OPSPPlan {
