// ─── JOB REQUISITION ────────────────────────────────────

model JobRequisition {
  id    String @id @default(cuid())
  orgId String

  requisitionNumber String
  title             String
  departmentId      String?
  reportingToId     String?
  positions         Int     @default(1)
  filledPositions   Int     @default(0)

  // Job Requisition Form fields (moreYeahs template parity).
  jobLocation   String? // free-text city / office location
  jobDuration   String? // e.g. contract length ("6 months"), "Permanent"
  workTimings   String? // working hours / shift ("9 AM–6 PM", "Night shift")
  interviewMode String? // "Video" | "InPerson" | "Either" | "NotRequired"

  type           RequisitionType @default(NewPosition)
  employmentType EmploymentType  @default(FullTime)
  workLocation   WorkLocation    @default(Office)

  experienceMin  Decimal? @db.Decimal(4, 1)
  experienceMax  Decimal? @db.Decimal(4, 1)
  salaryMin      Decimal? @db.Decimal(15, 2)
  salaryMax      Decimal? @db.Decimal(15, 2)
  salaryCurrency String   @default("INR")

  jobDescription   String?
  responsibilities Json?
  requirements     Json?
  niceToHave       Json?
  skills           Json?
  skillWeights     Json? // Array<{ skill: string; weight: number }> — ATS scoring weights (1-10)
  education        String?
  passingYear      Int? // minimum year of passing for the required qualification
  technicalQuestions Json? // Array<string> — interview/technical questions for this job
  benefits         Json?

  // Role Scorecard (optional) — modeled after the Topgrading/JD-Scorecard pattern.
  // Used to set clearer success criteria during hiring + share with candidates.
  rolePurpose String? // 1-2 sentence "why this role exists"

  status   RequisitionStatus   @default(ReqDraft)
  priority RequisitionPriority @default(Medium)

  careerPageVisible   Boolean  @default(true)
  internalPostingOnly Boolean  @default(false)
  referralBonusAmount Decimal? @db.Decimal(15, 2)

  createdById     String?
  hiringManagerId String?
  recruiterId     String?
  pipelineId      String?

  raisedById    String?
  raisedAt      DateTime?
  justification String?

  closedDate    DateTime? @db.Date
  closureReason String?

  // Extended requisition metadata (job posting + hiring plan). These columns
  // already exist in the DB; kept in sync here so the generated client accepts them.
  jobOpeningName    String?
  interviewPanel    Json? // Array<employeeId> — interview panel members
  postToJobPortal   Boolean   @default(false)
  budget            Decimal?  @db.Decimal(15, 2)
  etaToFillDays     Int?
  targetJoiningDate DateTime? @db.Date
  jobGrade          String?
  costCenter        String?

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  department    Department?           @relation(fields: [departmentId], references: [id])
  creator       Employee?             @relation("RequisitionCreator", fields: [createdById], references: [id])
  hiringManager Employee?             @relation("HiringManager", fields: [hiringManagerId], references: [id])
  recruiter     Employee?             @relation("Recruiter", fields: [recruiterId], references: [id])
  raiser        Employee?             @relation("RequisitionRaiser", fields: [raisedById], references: [id])
  approvals     RequisitionApproval[]
  pipeline      HiringPipeline?       @relation(fields: [pipelineId], references: [id])
  applications  JobApplication[]

  @@unique([orgId, requisitionNumber])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, status])
  @@index([orgId, pipelineId])
  @@schema("app_quikhrms")
}

model Candidate {
  id    String @id @default(cuid())
  orgId String

  firstName String
  lastName  String
  email     String
  phone     String?

  resumeUrl    String?
  parsedResume Json?

  currentCompany     String?
  currentDesignation String?
  currentCTC         Decimal? @db.Decimal(15, 2)
  expectedCTC        Decimal? @db.Decimal(15, 2)
  noticePeriod       Int?
  totalExperience    Int?

  skills    Json?
  education Json?

  linkedinUrl  String?
  portfolioUrl String?

  source       CandidateSource @default(CandDirect)
  referredById String?
  location     String?

  willingToRelocate Boolean  @default(false)
  tags              Json?
  rating            Decimal? @db.Decimal(3, 1)

  status       CandidateStatus @default(New)
  doNotContact Boolean         @default(false)
  gdprConsent  Boolean         @default(false)

  isBlacklisted    Boolean   @default(false)
  blacklistReason  String?
  blacklistedAt    DateTime?
  blacklistedBy    String?
  blacklistedUntil DateTime?

  isArchived    Boolean   @default(false)
  archiveReason String?
  archivedAt    DateTime?
  archivedBy    String?

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  referredBy   Employee?        @relation("CandidateReferrer", fields: [referredById], references: [id])
  applications JobApplication[]

  @@unique([orgId, email])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, status])
  @@index([orgId, isBlacklisted])
  @@index([orgId, isArchived])
  // Performance: candidate list page scope filters
  @@index([orgId, deletedAt, isBlacklisted, isArchived, status])
  @@index([orgId, createdAt(sort: Desc)])
  @@schema("app_quikhrms")
}

model HiringPipeline {
  id    String @id @default(cuid())
  orgId String
  name  String

  stages    Json
  isDefault Boolean @default(false)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  requisitions JobRequisition[]

  @@index([orgId])
  @@index([orgId, deletedAt])
  @@schema("app_quikhrms")
}

model JobApplication {
  id            String @id @default(cuid())
  orgId         String
  candidateId   String
  requisitionId String

  appliedDate  DateTime @default(now())
  currentStage String?
  stageHistory Json?
  // Screening-call sheet captured from the pipeline (answers + technical Q&A + comments).
  screeningAnswers Json?

  status ApplicationStatus @default(AppActive)

  aiMatchScore    Decimal? @db.Decimal(5, 2)
  aiMatchAnalysis Json?

  rejectionReason String?
  rejectionStage  String?
  // Stable timestamp of when the application was rejected — the re-apply
  // cooling window counts from this, not from `updatedAt` (which later edits move).
  rejectedAt      DateTime?
  // A "penalty-free" rejection (e.g. closed because the requisition was
  // cancelled / not selected after a hold-resume review). Excluded from the
  // re-apply cooling-period block so the candidate can still apply elsewhere.
  rejectionExempt Boolean @default(false)
  // Set when a "still interested?" invite is sent after a hold-resume. While
  // this is set (and status is still AppOnHold), the candidate is awaiting
  // confirmation — they only re-enter the pipeline after clicking "Yes".
  reconfirmSentAt DateTime?

  // Offer — formerly the separate OfferDetail table (1:1, keyed by
  // applicationId). Folded in here. offerStatus = null means no offer exists
  // for this application yet.
  offerStatus           OfferStatus?
  offerDesignation      String?
  offerDepartmentId     String?
  offerReportingToId    String?
  offeredCTC            Decimal?     @db.Decimal(15, 2)
  offeredComponents     Json?
  offerJoiningDate      DateTime?    @db.Date
  offerJoiningBonus     Decimal?     @db.Decimal(15, 2)
  offerRelocationBonus  Decimal?     @db.Decimal(15, 2)
  offerEquityGrant      String?
  offerSentAt           DateTime?
  offerRespondedAt      DateTime?
  offerExpiresAt        DateTime?
  offerDeclineReason    String?
  offerCounterOfferCTC  Decimal?     @db.Decimal(15, 2)
  offerNegotiationNotes String?
  offerLetterUrl        String?
  offerCreatedAt        DateTime?
  offerCreatedBy        String?

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  candidate   Candidate                  @relation(fields: [candidateId], references: [id])
  requisition JobRequisition             @relation(fields: [requisitionId], references: [id])
  interviews  Interview[]
  docRequests CandidateDocumentRequest[]

  @@unique([orgId, candidateId, requisitionId])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, requisitionId])
  @@index([orgId, status])
  // Performance: pipeline views + candidate lookup
  @@index([orgId, candidateId, status])
  @@index([orgId, requisitionId, currentStage])
  @@index([orgId, requisitionId, status, createdAt(sort: Desc)])
  // Performance: offers list (applications that have an offer)
  @@index([orgId, offerStatus])
  @@schema("app_quikhrms")
}

model Interview {
  id            String @id @default(cuid())
  orgId         String
  applicationId String

  round         Int           @default(1)
  type          InterviewType @default(Video)
  interviewerId String
  // Additional panel interviewers beyond the primary `interviewerId`. They
  // receive the same invite email + calendar attendance; the scorecard stays
  // attributed to the primary interviewer.
  additionalInterviewerIds String[] @default([])

  scheduledAt DateTime
  duration    Int      @default(60)
  location    String?
  meetingLink String?

  status            InterviewStatus @default(IntScheduled)
  candidateFeedback String?

  feedbackToken          String?   @unique
  feedbackTokenExpiresAt DateTime?
  feedbackRequestSentAt  DateTime?
  lastReminderAt         DateTime?
  reminderCount          Int       @default(0)

  // Interview scorecard — formerly the separate InterviewScorecard table
  // (1:1, keyed by interviewId). Folded in here. All nullable: an interview
  // has a scorecard once overallRating is set (recommendation submitted).
  overallRating        Int?
  recommendation       InterviewRecommendation?
  criteria             Json?
  strengths            String?
  concerns             String?
  overallComments      String?
  scorecardSubmittedAt DateTime?

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application JobApplication @relation(fields: [applicationId], references: [id])
  interviewer Employee       @relation("Interviewer", fields: [interviewerId], references: [id])

  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, applicationId])
  @@schema("app_quikhrms")
}

