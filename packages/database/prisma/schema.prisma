// ONCE per kind, then applied consistently across every entry of that kind.
model OneTimeStatutoryDefault {
  id       String             @id @default(cuid())
  orgId String
  kind     OneTimeEarningKind

  taxable        Boolean @default(true)
  considerForEPF Boolean @default(false)
  considerForESI Boolean @default(true)
