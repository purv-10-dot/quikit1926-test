/// Audit log. Free-form old/new JSON snapshots, indexed for per-entity
/// history lookup. NOT wrapped around every endpoint in this pass — helper
/// `logAudit()` is opt-in. Future work to wire it broadly.
model CnAuditLog {
  id         String   @id @default(cuid())
  orgId      String
  entityType String
  entityId   String
  action     String // create | update | delete | approve | reject | reverse | status_change
  userId     String
