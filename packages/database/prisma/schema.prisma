  maturityLevel      String?
  notes              String?
  assessedBy         String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  // Multi-user campaign lifecycle (admin launches draft → active → closed).
  // Legacy single-user rows have isLegacy=true and populated habit*_ scores.
  status             String                    @default("draft")
  publishedAt        DateTime?
  closedAt           DateTime?
  deadline           DateTime?
