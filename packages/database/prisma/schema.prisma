  location     String?

  willingToRelocate Boolean  @default(false)
  tags              Json?
  rating            Decimal? @db.Decimal(3, 1)

  status       CandidateStatus @default(New)
  doNotContact Boolean         @default(false)
  gdprConsent  Boolean         @default(false)

