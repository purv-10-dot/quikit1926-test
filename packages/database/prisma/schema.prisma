  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employee Employee    @relation(fields: [employeeId], references: [id])
  shift    ShiftPolicy @relation(fields: [shiftId], references: [id])

  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, employeeId])
  @@schema("app_quikhrms")
}

// ─── DUTY ROSTER ────────────────────────────────────────

enum RosterStatus {
  Draft
  Published
  Archived

  @@schema("app_quikhrms")
}

enum RosterEntryType {
  Duty
  WeekOff
  Leave
  Holiday

  @@schema("app_quikhrms")
}

/// A duty-roster plan for a department/team over a date range.
model Roster {
  id           String       @id @default(cuid())
  orgId     String
  name         String
  departmentId String?
  periodStart  DateTime     @db.Date
  periodEnd    DateTime     @db.Date
  status       RosterStatus @default(Draft)
  publishedAt  DateTime?
  publishedBy  String?

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  entries RosterEntry[]

  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, departmentId])
  @@schema("app_quikhrms")
}

/// One roster cell: an employee's shift / week-off for a single day.
model RosterEntry {
  id         String          @id @default(cuid())
  orgId   String
  rosterId   String
  employeeId String
  date       DateTime        @db.Date
  shiftId    String?
  type       RosterEntryType @default(Duty)
  note       String?

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roster   Roster       @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id])
  shift    ShiftPolicy? @relation(fields: [shiftId], references: [id])

  @@unique([rosterId, employeeId, date])
  @@index([orgId, rosterId])
  @@index([orgId, employeeId])
  @@index([orgId, deletedAt])
  @@schema("app_quikhrms")
}

// ─── LEAVE MANAGEMENT ───────────────────────────────────

model LeaveType {
  id       String  @id @default(cuid())
  orgId String
  name     String
  code     String
  color    String?

  isPaid          Boolean @default(true)
  isCarryForward  Boolean @default(false)
  maxCarryForward Int?
  isEncashable    Boolean @default(false)
  maxEncashment   Int?

  accrualType  LeaveAccrualType @default(Yearly)
  accrualCount Decimal          @default(0) @db.Decimal(5, 2)
  maxBalance   Int              @default(0)

  minConsecutiveDays Int?
  maxConsecutiveDays Int?

  // Frequency caps — max approved leave REQUESTS of this type per period.
  // Null = unlimited. e.g. maxPerMonth=2, maxPerYear=12.
  maxPerMonth Int?
  maxPerYear  Int?

  // Once-in-a-lifetime leave (e.g. Marriage): an employee may take it only a
  // single time, ever. Enforced across all their Pending/Approved requests.
  isOnceInLifetime Boolean @default(false)

  applicableGender         String? // All|Male|Female|Other
  applicableEmploymentType Json?
  applicableAfterDays      Int     @default(0)

  requiresDocumentation  Boolean @default(false)
  documentationAfterDays Int?

  isNegativeBalanceAllowed Boolean @default(false)
  maxNegativeBalance       Int?

  includesHolidays Boolean @default(false)
  includesWeekoffs Boolean @default(false)

  isHalfDayAllowed Boolean @default(true)
  isHourlyAllowed  Boolean @default(false)

  clubbingRestrictions Json?

  isCompOff         Boolean @default(false)
  compOffExpiryDays Int?

  isDefault Boolean @default(false)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  leaveGroupItems LeaveGroupItem[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@schema("app_quikhrms")
}

model LeaveGroup {
  id          String  @id @default(cuid())
  orgId    String
  name        String
  description String?
  isActive    Boolean @default(true)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items       LeaveGroupItem[]
  assignments LeaveGroupAssignment[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([orgId, deletedAt])
  @@schema("app_quikhrms")
}

model LeaveGroupItem {
  id            String   @id @default(cuid())
  orgId      String
  leaveGroupId  String
  leaveTypeId   String
  overrideQuota Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  leaveGroup LeaveGroup @relation(fields: [leaveGroupId], references: [id], onDelete: Cascade)
  leaveType  LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([leaveGroupId, leaveTypeId])
  @@index([orgId, leaveGroupId])
  @@schema("app_quikhrms")
}

model LeaveGroupAssignment {
  id           String @id @default(cuid())
  orgId     String
  leaveGroupId String

  assigneeType String // "Employee" | "Role"
  employeeId   String?
  roleId       String?

  createdBy String?
  createdAt DateTime @default(now())

  leaveGroup LeaveGroup @relation(fields: [leaveGroupId], references: [id], onDelete: Cascade)

  @@unique([leaveGroupId, assigneeType, employeeId, roleId])
  @@index([orgId, leaveGroupId])
  @@index([orgId, employeeId])
  @@index([orgId, roleId])
  @@schema("app_quikhrms")
}

model LeaveRequest {
  id          String @id @default(cuid())
  orgId    String
  employeeId  String
  leaveTypeId String

  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  duration     Decimal  @db.Decimal(5, 2)
  dayBreakdown Json?

  reason      String
  attachments Json?

  status    LeaveRequestStatus @default(Pending)
  appliedOn DateTime           @default(now())

  cancelReason String?
  isPlanned    Boolean @default(true)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employee  Employee        @relation(fields: [employeeId], references: [id])
  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id])
  approvals LeaveApproval[]

  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, employeeId])
  @@index([orgId, status])
  @@index([orgId, startDate, endDate])
  // Performance: my leaves listing + pending approval views
  @@index([orgId, employeeId, status, createdAt(sort: Desc)])
  @@index([orgId, status, deletedAt])
  @@schema("app_quikhrms")
}

model LeaveApproval {
  id             String @id @default(cuid())
  orgId       String
  leaveRequestId String
  approverId     String
  level          Int    @default(1)

  status   LeaveApprovalStatus @default(Pending)
  comment  String?
  actionAt DateTime?

