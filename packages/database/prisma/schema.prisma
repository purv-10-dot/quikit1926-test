// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // multiSchema enables `@@schema(...)` per-model — used to namespace each app.
  // See packages/database/SCHEMA_LAYOUT.md for the per-model placement rules.
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  // Runtime URL — points at the pooler (transaction mode) in prod/uat.
  // Append ?pgbouncer=true&connection_limit=1&pool_timeout=10 when routed via PgBouncer.
  url       = env("DATABASE_URL")
  // Migrations URL — unpooled, so DDL and advisory locks work. Prisma uses this
  // automatically for `prisma migrate` / `prisma db push`.
  // IMPORTANT: Prisma 5.22 does NOT fall back to `url` when this env var is
  // unset — it errors with P1012. Local dev must set DATABASE_URL_DIRECT even
  // when pointing at the same URL as DATABASE_URL (a pooler-less Postgres is
  // its own direct URL).
  directUrl = env("DATABASE_URL_DIRECT")
  // Schema-per-app layout (Pattern A from the architecture brainstorm):
  //   public                  — identity, platform glue, cross-app FKs land here
  //   app_quikscale           — KPI / Priority / WWW / OPSP / Client Meetings
  //   app_quikconstruction    — Cn* construction-ERP tables
  //   app_quikvc              — VC OS: deals, scoring, IC memos, capital
  // admin and quikit have no app-private state — they read from public only.
  schemas   = ["public", "app_quikscale", "app_quikconstruction", "app_quikvc"]
}

// ============================================================================
// APP REGISTRY (Multi-App Platform)
// ============================================================================

model App {
  id          String  @id @default(cuid())
  name        String // "QuikScale"
  slug        String  @unique // "quikscale"
  description String?
  iconUrl     String? // URL or path to app icon
  baseUrl     String // "https://quikscale.vercel.app" or "/" for self
  status      String  @default("active") // active | coming_soon | disabled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAccess   UserAppAccess[]
  oauthClient  OAuthClient?
  moduleFlags  AppModuleFlag[]
  healthChecks AppHealthCheck[]
  tenantAccess TenantAppAccess[]

  @@index([slug])
  @@index([status])
  @@schema("public")
}

// ============================================================================
// OAUTH2 / OIDC — QuikIT as Identity Provider
// ============================================================================

model OAuthClient {
  id           String   @id @default(cuid())
  appId        String   @unique
  clientId     String   @unique // "quikscale", "admin", etc.
  clientSecret String // bcrypt-hashed
  redirectUris String[] // ["http://localhost:3004/api/auth/callback/quikit"]
  scopes       String[] @default(["openid", "profile", "email", "tenant"])
  grantTypes   String[] @default(["authorization_code", "refresh_token"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@schema("public")
}

model OAuthCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  clientId            String
  userId              String
  tenantId            String
  scopes              String[]
  codeChallenge       String? // PKCE S256 challenge
  codeChallengeMethod String? // "S256"
  redirectUri         String
  expiresAt           DateTime
  used                Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([code])
  @@index([expiresAt])
  @@schema("public")
}

model OAuthRefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  accessToken String?  @unique
  clientId    String
  userId      String
  tenantId    String
  scopes      String[]
  expiresAt   DateTime
  revoked     Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([token])
  @@index([accessToken])
  @@index([userId, clientId])
  @@schema("public")
}

model UserAppAccess {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  appId    String
  role     String @default("member") // viewer | member | admin

  grantedBy String?
  grantedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, appId])
  @@index([userId])
  @@index([tenantId])
  @@index([appId])
  @@schema("public")
}

// ============================================================================
// CORE MULTI-TENANT TABLES
// ============================================================================

model Tenant {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  status      String  @default("active")

  fiscalYearStart   Int @default(1)
  quarterStartMonth Int @default(1)
  weekStartDay      Int @default(1)

  logoUrl    String?
  brandColor String? @default("#0066cc")

  plan         String  @default("startup")
  billingEmail String?

  /// Empty = no restriction. Non-empty = POST /api/members must match one
  /// (case-insensitive, no @ prefix — e.g. ["acme.com", "acme.co.uk"]).
  allowedEmailDomains String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  users                   Membership[]
  userAppAccess           UserAppAccess[]
  teams                   Team[]
  userTeams               UserTeam[]
  kpis                    KPI[]
  priorities              Priority[]
  wwwItems                WWWItem[]
  categoryMasters         CategoryMaster[]
  // Client Meetings module — see "CLIENT MEETINGS" section below.
  clients                 Client[]
  clientMembers           ClientMember[]
  clientDailyHuddles      ClientDailyHuddle[]
  clientWeeklyMeetings    ClientWeeklyMeeting[]
  quarterSettings         QuarterSetting[]
  opspDocuments           OPSPDocument[]
  opppPlans               OPSPPlan[]
  opspData                OPSPData[]
  opspReviewEntries       OPSPReviewEntry[]
  accountabilityFunctions AccountabilityFunction[]
  habits                  HabitAssessment[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  featureFlags            FeatureFlag[]
  appModuleFlags          AppModuleFlag[]
  performanceReviews      PerformanceReview[]
  talentAssessments       TalentAssessment[]
  goals                   Goal[]
  oneOnOnes               OneOnOne[]
  feedbackEntries         FeedbackEntry[]
  sessionEvents           SessionEvent[]
  tenantAppAccess         TenantAppAccess[]
  invoices                Invoice[]

  // QuikConstruction module — back-relations (additions per phase)
  cnCompanies            CnCompany[]
  cnVendors              CnVendor[]
  cnCustomers            CnCustomer[]
  cnContractors          CnContractor[]
  cnUoms                 CnUOM[]
  cnItemGroups           CnItemGroup[]
  cnItems                CnItem[]
  cnBanks                CnBank[]
  cnDepartments          CnDepartment[]
  cnWorkCategories       CnWorkCategory[]
  cnCostCenters          CnCostCenter[]
  cnLocations            CnLocation[]
  cnGstCodes             CnGSTCode[]
  cnTdsCodes             CnTDSCode[]
  cnTermsConditions      CnTermsCondition[]
  cnFinancialYears       CnFinancialYear[]
  cnProjects             CnProject[]
  cnMachinery            CnMachinery[]
  cnAssets               CnAsset[]
  // Phase 3 — Procurement + Store
  cnPurchaseRequisitions CnPurchaseRequisition[]
  cnPurchaseOrders       CnPurchaseOrder[]
  cnGRNs                 CnGoodsReceiptNote[]
  cnStockLedger          CnStockLedger[]
  cnMaterialIssues       CnMaterialIssue[]
  // Phase 3b back-relations
  cnPurchaseIndents      CnPurchaseIndent[]
  cnRFQs                 CnRFQ[]
  cnGatePasses           CnGatePass[]
  cnGoodReturns          CnGoodReturn[]
  cnInternalReturns      CnInternalReturn[]
  cnStockTransfers       CnStockTransfer[]
  cnStockReconciliations CnStockReconciliation[]
  cnDieselLogs           CnDieselLog[]
  // Phase 4 — Projects core
  cnBoqs                 CnBOQ[]
  cnDprs                 CnDPR[]
  cnHindrances           CnHindrance[]
  // Phase 4b
  cnEstimations          CnEstimation[]
  cnWorkOrders           CnWorkOrder[]
  cnRabs                 CnRAB[]
  // Phase 5
  cnClientInvoices       CnClientInvoice[]
  cnClientReceipts       CnClientReceipt[]
  cnVendorBills          CnVendorBill[]
  cnVendorPayments       CnVendorPayment[]
  // Phase 7
  cnEmployees            CnEmployee[]
  cnAttendances          CnAttendance[]
  cnPayrolls             CnPayroll[]
  // Phase 8
  cnApprovalRules        CnApprovalRule[]
  cnApprovalRequests     CnApprovalRequest[]
  // Phase 9
  cnQcInspections        CnQCInspection[]
  // Phase 10
  cnSafetyIncidents      CnSafetyIncident[]
  cnSafetyChecklists     CnSafetyChecklist[]
  // Phase 12
  cnDocuments            CnDocument[]
  // Phase 14
  cnExpenses             CnExpense[]
  // Structural gaps
  cnCreditNotes          CnCreditNote[]
  cnDebitNotes           CnDebitNote[]
  cnAuditLogs            CnAuditLog[]
  cnNumberSequences      CnNumberSequence[]

  // QuikVC OS — back-relations (Sprint 1 foundation + Sprint 2 deal workspace)
  vcFundProfile          VCFundProfile?
  vcVerticals            VCVertical[]
  vcScoringCriteria      VCScoringCriterion[]
  vcApplications         VCApplication[]
  vcDeals                VCDeal[]
  vcTimelineEvents       VCTimelineEvent[]
  vcDealDocuments        VCDealDocument[]
  vcDealQuestions        VCDealQuestion[]
  vcDealScores           VCDealScore[]
  vcDealSignals          VCDealSignal[]
  vcICMemos              VCICMemo[]
  vcICMemoVersions       VCICMemoVersion[]
  vcComparableCompanies  VCComparableCompany[]
  vcMeetings             VCMeeting[]
  vcMeetingTranscripts   VCMeetingTranscript[]
  vcICVotes              VCICVote[]
  vcInvestors            VCInvestor[]
  vcCommitments          VCCommitment[]
  vcCapitalCalls         VCCapitalCall[]
  vcDealAllocations      VCDealAllocation[]
  vcRepaymentSchedules   VCRepaymentSchedule[]
  vcRepaymentPayments    VCRepaymentPayment[]
  vcTermSheetTemplates   VCTermSheetTemplate[]
  vcTermSheets           VCTermSheet[]
  vcCapitalCallPayments  VCCapitalCallPayment[]
  vcSourcedOpportunities VCSourcedOpportunity[]
  vcNotifications        VCNotification[]
  vcAuditLogs            VCAuditLog[]

  @@index([slug])
  @@index([status])
  @@schema("public")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  firstName     String
  lastName      String
  avatar        String?
  isSuperAdmin  Boolean   @default(false)

  country     String?
  timezone    String?
  bio         String?
  themeMode   String? @default("light")
  accentColor String? @default("#0066cc")

  kpiFrozenCol       String?
  priorityFrozenCol  String?
  wwwFrozenCol       String?
  kpiHiddenCols      String?
  priorityHiddenCols String?
  wwwHiddenCols      String?
  kpiSort            String?
  prioritySort       String?
  wwwSort            String?
  kpiColWidths       String?
  priorityColWidths  String?
  wwwColWidths       String?

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  appAccess   UserAppAccess[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSignInAt DateTime?

  userTeams               UserTeam[]
  kpisOwned               KPI[]                    @relation("KPIOwner")
  prioritiesOwned         Priority[]               @relation("PriorityOwner")
  kpiNotes                KPINote[]
  opppPlan                OPSPPlan?
  opspData                OPSPData[]
  opspReviewEntries       OPSPReviewEntry[]
  accountabilityFunctions AccountabilityFunction[]
  reviewsGiven            PerformanceReview[]      @relation("ReviewsGiven")
  reviewsReceived         PerformanceReview[]      @relation("ReviewsReceived")
  talentAssessed          TalentAssessment[]       @relation("TalentAssessed")
  talentAssessor          TalentAssessment[]       @relation("TalentAssessor")
  goalsOwned              Goal[]                   @relation("GoalOwner")
  oneOnOnesAsManager      OneOnOne[]               @relation("OneOnOneManager")
  oneOnOnesAsReport       OneOnOne[]               @relation("OneOnOneReport")
  feedbackGiven           FeedbackEntry[]          @relation("FeedbackFrom")
  feedbackReceived        FeedbackEntry[]          @relation("FeedbackTo")
  sessionEvents           SessionEvent[]

  // Client Meetings module
  clientMemberships     ClientMembership[]
  dailyHuddleAbsences   ClientDailyHuddleAbsence[]
  weeklyMeetingAbsences ClientWeeklyMeetingAbsence[]
  weeklyDashboardNAs    ClientWeeklyMeetingDashboardNA[]

  @@index([email])
  @@schema("public")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?  @db.Text
  token_type        String?
  scope             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     String

  teamId            String?
  customPermissions String[]

  invitationToken String?   @unique
  invitedAt       DateTime?
  acceptedAt      DateTime?
  status          String    @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, tenantId, status])
  @@index([teamId])
  @@index([role])
  @@index([tenantId, role])
  @@schema("public")
}

// ── User ↔ Team many-to-many (a user can belong to multiple teams) ──────────

model UserTeam {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, teamId])
  @@index([tenantId])
  @@index([userId])
  @@index([teamId])
  @@schema("public")
}

// ============================================================================
// ORGANIZATIONAL STRUCTURE
// ============================================================================

model Team {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?
  slug        String

  parentTeamId String?
  headId       String?

  color String? @default("#0066cc")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members                 Membership[]
  userTeams               UserTeam[]
  kpis                    KPI[]
  priorities              Priority[]
  parentTeam              Team?                    @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams              Team[]                   @relation("TeamHierarchy")
  accountabilityFunctions AccountabilityFunction[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentTeamId])
  @@index([deletedAt])
  @@schema("public")
}

model AccountabilityFunction {
  id       String @id @default(cuid())
  tenantId String

  name        String
  description String?

  teamId           String?
  parentFunctionId String?
  assignedToUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team           Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedTo     User?                    @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  childFunctions AccountabilityFunction[] @relation("FunctionHierarchy")
  parentFunction AccountabilityFunction?  @relation("FunctionHierarchy", fields: [parentFunctionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([assignedToUserId])
  @@schema("app_quikscale")
}

// ============================================================================
// KPI MODULE
// ============================================================================

model KPI {
  id       String @id @default(cuid())
  tenantId String

  name               String
  description        String?
  kpiLevel           String   @default("individual") // "individual" | "team"
  owner              String?
  // Team KPI owners (multi-select). Each owner has a contribution % stored in ownerContributions.
  ownerIds           String[] @default([])
  // JSON map: { userId: contributionPercentage }  — sum must equal 100 for team KPIs
  ownerContributions Json?
  teamId             String?

  parentKPIId String?

  quarter String @default("Q1")
  year    Int

  measurementUnit  String
  target           Float?
  quarterlyGoal    Float?
  qtdGoal          Float?
  qtdAchieved      Float?
  currentWeekValue Float?
  progressPercent  Float? @default(0)

  status       String @default("active")
  healthStatus String @default("on-track")

  divisionType       String  @default("Cumulative")
  weeklyTargets      Json?
  // Team KPI per-owner weekly targets: { userId: { weekNumber: value } }
  // Source of truth for team KPI breakdowns; weeklyTargets holds the aggregate sum.
  weeklyOwnerTargets Json?
  currency           String?
  targetScale        String?
  reverseColor       Boolean @default(false)

  lastNotes   String?
  lastNotesAt DateTime?
  lastNotedBy String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String?

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner_user   User?            @relation("KPIOwner", fields: [owner], references: [id])
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parentKPI    KPI?             @relation("KPICascade", fields: [parentKPIId], references: [id], onDelete: SetNull)
  childKPIs    KPI[]            @relation("KPICascade")
  weeklyValues KPIWeeklyValue[]
  notes        KPINote[]
  logs         KPILog[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, kpiLevel, deletedAt])
  @@index([owner])
  @@index([teamId])
  @@index([kpiLevel])
  @@index([parentKPIId])
  @@index([status])
  @@index([healthStatus])
  @@index([quarter, year])
  @@schema("app_quikscale")
}

model KPIWeeklyValue {
  id       String  @id @default(cuid())
  tenantId String
  kpiId    String
  // Phase 2: userId attributes this weekly value to a specific user.
  //   - Individual KPI: always set to kpi.owner (enforced by API + backfilled for existing rows)
  //   - Team KPI: set to one of kpi.ownerIds (each owner has their own row per week)
  //   - Legacy rows may be null until migration completes
  userId   String?

  weekNumber Int
  value      Float?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String?

  kpi KPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, userId, weekNumber])
  @@index([tenantId])
  @@index([kpiId])
  @@index([userId])
  @@schema("app_quikscale")
}

model KPINote {
  id       String @id @default(cuid())
  tenantId String
  kpiId    String

  content  String @db.Text
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kpi    KPI  @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([kpiId])
  @@index([authorId])
  @@schema("app_quikscale")
}

model KPILog {
  id       String @id @default(cuid())
  tenantId String
  kpiId    String

  action    String
  oldValue  String? @db.Text
  newValue  String? @db.Text
  changedBy String
  reason    String?

  createdAt DateTime @default(now())

  kpi KPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([kpiId])
  @@index([createdAt])
  @@index([kpiId, createdAt])
  @@schema("app_quikscale")
}

// ============================================================================
// PRIORITY MODULE
// ============================================================================

model Priority {
  id       String @id @default(cuid())
  tenantId String

  name        String
  description String?
  owner       String
  teamId      String?

  quarter   String
  year      Int
  startWeek Int?
  endWeek   Int?

  overallStatus String @default("not-started")

  notes String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner_user     User?                  @relation("PriorityOwner", fields: [owner], references: [id])
  team           Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  weeklyStatuses PriorityWeeklyStatus[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, year, quarter, deletedAt])
  @@index([owner])
  @@index([teamId])
  @@index([quarter, year])
  @@index([tenantId, owner])
  @@index([deletedAt])
  @@schema("app_quikscale")
}

model PriorityWeeklyStatus {
  id         String @id @default(cuid())
  priorityId String

  weekNumber Int
  status     String
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  priority Priority @relation(fields: [priorityId], references: [id], onDelete: Cascade)

  @@unique([priorityId, weekNumber])
  @@index([priorityId])
  @@schema("app_quikscale")
}

// ============================================================================
// WWW MODULE (Who, What, When)
// ============================================================================

model WWWItem {
  id       String @id @default(cuid())
  tenantId String

  who  String
  what String
  when DateTime

  linkedPriorityId String?
  linkedKPIId      String?

  status   String  @default("not-started")
  notes    String? @db.Text
  category String?

  originalDueDate DateTime?
  revisedDates    String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revisionLogs WWWRevisionLog[]

  @@index([tenantId])
  @@index([who])
  @@index([when])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, who])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status, deletedAt])
  @@index([deletedAt])
  @@schema("app_quikscale")
}

model WWWRevisionLog {
  id        String @id @default(cuid())
  wwwItemId String

  oldDueDate DateTime
  newDueDate DateTime
  reason     String?
  changedBy  String

  createdAt DateTime @default(now())

  wwwItem WWWItem @relation(fields: [wwwItemId], references: [id], onDelete: Cascade)

  @@index([wwwItemId])
  @@index([createdAt])
  @@schema("app_quikscale")
}

// ============================================================================
// CATEGORY MASTER
// ============================================================================

model CategoryMaster {
  id       String @id @default(cuid())
  tenantId String

  name        String
  // Lowercased+trimmed mirror of `name` for case-insensitive uniqueness.
  // Populated by application code on every write; required by the DB constraint.
  nameKey     String
  dataType    String // "Number" | "Percentage" | "Currency"
  currency    String? // e.g. "INR", "USD" — only when dataType = "Currency"
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Uniqueness: (tenantId, lowercased name, dataType, currency)
  // Two rows with the same case-insensitive name can coexist only if their
  // (dataType, currency) tuple differs. "Revenue (Number)" and "Revenue (Currency/USD)" OK.
  @@unique([tenantId, nameKey, dataType, currency], name: "category_tenant_name_type_currency_uniq")
  @@index([tenantId])
  @@index([dataType])
  @@schema("app_quikscale")
}

// ============================================================================
// CLIENT MEETINGS (Meeting Rhythm)
// ============================================================================
//
// Rewrite of the legacy team-meeting module. Models the cadence a tenant
// runs with each of its external *clients* (e.g. "Foods & Inns"):
//   - Client              → the external organisation
//   - ClientMembership    → User ↔ Client assignment with client-specific role
//   - ClientDailyHuddle   → a single daily huddle instance
//   - ClientWeeklyMeeting → a single weekly review instance + per-member KPI
//
// Ports the logic from the GOAL LCNC app (see meetingrythm.md). No JSON
// blobs for queryable data — per-meeting member scores are their own table.

/// Radio-style tri-state used by every format / punctuality / quality flag.
enum ClientMeetingFlag {
  YES
  NO
  NA

  @@schema("app_quikscale")
}

/// Call status for daily huddles and weekly meetings.
enum ClientMeetingStatus {
  HELD
  NOT_HELD
  CALL_CANCELLED_BY_CLIENT
  HOLIDAY_FOR_CLIENT
  HOLIDAY_FOR_SUCCESS_ALCHEMIST

  @@schema("app_quikscale")
}

model Client {
  id       String @id @default(cuid())
  tenantId String

  name        String
  description String?   @db.Text
  isActive    Boolean   @default(true)
  startDate   DateTime?

  /// Planned weekly meeting window (HH:mm 24h).
  weeklyStartTime String?
  weeklyEndTime   String?

  /// Planned daily huddle window (HH:mm 24h).
  dailyStartTime String?
  dailyEndTime   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships    ClientMembership[]
  /// Client's external team members (from ClientMember entity — spec §2 multiplelookup).
  teamMembers    ClientTeamMember[]
  dailyHuddles   ClientDailyHuddle[]
  weeklyMeetings ClientWeeklyMeeting[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([deletedAt])
  @@schema("app_quikscale")
}

/// Many-to-many link between a Client and its external team members
/// (ClientMember rows). Separate from ClientMembership (which links to tenant
/// Users for permission purposes) — here we're modelling who-the-client-invites.
model ClientTeamMember {
  clientId       String
  clientMemberId String
  tenantId       String
  createdAt      DateTime @default(now())

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  member ClientMember @relation(fields: [clientMemberId], references: [id], onDelete: Cascade)

  @@id([clientId, clientMemberId])
  @@index([clientMemberId])
  @@index([tenantId])
  @@schema("app_quikscale")
}

model ClientMembership {
  id       String @id @default(cuid())
  tenantId String
  clientId String
  userId   String

  /// Client-specific role (e.g. "Account Manager", "SPOC"). Separate from tenant role.
  clientRole String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([tenantId])
  @@index([clientId])
  @@index([userId])
  @@schema("app_quikscale")
}

/// Standalone Client Member entity (spec §3). Flat list of name + email
/// records — the "Client Members" page is a simple data-entry table. These
/// are distinct from tenant Users (which handle login/auth).
///
/// Future integration point: Client Master's multi-lookup picker will pick
/// from these records instead of (or in addition to) tenant Users.
model ClientMember {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  email     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant            Tenant                               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientLinks       ClientTeamMember[]
  dailyAbsences     ClientDailyHuddleTeamAbsence[]
  weeklyAbsences    ClientWeeklyMeetingTeamAbsence[]
  weeklyDashboardNA ClientWeeklyMeetingTeamDashboardNA[]
  weeklyScores      ClientWeeklyMemberScore[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([email])
  @@schema("app_quikscale")
}

model ClientDailyHuddle {
  id       String @id @default(cuid())
  tenantId String
  clientId String

  meetingDate DateTime
  callStatus  ClientMeetingStatus @default(HELD)

  /// Actual observed start/end (HH:mm 24h). Blank when call not held.
  actualStartTime String?
  actualEndTime   String?

  /// Three format checks + a punctuality override radio (see meetingrythm.md §4).
  format1Status       ClientMeetingFlag @default(NA)
  format2Status       ClientMeetingFlag @default(NA)
  stuckCallStatus     ClientMeetingFlag @default(NA)
  punctualityOverride ClientMeetingFlag @default(NA)

  /// Snapshot of invited roster size at meeting time (used in attendance math).
  totalMembers Int @default(0)

  /// Rich-text notes captured in the drawer (image 1).
  notes            String? @db.Text
  notesKPDashboard String? @db.Text
  otherNotes       String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client                         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Legacy tenant-User-based absence (kept for older dashboard math).
  absentMembers     ClientDailyHuddleAbsence[]
  /// New external-roster absences — picked from ClientMember.
  absentTeamMembers ClientDailyHuddleTeamAbsence[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([clientId])
  @@index([meetingDate])
  @@index([clientId, meetingDate])
  @@index([clientId, deletedAt, meetingDate])
  @@index([deletedAt])
  @@schema("app_quikscale")
}

model ClientDailyHuddleAbsence {
  huddleId String
  userId   String

  huddle ClientDailyHuddle @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([huddleId, userId])
  @@index([userId])
  @@schema("app_quikscale")
}

/// Per-huddle absence link for external Client Members (distinct from the
/// legacy tenant-User link above). Used by the Daily Huddle drawer.
model ClientDailyHuddleTeamAbsence {
  huddleId       String
  clientMemberId String

  huddle ClientDailyHuddle @relation(fields: [huddleId], references: [id], onDelete: Cascade)
  member ClientMember      @relation(fields: [clientMemberId], references: [id], onDelete: Cascade)

  @@id([huddleId, clientMemberId])
  @@index([clientMemberId])
  @@schema("app_quikscale")
}

model ClientWeeklyMeeting {
  id       String @id @default(cuid())
  tenantId String
  clientId String

  meetingDate DateTime
  callStatus  ClientMeetingStatus @default(HELD)

  /// Overall actual start/end (HH:mm).
  actualStartTime String?
  actualEndTime   String?

  /// Segment timings (7 slots — mirrors spec's time-2..time-8).
  /// Null = segment skipped. HH:mm strings.
  segmentTime1 String?
  segmentTime2 String?
  segmentTime3 String?
  segmentTime4 String?
  segmentTime5 String?
  segmentTime6 String?
  segmentTime7 String?

  /// Radio flags — order matches the form spec (Good News → OPSP Review).
  /// Each pairs with segmentTime1..7 for "<flag> Time" companion field.
  goodNewsSharing        ClientMeetingFlag @default(NA)
  kpDashboard            ClientMeetingFlag @default(NA)
  gaps                   ClientMeetingFlag @default(NA)
  www                    ClientMeetingFlag @default(NA)
  feedback               ClientMeetingFlag @default(NA)
  collectiveIntelligence ClientMeetingFlag @default(NA)
  opspReview             ClientMeetingFlag @default(NA)

  notesKPDashboard String? @db.Text
  otherNotes       String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant                 Tenant                               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                 Client                               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  absentMembers          ClientWeeklyMeetingAbsence[]
  absentTeamMembers      ClientWeeklyMeetingTeamAbsence[]
  dashboardNAMembers     ClientWeeklyMeetingDashboardNA[]
  dashboardNATeamMembers ClientWeeklyMeetingTeamDashboardNA[]
  memberScores           ClientWeeklyMemberScore[]
  logs                   ClientWeeklyMeetingLog[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([clientId])
  @@index([meetingDate])
  @@index([clientId, meetingDate])
  @@index([clientId, deletedAt, meetingDate])
  @@index([deletedAt])
  @@schema("app_quikscale")
}

model ClientWeeklyMeetingAbsence {
  meetingId String
  userId    String

  meeting ClientWeeklyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@schema("app_quikscale")
}

model ClientWeeklyMeetingDashboardNA {
  meetingId String
  userId    String

  meeting ClientWeeklyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@schema("app_quikscale")
}

/// Per-meeting absence link for external Client Members (mirrors the
/// Daily Huddle TeamAbsence pattern). Used by the Weekly Meeting drawer's
/// Absent Members picker when the client roster is external.
model ClientWeeklyMeetingTeamAbsence {
  meetingId      String
  clientMemberId String

  meeting ClientWeeklyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  ClientMember        @relation(fields: [clientMemberId], references: [id], onDelete: Cascade)

  @@id([meetingId, clientMemberId])
  @@index([clientMemberId])
  @@schema("app_quikscale")
}

/// Per-meeting "Weekly Dashboard NA" link for external Client Members.
model ClientWeeklyMeetingTeamDashboardNA {
  meetingId      String
  clientMemberId String

  meeting ClientWeeklyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  ClientMember        @relation(fields: [clientMemberId], references: [id], onDelete: Cascade)

  @@id([meetingId, clientMemberId])
  @@index([clientMemberId])
  @@schema("app_quikscale")
}

/// Audit trail for ClientWeeklyMeeting (mirrors KPILog).
/// One row per CREATE / UPDATE field-level change / DELETE / RESTORE.
model ClientWeeklyMeetingLog {
  id        String @id @default(cuid())
  tenantId  String
  meetingId String

  action    String
  oldValue  String? @db.Text
  newValue  String? @db.Text
  changedBy String
  reason    String?

  createdAt DateTime @default(now())

  meeting ClientWeeklyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([meetingId])
  @@index([createdAt])
  @@index([meetingId, createdAt])
  @@schema("app_quikscale")
}

/// Per-member KPI scores captured inside a weekly meeting drawer.
/// Keyed on ClientMember (external roster) — that's what the Update tab
/// displays. Was historically keyed on User; migrated when external
/// Team Members became the canonical source of "who is on this client".
model ClientWeeklyMemberScore {
  id             String @id @default(cuid())
  meetingId      String
  clientMemberId String

  kpiWeeklyQTD         Int @default(0)
  kpiCoding            Int @default(0)
  priorityNotes        Int @default(0)
  priorityStartEndDate Int @default(0)
  priorityColor        Int @default(0)

  updatedAt DateTime @updatedAt

  meeting ClientWeeklyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  ClientMember        @relation(fields: [clientMemberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, clientMemberId])
  @@index([clientMemberId])
  @@schema("app_quikscale")
}

// ============================================================================
// OPSP MODULE (One-Page Strategic Plan)
// ============================================================================

// ============================================================================
// OPSP DATA (Create OPSP Form — all fields)
// ============================================================================

model OPSPData {
  id          String @id @default(cuid())
  tenantId    String
  userId      String
  year        Int
  quarter     String // Q1 | Q2 | Q3 | Q4
  status      String @default("draft") // draft | finalized
  targetYears Int    @default(5) // 3 or 5

  // PEOPLE
  employees    Json? // String[3]
  customers    Json? // String[3]
  shareholders Json? // String[3]

  // CORE VALUES / PURPOSE
  coreValues String? @db.Text
  purpose    String? @db.Text
  actions    Json? // String[5]
  profitPerX String?
  bhag       String? @db.Text

  // TARGETS (3-5 yrs)
  targetRows       Json? // [{category,projected,y1,y2,y3,y4,y5}]
  sandbox          String? @db.Text
  keyThrusts       Json? // [{desc,owner}] ×5
  brandPromiseKPIs String? @db.Text
  brandPromise     String? @db.Text

  // GOALS (1 yr)
  goalRows              Json? // [{category,projected,q1,q2,q3,q4}]
  keyInitiatives        Json? // [{desc, owner}] ×5 — 1 Year Priorities, matches keyThrusts shape
  criticalNumGoals      Json? // {title,bullets:String[4]}
  balancingCritNumGoals Json?

  // People-section bottom
  processItems Json? // String[3]
  weaknesses   Json? // String[3]

  // PROCESS section
  makeBuy       Json? // String[3]
  sell          Json? // String[3]
  recordKeeping Json? // String[3]

  // ACTIONS QTR
  actionsQtr              Json? // [{category,projected}] ×5
  rocks                   Json? // [{desc, owner}] ×5 — Quarterly Priorities (matches keyInitiatives shape)
  criticalNumProcess      Json?
  balancingCritNumProcess Json?

  // THEME
  theme            String? @db.Text
  scoreboardDesign String? @db.Text
  celebration      String? @db.Text
  reward           String? @db.Text

  // YOUR ACCOUNTABILITY
  kpiAccountability    Json? // [{kpi,goal}] ×5
  quarterlyPriorities  Json? // [{priority,dueDate}] ×5
  criticalNumAcct      Json?
  balancingCritNumAcct Json?

  // TRENDS
  trends Json? // String[6]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String?

  reviewEntries OPSPReviewEntry[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, year, quarter])
  @@index([tenantId])
  @@index([userId])
  @@index([year, quarter])
  @@schema("app_quikscale")
}

// ============================================================================
// OPSP REVIEW ENTRIES (Achieved actuals tracked per period per category)
// ============================================================================

model OPSPReviewEntry {
  id            String   @id @default(cuid())
  tenantId      String
  opspId        String
  userId        String // who entered/last updated this value
  horizon       String // "quarter" | "yearly" | "3to5year"
  rowIndex      Int // index in source array (actionsQtr[0], goalRows[1], etc.)
  category      String // denormalized from OPSP for query convenience
  period        String // "m1"|"m2"|"m3" | "q1"|"q2"|"q3"|"q4" | "y1"|"y2"|"y3"|"y4"|"y5"
  targetValue   Decimal? @db.Decimal(20, 4) // snapshot of OPSP target at review time
  achievedValue Decimal? @db.Decimal(20, 4)
  comment       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opsp   OPSPData @relation(fields: [opspId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, opspId, horizon, rowIndex, period])
  @@index([tenantId])
  @@index([opspId])
  @@index([userId])
  @@schema("app_quikscale")
}

model OPSPDocument {
  id       String @id @default(cuid())
  tenantId String

  year          Int
  versionNumber Int    @default(1)
  status        String @default("draft")

  sections OPSPSection[]

  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, versionNumber])
  @@index([tenantId])
  @@index([status])
  @@schema("app_quikscale")
}

model OPSPSection {
  id         String @id @default(cuid())
  documentId String

  sectionType String
  content     String  @db.Text
  notes       String? @db.Text

  stakeholderType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  document OPSPDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sectionType])
  @@schema("app_quikscale")
}

// ============================================================================
// OPSPPlan MODULE (Personal Planning - 4x3 Grid)
// ============================================================================

model OPSPPlan {
  id       String @id @default(cuid())
  tenantId String
  userId   String @unique

  relationships_long String? @db.Text
  relationships_1yr  String? @db.Text
  relationships_90d  String? @db.Text

  achievements_long String? @db.Text
  achievements_1yr  String? @db.Text
  achievements_90d  String? @db.Text

  rituals_long String? @db.Text
  rituals_1yr  String? @db.Text
  rituals_90d  String? @db.Text

  wealth_long String? @db.Text
  wealth_1yr  String? @db.Text
  wealth_90d  String? @db.Text

  tags String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@schema("app_quikscale")
}

// ============================================================================
// ROCKEFELLER HABITS MODULE
// ============================================================================

model HabitAssessment {
  id       String @id @default(cuid())
  tenantId String

  assessmentDate DateTime
  quarter        String
  year           Int

  habit1_vision      Int
  habit2_meetings    Int
  habit3_scoreboards Int
  habit4_accountable Int
  habit5_rhythm      Int
  habit6_sticking    Int
  habit7_cascading   Int
  habit8_recognition Int
  habit9_training    Int
  habit10_innovation Int

  averageScore  Float?
  maturityLevel String?

  notes      String? @db.Text
  assessedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quarter, year])
  @@index([assessmentDate])
  // Per-tenant quarterly dashboard. Applied CONCURRENTLY — P1-3.
  @@index([tenantId, quarter, year])
  @@schema("app_quikscale")
}

// ============================================================================
// NOTIFICATIONS & AUDIT
// ============================================================================

model Notification {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  title   String
  message String @db.Text
  type    String

  relatedEntityId   String?
  relatedEntityType String?

  read   Boolean   @default(false)
  readAt DateTime?

  channel String @default("in_app")

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([read])
  // Inbox unread query: WHERE tenantId=? AND userId=? AND read=false
  // Applied as CREATE INDEX CONCURRENTLY — see P1-3 migration.
  @@index([tenantId, userId, read])
  @@schema("public")
}

model AuditLog {
  id       String @id @default(cuid())
  tenantId String

  action     String
  entityType String
  entityId   String

  oldValues String?  @db.Text
  newValues String?  @db.Text
  changes   String[]

  actorId   String
  actorRole String?

  reason    String?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@schema("public")
}

model FeatureFlag {
  id       String @id @default(cuid())
  tenantId String

  name        String
  description String?
  key         String

  enabled        Boolean @default(false)
  rolloutPercent Int?
  value          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@schema("public")
}

// ============================================================================
// QUARTER SETTINGS
// ============================================================================

model QuarterSetting {
  id         String   @id @default(cuid())
  tenantId   String
  fiscalYear Int
  quarter    String // Q1 | Q2 | Q3 | Q4
  startDate  DateTime
  endDate    DateTime
  // Lifecycle: upcoming (not yet started) | active (current, open for edits)
  // | completed (closed, locked for edits). Drives year-picker filtering and
  // write-gate on KPI/Priority/WWW updates for past quarters.
  status     String   @default("active") // upcoming | active | completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fiscalYear, quarter])
  @@index([tenantId])
  @@index([fiscalYear])
  @@index([status])
  @@schema("app_quikscale")
}

// ============================================================================
// PERFORMANCE MODULE
// ============================================================================

model PerformanceReview {
  id         String @id @default(cuid())
  tenantId   String
  reviewerId String
  revieweeId String
  quarter    String
  year       Int

  kpiScore        Float?
  priorityScore   Float?
  attendanceScore Float?
  overallScore    Float?

  rating       Int?
  strengths    String? @db.Text
  improvements String? @db.Text
  notes        String? @db.Text

  status String @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewer User   @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User   @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@index([tenantId])
  @@index([revieweeId])
  // Per-reviewee history & period aggregates. Applied CONCURRENTLY — P1-3.
  @@index([tenantId, revieweeId, year, quarter])
  @@schema("app_quikscale")
}

// ============================================================================
// TALENT ASSESSMENT
// ============================================================================

model TalentAssessment {
  id         String @id @default(cuid())
  tenantId   String
  userId     String
  assessorId String

  potential       String @default("medium") // low | medium | high
  flightRisk      String @default("low") // low | medium | high
  successionReady String @default("not-ready") // not-ready | developing | ready-now

  skills           String[]
  developmentNotes String?  @db.Text

  quarter String
  year    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation("TalentAssessed", fields: [userId], references: [id])
  assessor User   @relation("TalentAssessor", fields: [assessorId], references: [id])

  @@unique([tenantId, userId, quarter, year])
  @@index([tenantId])
  @@index([userId])
  @@schema("app_quikscale")
}

// ============================================================================
// GOALS / OKRs  (R10f — People workflow, quarterly/annual)
// ============================================================================

model Goal {
  id           String  @id @default(cuid())
  tenantId     String
  ownerId      String // the person the goal belongs to
  parentGoalId String? // optional hierarchy (company → team → individual)

  title       String
  description String? @db.Text
  category    String? // "business" | "personal" | "team" | custom

  // Measurement
  targetValue     Float?
  currentValue    Float?  @default(0)
  unit            String? // "%", "$", "users", etc.
  progressPercent Float?  @default(0) // computed client-side or on update

  // Timebox
  quarter String? // Q1 | Q2 | Q3 | Q4 (null = annual)
  year    Int

  // State machine
  status String @default("draft") // draft | active | on-track | at-risk | completed | abandoned

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String
  completedAt DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner      User   @relation("GoalOwner", fields: [ownerId], references: [id])
  parentGoal Goal?  @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  childGoals Goal[] @relation("GoalHierarchy")

  @@index([tenantId])
  @@index([ownerId])
  @@index([tenantId, year, quarter])
  @@index([parentGoalId])
  @@schema("app_quikscale")
}

// ============================================================================
// 1:1 MEETINGS  (R10g — People workflow)
// ============================================================================

model OneOnOne {
  id       String @id @default(cuid())
  tenantId String

  managerId String
  reportId  String

  scheduledAt DateTime
  duration    Int      @default(30) // minutes

  // Record-keeping fields (same pattern as Meeting model)
  talkingPoints String? @db.Text // what to discuss
  actionItems   String? @db.Text // commitments made
  notes         String? @db.Text // free-form manager or report notes
  mood          String? // "green" | "yellow" | "red" — optional emotional check-in

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager User   @relation("OneOnOneManager", fields: [managerId], references: [id])
  report  User   @relation("OneOnOneReport", fields: [reportId], references: [id])

  @@index([tenantId])
  @@index([managerId])
  @@index([reportId])
  @@index([scheduledAt])
  @@schema("app_quikscale")
}

// ============================================================================
// CONTINUOUS FEEDBACK  (R10h — People workflow, Lattice-style)
// ============================================================================

model FeedbackEntry {
  id       String @id @default(cuid())
  tenantId String

  fromUserId String
  toUserId   String

  category   String // "kudos" | "coaching" | "concern" | "general"
  visibility String @default("private") // private (only to+from) | shared (visible to toUser's manager)
  content    String @db.Text

  // Optional linkage — allows "feedback about this priority" or "about this meeting"
  relatedType String? // "priority" | "meeting" | "kpi" | null
  relatedId   String?

  createdAt DateTime @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromUser User   @relation("FeedbackFrom", fields: [fromUserId], references: [id])
  toUser   User   @relation("FeedbackTo", fields: [toUserId], references: [id])

  @@index([tenantId])
  @@index([toUserId])
  @@index([fromUserId])
  @@index([tenantId, toUserId, createdAt])
  @@schema("app_quikscale")
}

// ============================================================================
// APP MODULE FLAGS (FF-1) — per-tenant module gating
// ============================================================================
//
// Sparse storage: row exists iff a module is explicitly DISABLED for the
// given tenant × app. Absence of a row = module is enabled (the default).
//
// The canonical list of moduleKeys lives in packages/shared/lib/moduleRegistry.ts.
// Enforcement: sidebar filters by registry + disabled-set; layout.tsx gates
// redirect; API handlers return 404 when a disabled moduleKey is targeted.
// See docs/plans/FF-1-app-feature-flags.md for the full design.

model AppModuleFlag {
  id        String   @id @default(cuid())
  tenantId  String
  appId     String
  moduleKey String // e.g. "kpi", "kpi.teams", "opsp.review"
  enabled   Boolean  @default(false) // only stored when disabled; kept for future flexibility
  updatedBy String? // super admin user id
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId, moduleKey])
  @@index([tenantId, appId])
  @@schema("public")
}

// ============================================================================
// SUPER ADMIN — PHASE A INSTRUMENTATION
// Event capture layer that feeds analytics dashboards, health checks, alerts,
// session tracking, broadcasts, tenant-app gating, and plan/invoice data.
// See docs/plans/SA-A-instrumentation.md for the product plan.
// ============================================================================

/// Raw log of every API request across all apps. 30-day retention policy
/// (cleanup cron at /api/super/cron/cleanup-api-calls). Aggregated hourly
/// into ApiCallHourlyRollup for long-term trend analysis.
model ApiCall {
  id          String   @id @default(cuid())
  tenantId    String? // null for pre-auth calls (login, OAuth flow)
  userId      String?
  appSlug     String // "quikit" | "quikscale" | "admin"
  method      String // GET | POST | PUT | PATCH | DELETE
  path        String // full request path, no query string
  pathPattern String // normalized: /api/kpi/[id] instead of /api/kpi/cl...
  statusCode  Int
  durationMs  Int
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([appSlug, createdAt])
  @@index([createdAt]) // retention cleanup
  @@index([userId, createdAt])
  @@schema("public")
}

/// Hourly aggregation of ApiCall rows. Source of truth for all per-tenant
/// analytics older than a few hours. Populated by /api/super/cron/rollup-api-calls.
model ApiCallHourlyRollup {
  id              String   @id @default(cuid())
  tenantId        String?
  appSlug         String
  hourBucket      DateTime // truncated to the hour (UTC)
  method          String
  pathPattern     String
  statusClass     String // "2xx" | "3xx" | "4xx" | "5xx"
  callCount       Int      @default(0)
  errorCount      Int      @default(0) // non-2xx
  totalDurationMs BigInt   @default(0) // sum, for avg calc
  maxDurationMs   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, appSlug, hourBucket, method, pathPattern, statusClass])
  @@index([tenantId, hourBucket])
  @@index([appSlug, hourBucket])
  @@index([hourBucket])
  @@schema("public")
}

/// Uptime probe record. Written by /api/super/cron/health-check which pings
/// each registered app's /api/health endpoint every 5 minutes.
model AppHealthCheck {
  id         String   @id @default(cuid())
  appId      String
  status     String // "up" | "down" | "degraded"
  statusCode Int? // HTTP response code, null on network error
  durationMs Int?
  error      String?  @db.Text
  checkedAt  DateTime @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, checkedAt])
  @@index([checkedAt])
  @@schema("public")
}

/// Auth lifecycle events — feeds DAU/MAU and "last login" on tenant health panel.
/// Appended to on login, logout, and (future) impersonation start/end.
model SessionEvent {
  id        String   @id @default(cuid())
  tenantId  String? // null during pre-org-selection flow
  userId    String
  event     String // "login" | "logout" | "impersonation_start" | "impersonation_end"
  appSlug   String? // which app the user signed into (for cross-app DAU)
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([event, createdAt])
  @@schema("public")
}

/// Platform-wide announcement banner shown to tenants. Managed via super admin
/// broadcast UI. Empty targetTenantIds = all tenants; empty targetAppSlugs = all apps.
model BroadcastAnnouncement {
  id              String    @id @default(cuid())
  title           String
  body            String    @db.Text
  severity        String    @default("info") // "info" | "warning" | "critical"
  targetTenantIds String[]
  targetAppSlugs  String[]
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  createdBy       String // super admin user id
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dismissals BroadcastDismissal[]

  @@index([startsAt])
  @@index([endsAt])
  @@schema("public")
}

/// Per-user dismissal tracking — once dismissed, the banner doesn't resurface.
model BroadcastDismissal {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  dismissedAt    DateTime @default(now())

  announcement BroadcastAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@schema("public")
}

/// Hard gate: if enabled=false the tenant cannot access this app at all,
/// regardless of AppModuleFlag state. Evaluated first in the auth/route flow.
/// Sparse: row exists only when explicitly toggled off (default = enabled).
model TenantAppAccess {
  id        String   @id @default(cuid())
  tenantId  String
  appId     String
  enabled   Boolean  @default(true)
  reason    String? // optional reason shown to tenant (e.g. "trial expired")
  updatedBy String? // super admin user id
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId])
  @@index([tenantId])
  @@index([appId])
  @@schema("public")
}

/// Plan definitions as data (replaces the current hardcoded "startup|growth|enterprise"
/// strings). Tenant.plan still stores the slug — no FK enforced yet so existing rows
/// don't break when a plan is deleted. Migration path: add FK after backfill.
model Plan {
  id           String   @id @default(cuid())
  slug         String   @unique // matches Tenant.plan
  name         String
  description  String?  @db.Text
  priceMonthly Int      @default(0) // cents, avoids Decimal precision issues
  priceYearly  Int      @default(0)
  currency     String   @default("USD")
  limits       Json? // { "maxUsers": 10, "maxKPIs": 50, "maxApps": 3 }
  features     String[] // free-form feature tags
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@schema("public")
}

/// SA-D — Impersonation session record.
///
/// A super admin clicks "View as" on a tenant, which creates one of these
/// rows with a short-lived single-use token. The target app validates the
/// token, signs the super admin in AS the target user (with the
/// impersonation flag carried in the JWT), and deletes the token.
///
/// All actions during impersonation are tagged with impersonatingSuperAdminId
/// in the audit log so customer-support activity is distinguishable from
/// user activity.
model Impersonation {
  id             String    @id @default(cuid())
  /// User who initiated the impersonation (a platform super admin).
  superAdminId   String
  /// The tenant whose app is being accessed.
  targetTenantId String
  /// The user whose identity will be assumed (usually an org admin).
  targetUserId   String
  /// Which app to land in after token exchange ("quikscale" | "admin").
  targetAppSlug  String
  /// Opaque single-use token — 32-byte base64url. Consumed on accept.
  token          String    @unique
  /// Absolute expiry — rejected after this regardless of usage.
  expiresAt      DateTime
  /// Populated when the token is redeemed; null means still pending.
  acceptedAt     DateTime?
  /// Populated when the super admin explicitly exits the session.
  exitedAt       DateTime?
  /// Free-form reason captured at start time for audit.
  reason         String?
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@index([superAdminId, createdAt])
  @@index([targetTenantId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([expiresAt])
  @@schema("public")
}

/// Platform alerts raised by the alerts engine cron. Super admins see these
/// as a dismissable list on the Analytics dashboard. Sparse — rows only
/// exist for currently-firing conditions. Resolved alerts are soft-deleted
/// by setting resolvedAt.
model PlatformAlert {
  id             String    @id @default(cuid())
  rule           String // "app_down" | "api_error_spike" | "payment_failed" | "tenant_inactive"
  severity       String    @default("warning") // "info" | "warning" | "critical"
  title          String
  message        String    @db.Text
  /// Free-form identifier for the alert subject (appId, tenantId, etc) — used
  /// for dedupe so the same condition doesn't fire twice.
  subjectKey     String
  /// Optional link for click-through ("/organizations/<tenantId>")
  link           String?
  data           Json? // raw metrics that triggered the alert
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([resolvedAt])
  @@index([severity, lastSeenAt])
  @@index([rule, subjectKey, resolvedAt])
  @@schema("public")
}

/// Invoice records. Dummy payment flow in Phase B writes these via the
/// super admin's "Mark paid" / "Mark failed" buttons. No real Stripe yet —
/// externalId column is there for future integration.
model Invoice {
  id          String    @id @default(cuid())
  tenantId    String
  planSlug    String // snapshot of plan at invoice time (history-safe)
  amountCents Int
  currency    String    @default("USD")
  status      String    @default("pending") // "pending" | "paid" | "failed" | "refunded"
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  failedAt    DateTime?
  notes       String?   @db.Text
  externalId  String? // stripe subscription/invoice id, future use
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([status])
  @@index([periodEnd])
  @@schema("public")
}

