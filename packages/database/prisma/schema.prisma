  notes         String?
  mood          String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String
  manager       User      @relation("OneOnOneManager", fields: [managerId], references: [id])
  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  report        User      @relation("OneOnOneReport", fields: [reportId], references: [id])

  @@index([orgId])
  @@index([managerId])
  @@index([reportId])
  @@index([scheduledAt])
  @@schema("app_quikscale")
}

model FeedbackEntry {
  id          String   @id @default(cuid())
  orgId       String
  fromUserId  String
  toUserId    String
  category    String
  visibility  String   @default("private")
  content     String
  relatedType String?
  relatedId   String?
  createdAt   DateTime @default(now())
  fromUser    User     @relation("FeedbackFrom", fields: [fromUserId], references: [id])
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  toUser      User     @relation("FeedbackTo", fields: [toUserId], references: [id])

  @@index([orgId])
  @@index([toUserId])
  @@index([fromUserId])
  @@index([orgId, toUserId, createdAt])
  @@schema("app_quikscale")
}

/// Radio-style tri-state used by every format / punctuality / quality flag.
enum ClientMeetingFlag {
  YES
  NO
  NA

  @@schema("app_quikscale")
}

/// Call status for daily huddles and weekly meetings.
enum ClientMeetingStatus {
  HELD
  NOT_HELD
  CALL_CANCELLED_BY_CLIENT
  HOLIDAY_FOR_CLIENT
  HOLIDAY_FOR_SUCCESS_ALCHEMIST
  OTHER

  @@schema("app_quikscale")
}

// <------------------------------------------> quikscale schema end <------------------------------------------->

model Notification {
  id                String    @id @default(cuid())
  orgId             String
  userId            String
  title             String
  message           String
  type              String
  relatedEntityId   String?
  relatedEntityType String?
  read              Boolean   @default(false)
  readAt            DateTime?
  channel           String    @default("in_app")
  createdAt         DateTime  @default(now())
  org               Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@index([read])
  @@index([orgId, userId, read])
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  action     String
  entityType String
  entityId   String
  oldValues  String?
  newValues  String?
  changes    String[]
  actorId    String
  actorRole  String?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([orgId, createdAt])
  @@schema("public")
}

model FeatureFlag {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  description    String?
  key            String
  enabled        Boolean  @default(false)
  rolloutPercent Int?
  value          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId])
  @@schema("public")
}

model AppModuleFlag {
  id        String   @id @default(cuid())
  orgId     String
  appId     String
  moduleKey String
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, appId, moduleKey])
  @@index([orgId, appId])
  @@schema("public")
}

/// Raw log of every API request across all apps. 30-day retention policy
/// (cleanup cron at /api/super/cron/cleanup-api-calls). Aggregated hourly
/// into ApiCallHourlyRollup for long-term trend analysis.
model ApiCall {
  id          String   @id @default(cuid())
  orgId       String?
  userId      String?
  appSlug     String
  method      String
  path        String
  pathPattern String
  statusCode  Int
  durationMs  Int
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([appSlug, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@schema("public")
}

/// Hourly aggregation of ApiCall rows. Source of truth for all per-tenant
/// analytics older than a few hours. Populated by /api/super/cron/rollup-api-calls.
model ApiCallHourlyRollup {
  id              String   @id @default(cuid())
  orgId           String?
  appSlug         String
  hourBucket      DateTime
  method          String
  pathPattern     String
  statusClass     String
  callCount       Int      @default(0)
  errorCount      Int      @default(0)
  totalDurationMs BigInt   @default(0)
  maxDurationMs   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, appSlug, hourBucket, method, pathPattern, statusClass])
  @@index([orgId, hourBucket])
  @@index([appSlug, hourBucket])
  @@index([hourBucket])
  @@schema("public")
}

/// Uptime probe record. Written by /api/super/cron/health-check which pings
/// each registered app's /api/health endpoint every 5 minutes.
model AppHealthCheck {
  id         String   @id @default(cuid())
  appId      String
  status     String
  statusCode Int?
  durationMs Int?
  error      String?
  checkedAt  DateTime @default(now())
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, checkedAt])
  @@index([checkedAt])
  @@schema("public")
}

/// Auth lifecycle events — feeds DAU/MAU and "last login" on tenant health panel.
/// Appended to on login, logout, and (future) impersonation start/end.
model SessionEvent {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String
  event     String
  appSlug   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  org       Org?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([event, createdAt])
  @@schema("public")
}

/// Authentication / security audit trail. Co-located with SessionEvent in the
/// shared `public` schema because authentication is centralized in
/// packages/auth across all apps. Captures login success/failure, logout,
/// password reset/change, session revoke, and (future) MFA events. userId is
/// nullable so failed logins for unknown emails are still recorded.
model AuthLog {
  id        String   @id @default(cuid())
  userId    String?
  orgId     String?
  email     String? // attempted email — useful for login_failure with unknown user
  event     String // login_success|login_failure|logout|password_reset_requested|password_reset_completed|password_changed|session_revoke|mfa_enrolled|mfa_challenge_success|mfa_challenge_failure|mfa_disabled
  outcome   String   @default("success") // success|failure
  reason    String? // failure/detail code, e.g. "invalid_credentials", "rate_limited"
  appSlug   String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  org       Org?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
  @@schema("public")
}

/// Platform-wide announcement banner shown to tenants. Managed via super admin
/// broadcast UI. Empty targetOrgIds = all tenants; empty targetAppSlugs = all apps.
model BroadcastAnnouncement {
  id             String               @id @default(cuid())
  title          String
  body           String
  severity       String               @default("info")
  targetOrgIds   String[]
  targetAppSlugs String[]
  startsAt       DateTime             @default(now())
  endsAt         DateTime?
  createdBy      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  dismissals     BroadcastDismissal[]

  @@index([startsAt])
  @@index([endsAt])
  @@schema("public")
}

/// Per-user dismissal tracking — once dismissed, the banner doesn't resurface.
model BroadcastDismissal {
  id             String                @id @default(cuid())
  announcementId String
  userId         String
  dismissedAt    DateTime              @default(now())
  announcement   BroadcastAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@schema("public")
}

/// Hard gate: if enabled=false the tenant cannot access this app at all,
/// regardless of AppModuleFlag state. Evaluated first in the auth/route flow.
/// Sparse: row exists only when explicitly toggled off (default = enabled).
model OrgAppAccess {
  id          String    @id @default(cuid())
  orgId       String
  appId       String
  enabled     Boolean   @default(true)
  reason      String?
  /// Per-app free-trial expiry for self-serve activation. null = no trial
  /// (grandfathered access granted by an admin, or an upgraded/paid app) →
  /// treated as active. A future date = trialing; a past date = expired.
  trialEndsAt DateTime?
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  app         App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, appId])
  @@index([orgId])
  @@index([appId])
  @@schema("quikit")
}

/// Per-org subscription / trial state (self-serve registration). Additive: an
/// org with NO Subscription row is implicitly grandfathered (treated as active)
/// by every read path, so the pre-existing orgs are never gated. Self-serve
/// registrations start as `trialing` with a 14-day `trialEndsAt`. References
/// public.Plan.slug by value only (no FK — mirrors the Org.plan convention).
model Subscription {
  id               String    @id @default(cuid())
  orgId            String    @unique
  status           String    @default("trialing") // trialing|active|past_due|canceled|expired
  planSlug         String    @default("startup")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  source           String? // self_serve_registration|backfill|super_admin
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  org              Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([trialEndsAt])
  @@schema("quikit")
}

/// Plan definitions as data (replaces the current hardcoded "startup|growth|enterprise"
/// strings). Tenant.plan still stores the slug — no FK enforced yet so existing rows
/// don't break when a plan is deleted. Migration path: add FK after backfill.
model Plan {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  priceMonthly Int      @default(0)
  priceYearly  Int      @default(0)
  currency     String   @default("USD")
  limits       Json?
  features     String[]
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@schema("public")
}

/// SA-D — Impersonation session record.
///
/// A super admin clicks "View as" on a tenant, which creates one of these
/// rows with a short-lived single-use token. The target app validates the
/// token, signs the super admin in AS the target user (with the
/// impersonation flag carried in the JWT), and deletes the token.
///
/// All actions during impersonation are tagged with impersonatingSuperAdminId
/// in the audit log so customer-support activity is distinguishable from
/// user activity.
model Impersonation {
  id            String    @id @default(cuid())
  /// User who initiated the impersonation (a platform super admin).
  superAdminId  String
  /// The tenant whose app is being accessed.
  targetOrgId   String
  /// The user whose identity will be assumed (usually an org admin).
  targetUserId  String
  /// Which app to land in after token exchange ("quikscale" | "admin").
  targetAppSlug String
  /// Opaque single-use token — 32-byte base64url. Consumed on accept.
  token         String    @unique
  /// Absolute expiry — rejected after this regardless of usage.
  expiresAt     DateTime
  /// Populated when the token is redeemed; null means still pending.
  acceptedAt    DateTime?
  /// Populated when the super admin explicitly exits the session.
  exitedAt      DateTime?
  /// Free-form reason captured at start time for audit.
  reason        String?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([superAdminId, createdAt])
  @@index([targetOrgId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([expiresAt])
  @@schema("public")
}

/// Platform alerts raised by the alerts engine cron. Super admins see these
/// as a dismissable list on the Analytics dashboard. Sparse — rows only
/// exist for currently-firing conditions. Resolved alerts are soft-deleted
/// by setting resolvedAt.
model PlatformAlert {
  id             String    @id @default(cuid())
  rule           String
  severity       String    @default("warning")
  title          String
  message        String
  /// Free-form identifier for the alert subject (appId, orgId, etc) — used
  /// for dedupe so the same condition doesn't fire twice.
  subjectKey     String
  /// Optional link for click-through ("/organizations/<orgId>")
  link           String?
  data           Json?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([resolvedAt])
  @@index([severity, lastSeenAt])
  @@index([rule, subjectKey, resolvedAt])
  @@schema("public")
}

/// Invoice records. Dummy payment flow in Phase B writes these via the
/// super admin's "Mark paid" / "Mark failed" buttons. No real Stripe yet —
/// externalId column is there for future integration.
model Invoice {
  id          String    @id @default(cuid())
  orgId       String
  planSlug    String
  amountCents Int
  currency    String    @default("USD")
  status      String    @default("pending")
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  failedAt    DateTime?
  notes       String?
  externalId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, status])
  @@index([status])
  @@index([periodEnd])
  @@schema("public")
}

