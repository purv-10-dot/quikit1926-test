model QtIssueType {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  color      String    @default("#64748b")
  icon       String?
  orderIndex Int       @default(0)
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
