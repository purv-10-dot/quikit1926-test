}

/// Per-user OPSP sections. The strategic OPSP (PEOPLE/PROCESS/Targets/Goals/…)
/// stays org-shared in OPSPData (canonical owner), but these four sections are
/// owned by each individual user: Your Accountability, Quarterly Priorities,
/// Critical # and Balanced Critical #. Keyed by (orgId, userId, year, quarter).
/// Finalize/lock is still driven org-wide by OPSPData.status.
model OPSPUserSection {
  id                   String   @id @default(cuid())
  orgId                String
  userId               String
  year                 Int
  quarter              String
  kpiAccountability    Json?
  quarterlyPriorities  Json?
  criticalNumAcct      Json?
  balancingCritNumAcct Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String
  updatedBy            String?
  org                  Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, year, quarter])
  @@index([orgId])
  @@index([userId])
  @@index([year, quarter])
  @@schema("app_quikscale")
}

model OPSPReviewEntry {
  id                 String   @id @default(cuid())
  orgId              String
  opspId             String
  userId             String
  horizon            String
  rowIndex           Int
  category           String
  period             String
  targetValue        Decimal? @db.Decimal(20, 4)
  achievedValue      Decimal? @db.Decimal(20, 4)
  // Manually-entered "Last Year Same Period" — only populated when the prior
  // year's OPSPReviewEntry doesn't supply an auto value (in which case the
  // drawer disables the field). See app/api/opsp/review/route.ts.
  lastYearSamePeriod Decimal? @db.Decimal(20, 4)
  comment            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  updatedBy          String?
  opsp               OPSPData @relation(fields: [opspId], references: [id], onDelete: Cascade)
  org                Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, opspId, horizon, rowIndex, period])
  @@index([orgId])
  @@index([opspId])
  @@index([userId])
  @@schema("app_quikscale")
}

model OPSPDocument {
  id            String        @id @default(cuid())
  orgId         String
  year          Int
  versionNumber Int           @default(1)
  status        String        @default("draft")
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String
  updatedBy     String?
  org           Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
