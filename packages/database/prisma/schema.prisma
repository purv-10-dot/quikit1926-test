}

model CnAttendance {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  projectId   String?
  date        DateTime
  status      String // P | A | HD | L
  hoursWorked Decimal? @db.Decimal(5, 2)
  remarks     String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String?

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee CnEmployee @relation(fields: [employeeId], references: [id])
  project  CnProject? @relation(fields: [projectId], references: [id])

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([date])
  @@schema("app_quikconstruction")
}

model CnPayroll {
  id          String    @id @default(cuid())
  tenantId    String
  runNumber   String
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("draft") // draft | finalized | paid
  totalGross  Decimal   @default(0) @db.Decimal(18, 2)
  totalNet    Decimal   @default(0) @db.Decimal(18, 2)
  remarks     String?
  finalizedAt DateTime?
  finalizedBy String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  CnPayrollLine[]

  @@unique([tenantId, runNumber])
  @@index([tenantId])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnPayrollLine {
  id          String   @id @default(cuid())
  payrollId   String
  employeeId  String
  daysPresent Decimal? @db.Decimal(5, 2)
  hoursWorked Decimal? @db.Decimal(8, 2)
  basicAmount Decimal  @db.Decimal(18, 2)
  deductions  Decimal  @default(0) @db.Decimal(18, 2)
  netAmount   Decimal  @db.Decimal(18, 2)
