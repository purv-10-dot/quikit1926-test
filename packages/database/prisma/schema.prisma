model HrmsSurvey {
  id    String @id @default(cuid())
  orgId String

  title  String
  type   SurveyType   @default(Engagement)
  status SurveyStatus @default(SurveyDraft)

  questions Json
  audience  Json?

  isAnonymous Boolean  @default(true)
  startDate   DateTime
  endDate     DateTime
  recurrence  String?

  responseRate Decimal @default(0) @db.Decimal(5, 2)

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  responses HrmsSurveyResponse[]

  @@index([orgId])
  @@index([orgId, deletedAt])
  @@index([orgId, status])
  @@map("Survey")
  @@schema("app_quikhrms")
}

model HrmsSurveyResponse {
  id         String  @id @default(cuid())
  orgId      String
  surveyId   String
  employeeId String?

  answers     Json
  submittedAt DateTime @default(now())

  survey   HrmsSurvey @relation(fields: [surveyId], references: [id])
  employee Employee?  @relation(fields: [employeeId], references: [id])

  // A PARTIAL unique index on (orgId, surveyId, employeeId) WHERE employeeId IS
  // NOT NULL dedups IDENTIFIED responses. Prisma can't express partial unique
  // indexes, so it is maintained via raw SQL:
  //   CREATE UNIQUE INDEX "SurveyResponse_orgId_surveyId_employeeId_key"
  //     ON "app_quikhrms"."SurveyResponse" ("orgId","surveyId","employeeId")
  //     WHERE "employeeId" IS NOT NULL;
  // Anonymous dedup uses the separate SurveyRespondent table below.
  @@index([orgId, surveyId])
  @@map("SurveyResponse")
  @@schema("app_quikhrms")
}

/// Records WHO responded to a survey, kept SEPARATE from SurveyResponse so
/// anonymous answers stay unlinked to the person. Enforces one response per
/// (survey, employee) — including anonymous surveys. Written via raw SQL from
/// the respond route.
model HrmsSurveyRespondent {
  id          String   @id @default(cuid())
  orgId       String
  surveyId    String
  employeeId  String
  respondedAt DateTime @default(now())

  @@unique([orgId, surveyId, employeeId])
  @@index([orgId, surveyId])
  @@map("SurveyRespondent")
  @@schema("app_quikhrms")
}

