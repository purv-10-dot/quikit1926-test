}

model QfGstReconciliationItem {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  org_id              String
  period_month        Int
  period_year         Int
  supplier_gstin      String
  supplier_name       String?
  invoice_number      String?
  invoice_date        DateTime? @db.Date
  taxable_value_books Decimal?  @db.Decimal(20, 2)
  tax_books           Decimal?  @db.Decimal(20, 2)
  taxable_value_2b    Decimal?  @db.Decimal(20, 2)
  tax_2b              Decimal?  @db.Decimal(20, 2)
  status              String    @default("unmatched")
  notes               String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@index([org_id, period_year, period_month])
  @@map("gst_reconciliation_items")
  @@schema("app_quikfinance")
}

// ═══════════════════════════════════════════════════════════════════════════
// QUIKASSET (asset management) — restored from AssetManagement branch (afed028e)
//
// Fully self-contained: every model carries a plain `orgId` (and `appId` for
// RBAC) string for tenant isolation, with NO Prisma relations to the shared
// quikit.App / quikit.Org models. This keeps the integration purely additive —
// adding/removing this block never touches another app's tables. Physical
// table names are @@map-ed so they read naturally inside the app_quikasset
// schema. Business dates are stored as "YYYY-MM-DD" strings (lexical compare);
// record timestamps are real DateTime. (See apps/Asset Management/docs.)
// ─────────────────────────────────────────────────────────────────────────

enum AstStatus {
  Active
  Inactive

  @@schema("app_quikasset")
}

enum AstAssetStatus {
  Available
  Assigned
  InRepair
  Retired

  @@schema("app_quikasset")
}

enum AstRepairStatus {
  Pending
  InRepair
  Repaired
  Recovered
  Unrepairable

  @@schema("app_quikasset")
}

enum AstAssignmentStatus {
  Active
  Returned

  @@schema("app_quikasset")
}

enum AstAssetRequestKind {
  Physical
  Subscription

  @@schema("app_quikasset")
}

enum AstAssetRequestType {
  New
  Replacement
  Upgrade
  Additional

  @@schema("app_quikasset")
}

enum AstAssetRequestPriority {
  Low
  Medium
  High
  Urgent

  @@schema("app_quikasset")
}

enum AstAssetRequestStatus {
  Draft
  Submitted
  PendingApproval
  Approved
  Rejected
  PartiallyFulfilled
  Fulfilled
  Cancelled

  @@schema("app_quikasset")
}

enum AstRepairRequestStatus {
  Submitted
  Approved
  Rejected
  Fulfilled
  Cancelled

  @@schema("app_quikasset")
}

enum AstRepairRequestUrgency {
  Low
  Medium
  High
  Urgent

  @@schema("app_quikasset")
}

/// Employee directory (asset HOLDERS) — distinct from the platform login User.
model AstEmployee {
  id          String          @id @default(cuid())
  orgId       String
  employeeId  String
  name        String
  email       String
  contact     String?
  department  String?
  designation String?
  joiningDate String?
  status      AstStatus       @default(Active)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  assignments AstAssignment[]
  replacements AstReplacement[]

  @@unique([orgId, employeeId])
  @@unique([orgId, email])
  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("employees")
  @@schema("app_quikasset")
}

/// Soft-delete marker for "removed from QuikAsset". A row here hides the user
/// from the merged Users list AND denies QuikAsset access (auth layer), without
/// destroying any User/OrgMember/UserAppAccess/AstUserAppRole/AstEmployee data.
model AstUserRemoval {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  removedAt DateTime @default(now())
  removedBy String?

  @@unique([orgId, userId])
  @@index([orgId])
  @@map("user_removals")
  @@schema("app_quikasset")
}

model AstBaseCategory {
  id         String        @id @default(cuid())
  orgId      String
  name       String
  categories AstCategory[]
  assets     AstAsset[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("base_categories")
  @@schema("app_quikasset")
}

model AstCategory {
  id             String          @id @default(cuid())
  orgId          String
  name           String
  baseCategoryId String
  baseCategory   AstBaseCategory @relation(fields: [baseCategoryId], references: [id], onDelete: Cascade)
  assets         AstAsset[]

  @@unique([orgId, name, baseCategoryId])
  @@index([orgId])
  @@index([baseCategoryId])
  @@map("categories")
  @@schema("app_quikasset")
}

model AstAsset {
  id                   String           @id @default(cuid())
  orgId                String
  warehouse            String?
  assetType            String
  baseCategoryId       String
  baseCategory         AstBaseCategory  @relation(fields: [baseCategoryId], references: [id])
  categoryId           String
  category             AstCategory      @relation(fields: [categoryId], references: [id])
  itemName             String
  itemCode             String
  serialNumber         String
  invoiceNumber        String
  price                Float?
  purchaseDate         String
  location             String
  condition            String
  warrantyEndDate      String?
  description          String
  invoiceFileKey       String?
  invoiceFileName      String?
  invoiceFileType      String?
  invoiceFileSize      Int?
  assetStatus          AstAssetStatus   @default(Available)
  // Platform User.id of whoever added this asset ("Added by"). Plain string, no
  // FK — same convention as AstAssetRequest.requesterUserId; full history lives
  // in AstAuditLog.
  createdByUserId      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  assignments          AstAssignment[]
  repairs              AstRepair[]
  repairRequests       AstRepairRequest[]
  replacementsReceived AstReplacement[] @relation("ReplacementAsset")

  @@unique([orgId, itemCode])
  @@unique([orgId, serialNumber])
  @@index([orgId])
  @@index([orgId, assetStatus])
  @@index([baseCategoryId])
  @@index([categoryId])
  @@map("assets")
  @@schema("app_quikasset")
}

model AstRepair {
  id               String           @id @default(cuid())
  orgId            String
  assetId          String
  asset            AstAsset         @relation(fields: [assetId], references: [id])
  issueTitle       String
  issueDescription String
  // Legacy free-text vendor — kept as a fallback for old repairs; superseded by
  // the vendorId FK below (new repairs pick a vendor). Do not drop yet.
  vendor           String?
  vendorId         String?
  vendorRef        AstVendor?       @relation(fields: [vendorId], references: [id])
  estimatedCost    Float?
  actualCost       Float?
  sentDate         String
  expectedReturn   String?
  returnedDate     String?
  status           AstRepairStatus  @default(Pending)
  notes            String?
  // Platform User.id of whoever logged/sent this repair ("Sent to repair by").
  createdByUserId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  replacements     AstReplacement[]
  repairRequests   AstRepairRequest[]

  @@index([orgId])
  @@index([assetId])
  @@index([vendorId])
  @@map("repairs")
  @@schema("app_quikasset")
}

/// Vendor / supplier master (minimal — no GST/PAN/bank/SLA/ratings/purchase
/// history yet; those depend on Procurement). Linked from AstRepair.vendorId.
model AstVendor {
  id            String          @id @default(cuid())
  orgId         String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  status        AstVendorStatus @default(Active)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  repairs       AstRepair[]

  @@index([orgId])
  @@map("vendors")
  @@schema("app_quikasset")
}

enum AstVendorStatus {
  Active
  Inactive

  @@schema("app_quikasset")
}

/// A loaner asset given to an employee while their asset is in repair.
model AstReplacement {
  id        String      @id @default(cuid())
  orgId     String
  repairId  String
  repair    AstRepair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  assetId   String
  asset     AstAsset    @relation("ReplacementAsset", fields: [assetId], references: [id])
  userId    String
  user      AstEmployee @relation(fields: [userId], references: [id])
  type      String
  startDate String
  endDate   String?
  notes     String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@index([orgId])
  @@index([repairId])
  @@index([assetId])
  @@index([userId])
  @@map("replacements")
  @@schema("app_quikasset")
}

model AstAssignment {
  id             String              @id @default(cuid())
  orgId          String
  assetId        String
  asset          AstAsset            @relation(fields: [assetId], references: [id])
  userId         String
  user           AstEmployee         @relation(fields: [userId], references: [id])
  condition      String
  expectedReturn String?
  notes          String?
  // Platform User.id of whoever performed this assignment ("Assigned by").
  // Distinct from `userId`, which is the AstEmployee the asset is assigned TO.
  assignedByUserId String?
  status         AstAssignmentStatus @default(Active)
  assignedAt     DateTime            @default(now())
  returnedAt     DateTime?
  requestId      String?
  request        AstAssetRequest?    @relation(fields: [requestId], references: [id])

  @@index([orgId])
  @@index([assetId])
  @@index([userId])
  @@index([requestId])
  @@map("assignments")
  @@schema("app_quikasset")
}

/// Employee-raised asset request (Module 1). Physical requests fulfil by
/// creating an AstAssignment (see `fulfilments`); subscription requests fulfil
/// status-only with a `fulfilmentNote`. baseCategoryId/categoryId are loose
/// references to Category Master (no FK) — itemType is the free-text item name.
model AstAssetRequest {
  id                String                  @id @default(cuid())
  orgId             String
  requesterUserId   String
  itemKind          AstAssetRequestKind     @default(Physical)
  itemType          String
  baseCategoryId    String?
  categoryId        String?
  requestType       AstAssetRequestType
  quantity          Int                     @default(1)
  quantityFulfilled Int                     @default(0)
  justification     String
  priority          AstAssetRequestPriority @default(Medium)
  requiredBy        String?
  status            AstAssetRequestStatus   @default(Draft)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  decisionNote      String?
  fulfilmentNote    String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  fulfilments       AstAssignment[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([requesterUserId])
  @@map("asset_requests")
  @@schema("app_quikasset")
}

/// Employee-raised repair request. An employee reports a fault on ONE of their
/// own assigned assets (`assetId`); an approver reviews it and, on approval,
/// "sends to repair" — creating a real AstRepair (`repairId`/`repair`) and
/// flipping the asset to InRepair, mirroring how AstAssetRequest fulfils into an
/// AstAssignment. `requesterUserId` is a plain column (the platform User.id, the
/// same scoping column AstAssetRequest uses), joined to AstEmployee for display
/// name in app code. Vendor/cost/dates are NOT employee-facing — the approver
/// supplies them at "send to repair" time on the created AstRepair.
model AstRepairRequest {
  id               String                  @id @default(cuid())
  orgId            String
  requesterUserId  String
  assetId          String
  asset            AstAsset                @relation(fields: [assetId], references: [id])
  issueTitle       String
  issueDescription String
  urgency          AstRepairRequestUrgency @default(Medium)
  status           AstRepairRequestStatus  @default(Submitted)
  reviewedByUserId String?
  reviewedAt       DateTime?
  decisionNote     String?
  repairId         String?
  repair           AstRepair?              @relation(fields: [repairId], references: [id])
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([orgId])
  @@index([orgId, status])
  @@index([requesterUserId])
  @@index([assetId])
  @@index([repairId])
  @@map("repair_requests")
  @@schema("app_quikasset")
}

model AstFiscalBudget {
  id         String  @id @default(cuid())
  orgId      String
  fiscalYear String
  q1Amount   Float   @default(0)
  q2Amount   Float   @default(0)
  q3Amount   Float   @default(0)
  q4Amount   Float   @default(0)
  notes      String?

  @@unique([orgId, fiscalYear])
  @@index([orgId])
  @@map("fiscal_budgets")
  @@schema("app_quikasset")
}

/// Append-only audit trail (audit() helper never throws).
model AstAuditLog {
  id         String   @id @default(cuid())
  orgId      String
  module     String
  action     String
  entityId   String
  entityName String
  details    String?
  actorId    String?
  actorEmail String?
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([orgId, createdAt])
  @@index([orgId, module])
  @@map("audit_logs")
  @@schema("app_quikasset")
}

// ── RBAC v2 (mirrors the shared AppRole/UserAppRole/RolePermission pattern) ──

model AstAppRole {
  id          String              @id @default(cuid())
  orgId       String
  appId       String
  name        String
  description String?
  isSystem    Boolean             @default(false)
  isDefault   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   String?
  permissions AstRolePermission[]
  navigations AstRoleNavigation[]
  members     AstUserAppRole[]

  @@unique([orgId, appId, name])
  @@index([orgId, appId])
  @@map("AppRole")
  @@schema("app_quikasset")
}

model AstRolePermission {
  id       String     @id @default(cuid())
  roleId   String
  resource String
  action   String
  role     AstAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("RolePermission")
  @@schema("app_quikasset")
}

model AstRoleNavigation {
  id     String     @id @default(cuid())
  roleId String
  navKey String
  role   AstAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, navKey])
  @@index([roleId])
  @@map("RoleNavigation")
  @@schema("app_quikasset")
}

model AstUserAppRole {
  id         String     @id @default(cuid())
  userId     String
  orgId      String
  roleId     String
  assignedAt DateTime   @default(now())
  assignedBy String?
  role       AstAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, roleId])
  @@index([roleId])
  @@index([userId, orgId])
  @@map("UserAppRole")
  @@schema("app_quikasset")
}

model AstUserPermissionExtra {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  resource  String
  action    String
  grantedBy String?
  createdAt DateTime @default(now())

  @@unique([orgId, userId, resource, action])
  @@index([userId, orgId])
  @@map("UserPermissionExtra")
  @@schema("app_quikasset")
}

// ============================================================================
// QuikSupport (app_quiksupport) — helpdesk/ticketing domain (integrated from
// the standalone helpdesk-mgt app). Models are Hd*-prefixed (Prisma model/enum
// names are global) and @@map to the original snake_case table names.
// HdTenant.id holds the QuikIT orgId; HdUser.external_id holds the QuikIT
// user id. Identity arrives from the shared session (see apps/quiksupport
// lib/helpdesk-context.ts) — rows are auto-provisioned on first access.
// ============================================================================

enum HdUserRole {
  HELPDESK_ADMIN
  CATEGORY_LEAD
  AGENT
  CUSTOMER

  @@schema("app_quiksupport")
}

enum HdTicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed

  @@schema("app_quiksupport")
}

enum HdTicketPriority {
  low
  medium
  high
  critical

  @@schema("app_quiksupport")
}

enum HdTicketSource {
  portal
  widget
  api
  email

  @@schema("app_quiksupport")
}

enum HdMessageType {
  customer_reply
  agent_reply
  internal_note
  status_update
  system

  @@schema("app_quiksupport")
}

enum HdNotificationEvent {
  ticket_created
  ticket_assigned
  status_changed
  new_message
  sla_at_risk
  sla_breached
  ticket_resolved

  @@schema("app_quiksupport")
}

enum HdMappingStatus {
  active
  inactive
  suspended

  @@schema("app_quiksupport")
}

enum HdOperatingMode {
  integrated
  standalone

  @@schema("app_quiksupport")
}

model HdTenant {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  logo_url   String?
  accent     String   @default("#10B981")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  apps        HdApp[]
  users       HdUser[]
  categories  HdCategory[]
  tickets     HdTicket[]
  sla_configs HdSlaConfig[]
  audit_logs  HdAuditLog[]

  @@map("tenants")
  @@schema("app_quiksupport")
}

model HdApp {
  id         String   @id @default(cuid())
  tenant_id  String
  name       String
  code       String
  icon       String   @default("📦")
  color      String   @default("#6366F1")
  accent     String   @default("#EEF2FF")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant          HdTenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tickets         HdTicket[]
  category_agents HdCategoryAgent[]

  @@unique([tenant_id, code])
  @@map("apps")
  @@schema("app_quiksupport")
}

model HdUser {
  id          String     @id @default(cuid())
  tenant_id   String
  external_id String
  name        String
  email       String
  role        HdUserRole @default(CUSTOMER)
  title       String?
  avatar_url  String?
  color       String     @default("#6366F1")
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  tenant           HdTenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tickets_created  HdTicket[]        @relation("HdTicketRequester")
  tickets_assigned HdTicket[]        @relation("HdTicketAssignee")
  messages         HdMessage[]
  status_history   HdStatusHistory[]
  category_entries HdCategoryAgent[]
  notifications    HdNotification[]
  audit_logs       HdAuditLog[]
  attachments      HdAttachment[]

  @@unique([tenant_id, external_id])
  @@index([tenant_id, email])
  @@map("users")
  @@schema("app_quiksupport")
}

model HdCategory {
  id          String   @id @default(cuid())
  tenant_id   String
  name        String
  icon        String   @default("📁")
  description String?
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant        HdTenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  subcategories HdSubcategory[]
  agents        HdCategoryAgent[]
  tickets       HdTicket[]
  sla_configs   HdSlaConfig[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("categories")
  @@schema("app_quiksupport")
}

model HdSubcategory {
  id          String   @id @default(cuid())
  category_id String
  name        String
  description String?
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  category HdCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  tickets  HdTicket[]

  @@map("subcategories")
  @@schema("app_quiksupport")
}

model HdCategoryAgent {
  id          String   @id @default(cuid())
  category_id String
  tenant_id   String
  app_id      String?
  user_id     String
  is_lead     Boolean  @default(false)
  created_at  DateTime @default(now())

  category HdCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  app      HdApp?     @relation(fields: [app_id], references: [id], onDelete: Cascade)
  user     HdUser     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([category_id, app_id, user_id])
  @@index([category_id, tenant_id])
  @@map("category_agents")
  @@schema("app_quiksupport")
}

model HdTicket {
  id                String           @id @default(cuid())
  ticket_number     String           @unique
  tenant_id         String
  app_id            String
  category_id       String?
  subcategory_id    String?
  requester_id      String
  assigned_to_id    String?
  subject           String
  description       String?          @db.Text
  status            HdTicketStatus   @default(open)
  priority          HdTicketPriority @default(medium)
  source            HdTicketSource   @default(portal)
  tags              String[]         @default([])
  sla_due_at        DateTime?
  first_response_at DateTime?
  resolved_at       DateTime?
  closed_at         DateTime?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  tenant         HdTenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  app            HdApp             @relation(fields: [app_id], references: [id])
  category       HdCategory?       @relation(fields: [category_id], references: [id])
  subcategory    HdSubcategory?    @relation(fields: [subcategory_id], references: [id])
  requester      HdUser            @relation("HdTicketRequester", fields: [requester_id], references: [id])
  assignee       HdUser?           @relation("HdTicketAssignee", fields: [assigned_to_id], references: [id])
  messages       HdMessage[]
  status_history HdStatusHistory[]
  attachments    HdAttachment[]
  notifications  HdNotification[]

  @@index([tenant_id, status])
  @@index([tenant_id, app_id])
  @@index([tenant_id, assigned_to_id])
  @@index([tenant_id, requester_id])
  @@index([sla_due_at])
  @@map("tickets")
  @@schema("app_quiksupport")
}

model HdMessage {
  id           String        @id @default(cuid())
  ticket_id    String
  sender_id    String
  body         String        @db.Text
  message_type HdMessageType
  is_internal  Boolean       @default(false)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  ticket HdTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  sender HdUser   @relation(fields: [sender_id], references: [id])

  @@index([ticket_id])
  @@map("messages")
  @@schema("app_quiksupport")
}

model HdAttachment {
  id          String   @id @default(cuid())
  ticket_id   String
  uploaded_by String
  file_name   String
  file_url    String
  file_size   Int
  mime_type   String
  created_at  DateTime @default(now())

  ticket   HdTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  uploader HdUser   @relation(fields: [uploaded_by], references: [id])

  @@index([ticket_id])
  @@map("attachments")
  @@schema("app_quiksupport")
}

model HdStatusHistory {
  id            String          @id @default(cuid())
  ticket_id     String
  changed_by_id String
  from_status   HdTicketStatus?
  to_status     HdTicketStatus
  note          String?
  changed_at    DateTime        @default(now())

  ticket     HdTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  changed_by HdUser   @relation(fields: [changed_by_id], references: [id])

  @@index([ticket_id])
  @@map("status_history")
  @@schema("app_quiksupport")
}

model HdSlaConfig {
  id                 String           @id @default(cuid())
  tenant_id          String
  category_id        String?
  priority           HdTicketPriority
  first_response_hrs Float
  resolve_hrs        Float
  is_active          Boolean          @default(true)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  tenant   HdTenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category HdCategory? @relation(fields: [category_id], references: [id])

  @@unique([tenant_id, category_id, priority])
  @@index([tenant_id])
  @@map("sla_configs")
  @@schema("app_quiksupport")
}

model HdNotification {
  id         String              @id @default(cuid())
  user_id    String
  ticket_id  String?
  event      HdNotificationEvent
  title      String
  body       String
  is_read    Boolean             @default(false)
  email_sent Boolean             @default(false)
  created_at DateTime            @default(now())

  user   HdUser    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ticket HdTicket? @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
  @@schema("app_quiksupport")
}

model HdRole {
  id          String   @id @default(cuid())
  tenant_id   String?
  name        String
  description String?
  is_system   Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  role_permissions HdRolePermission[]
  user_mappings    HdUserMapping[]

  @@index([tenant_id])
  @@map("roles")
  @@schema("app_quiksupport")
}

model HdPermission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  resource    String
  action      String
  created_at  DateTime @default(now())

  role_permissions HdRolePermission[]

  @@map("permissions")
  @@schema("app_quiksupport")
}

model HdRolePermission {
  id            String   @id @default(cuid())
  role_id       String
  permission_id String
  granted_at    DateTime @default(now())
  granted_by    String?

  role       HdRole       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission HdPermission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@map("role_permissions")
  @@schema("app_quiksupport")
}

model HdUserMapping {
  id         String          @id @default(cuid())
  user_id    String
  tenant_id  String
  app_id     String          @default("")
  role_id    String
  status     HdMappingStatus @default(active)
  mode       HdOperatingMode @default(integrated)
  metadata   Json?
  created_by String?
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  role HdRole @relation(fields: [role_id], references: [id])

  @@unique([user_id, tenant_id, app_id])
  @@index([tenant_id, user_id])
  @@index([role_id])
  @@map("user_mappings")
  @@schema("app_quiksupport")
}

model HdAuditLog {
  id         String   @id @default(cuid())
  tenant_id  String
  user_id    String
  entity     String
  entity_id  String
  action     String
  changes    Json?
  ip_address String?
  created_at DateTime @default(now())

  tenant HdTenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   HdUser   @relation(fields: [user_id], references: [id])

  @@index([tenant_id, entity, entity_id])
  @@map("audit_logs")
  @@schema("app_quiksupport")
}

// ─── QuikSupport standard per-app RBAC (login-roles doc §5.1) ────────────────
// Canonical QuikIT in-app role tables, same shape/role as quikscale's AppRole
// family and quiktrack's Qt* set. Prefixed Qsp* (model names are global);
// @@map to the canonical table names the admin portal reads via raw SQL
// (`app_quiksupport."AppRole"`, etc.). orgId/appId/userId are SCALARS (no FK to
// the central App/Org/User models — matches quikforms/quikasset) so the shared
// models are untouched. This is the QuikIT permission layer; the helpdesk's own
// Hd* roles remain the in-app domain RBAC.

model QspAppRole {
  id          String   @id @default(cuid())
  orgId       String
  appId       String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  navigations QspRoleNavigation[]
  permissions QspRolePermission[]
  members     QspUserAppRole[]

  @@unique([orgId, appId, name])
  @@index([orgId, appId])
  @@map("AppRole")
  @@schema("app_quiksupport")
}

model QspRolePermission {
  id       String     @id @default(cuid())
  roleId   String
  resource String
  action   String
  role     QspAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("RolePermission")
  @@schema("app_quiksupport")
}

model QspRoleNavigation {
  id     String     @id @default(cuid())
  roleId String
  navKey String
  role   QspAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, navKey])
  @@index([roleId])
  @@map("RoleNavigation")
  @@schema("app_quiksupport")
}

model QspUserAppRole {
  id         String     @id @default(cuid())
  userId     String
  orgId      String
  roleId     String
  assignedAt DateTime   @default(now())
  assignedBy String?
  role       QspAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, roleId])
  @@index([roleId])
  @@index([userId, orgId])
  @@map("UserAppRole")
  @@schema("app_quiksupport")
}

model QspUserPermissionExtra {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  resource  String
  action    String
  grantedBy String?
  createdAt DateTime @default(now())

  @@unique([orgId, userId, resource, action])
  @@index([userId, orgId])
  @@map("UserPermissionExtra")
  @@schema("app_quiksupport")
}

// ============================================================================
// QuikChat (app_quikchat) — ported Batch 2
// ============================================================================

model QcChannel {
  id          String            @id @default(uuid())
  orgId       String
  type        String // 'dm' | 'group'
  visibility  String // 'public' | 'private'
  name        String?
  description String?
  avatarUrl   String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     QcChannelMember[]
  messages    QcMessage[]

  @@index([orgId, type, visibility])
  @@schema("app_quikchat")
}

model QcChannelMember {
  id         String    @id @default(uuid())
  orgId      String
  channelId  String
  userId     String
  role       String    @default("member") // 'admin' | 'member'
  isPinned      Boolean   @default(false) // per-member favourite → drives priority/recent split
  lastReadAt    DateTime?
  lastDeliveredAt DateTime? // S14a: client received messages up to here (delivery ticks)
  joinedAt      DateTime  @default(now())
  channel    QcChannel @relation(fields: [channelId], references: [id])

  @@unique([orgId, channelId, userId])
  @@index([orgId, userId])
  @@schema("app_quikchat")
}

model QcMessage {
  id              String    @id @default(uuid())
  orgId           String
  channelId       String
  senderId        String?
  actorType       String    @default("human") // 'human' | 'ai_agent'
  agentRunId      String?
  type            String    @default("Text") // Text | Media | SystemActivity | Delete | Call
  content         String
  data            Json?
  reactions       Json      @default("{}")
  parentMessageId String?
  isPinned        Boolean   @default(false)
  clientMessageId String? // client-generated UUID for idempotent sends
  editedAt        DateTime?
  createdAt       DateTime  @default(now())
  channel         QcChannel @relation(fields: [channelId], references: [id])

  @@unique([channelId, clientMessageId])
  @@index([orgId, channelId, createdAt])
  @@schema("app_quikchat")
}

model QcInvite {
  id          String    @id @default(uuid())
  orgId       String
  channelId   String
  code        String    @unique
  createdById String?
  maxUses     Int? // null = unlimited
  useCount    Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime? // soft revocation — kept for audit
  createdAt   DateTime  @default(now())

  @@index([orgId, channelId])
  @@schema("app_quikchat")
}

// ── RBAC v2 (app-level roles & permissions) ────────────────────────────────
// Mirrors the canonical QuikScale four-table model (app_quikscale.AppRole …)
// verbatim, prefixed `Qc*` and `@@map`'d to the physical names the shared
// `@quikit/auth` assignAppRoles helper resolves by literal table name
// (`app_quikchat."AppRole"` / `"UserAppRole"`). See docs/RBAC_PLAN.md.
model QcAppRole {
  id          String              @id @default(cuid())
  orgId       String
  appId       String
  name        String
  description String?
  isSystem    Boolean             @default(false)
  isDefault   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   String?
  app         App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  org         Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions QcRolePermission[]
  members     QcUserAppRole[]

  @@unique([orgId, appId, name])
  @@index([orgId, appId])
  @@map("AppRole")
  @@schema("app_quikchat")
}

model QcUserAppRole {
  id         String    @id @default(cuid())
  userId     String
  orgId      String
  roleId     String
  assignedAt DateTime  @default(now())
  assignedBy String?
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role       QcAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, roleId])
  @@index([roleId])
  @@index([userId, orgId])
  @@map("UserAppRole")
  @@schema("app_quikchat")
}

model QcRolePermission {
  id       String    @id @default(cuid())
  roleId   String
  resource String
  action   String
  role     QcAppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("RolePermission")
  @@schema("app_quikchat")
}

/// Per-user additive permission grants — applied ON TOP of the user's role
/// grants. Lets an admin extend one user's access without changing the role
/// for everyone on it.
model QcUserPermissionExtra {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  resource  String
  action    String
  grantedBy String?
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, resource, action])
  @@index([userId, orgId])
  @@map("UserPermissionExtra")
  @@schema("app_quikchat")
}

// Activity-feed row, one per (recipient, event). Delivery + gating live in
// app/src/server/notifications.service.ts (ported from the original backend).
model QcNotification {
  id        String   @id @default(uuid())
  orgId     String
  userId    String // recipient
  type      String // mention | dm | keyword | reaction | thread_reply
  actorId   String? // who caused it (message sender / reactor)
  channelId String?
  messageId String?
  preview   String   @default("") // short text for the bell + OS popup
  meta      Json? // channelName/actorName snapshot, matched keyword, reason, …
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orgId, userId, createdAt])
  @@index([orgId, userId, isRead])
  @@schema("app_quikchat")
}

// One row per user (per org): their global notification defaults.
model QcUserNotificationSettings {
  id                  String    @id @default(uuid())
  orgId               String
  userId              String
  defaultChannelLevel String    @default("all") // all | mentions | none
  dmsLevel            String    @default("all")
  soundEnabled        Boolean   @default(true)
  desktopEnabled      Boolean   @default(true) // master OS-popup switch
  emailEnabled        Boolean   @default(false)
  dndEnabled          Boolean   @default(false)
  dndStart            String? // local "HH:MM"
  dndEnd              String?
  snoozedUntil        DateTime? // global snooze — silences everything OS-side
  priorityDuringDnd   Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([orgId, userId])
  @@schema("app_quikchat")
}

// Per-channel override of the user's default level. Absence = inherit default.
model QcNotificationPreference {
  id         String    @id @default(uuid())
  orgId      String
  userId     String
  channelId  String
  level      String    @default("all") // all | mentions | none
  mutedUntil DateTime? // temporary mute → level effectively 'none' until then
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, channelId])
  @@schema("app_quikchat")
}

// Per-user highlight words (lowercased). A word-boundary match mints a keyword
// notification even without an @-mention.
model QcNotificationKeyword {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  keyword   String
  createdAt DateTime @default(now())

  @@unique([userId, keyword])
  @@schema("app_quikchat")
}

// Per-user UI preferences (S14b). One row per (org, user). Theme default
// "system" (follows prefers-color-scheme); explicit light/dark override it.
model QcUserUiPrefs {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  theme     String   @default("system") // system | light | dark
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId])
  @@schema("app_quikchat")
}

// Scheduled meeting (S15a). Chat-facing PROJECTION of an external calendar
// event (the external calendar is the source of truth for time/attendance).
// Merge-ready: app_quikchat schema, Qc prefix, orgId indexed.
model QcMeeting {
  id               String              @id @default(uuid())
  orgId            String
  channelId        String
  organizerId      String
  title            String
  description      String?
  start            DateTime // stored UTC; rendered local client-side
  end              DateTime
  joinUrl          String? // conferencing (Meet) link, if requested
  externalEventId  String? // provider event id (stub-evt-… on the stub)
  status           String              @default("scheduled") // scheduled | cancelled
  createdMessageId String? // the Meeting card message that announced it
  callId           String?  // links to active QcCall when call is in progress
  createdAt        DateTime            @default(now())
  attendees        QcMeetingAttendee[]

  @@index([orgId])
  @@index([channelId])
  @@index([callId])
  @@schema("app_quikchat")
}

model QcMeetingAttendee {
  id        String    @id @default(uuid())
  meetingId String
  userId    String
  email     String
  rsvp      String    @default("needs_action") // needs_action | accepted | declined | tentative
  meeting   QcMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@schema("app_quikchat")
}

// Per-user calendar OAuth connection (S15b). Stores a provider refresh token
// ENCRYPTED AT REST (AES-256-GCM via CALENDAR_TOKEN_ENC_KEY) — never plaintext.
// Used by the per-user-connect providers (Microsoft); Google's single-account
// model needs no per-user row. Merge-ready: app_quikchat, Qc prefix, orgId idx.
model QcCalendarConnection {
  id           String   @id @default(uuid())
  orgId        String
  userId       String
  provider     String // 'microsoft' (extensible)
  refreshToken String // ENCRYPTED blob — see calendar/crypto.ts
  email        String
  scopes       String // space-delimited granted scopes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@index([orgId])
  @@schema("app_quikchat")
}

// Personal calendar (S17). A named calendar in the user's "My calendars" list
// (color + visibility). Merge-ready: app_quikchat, Qc prefix, orgId indexed.
model QcCalendar {
  id        String            @id @default(uuid())
  orgId     String
  userId    String            // owner
  name      String
  color     String            // hex; default color for its events
  isDefault Boolean           @default(false) // the primary "Calendar"
  visible   Boolean           @default(true)  // "My calendars" checkbox
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  events    QcCalendarEvent[]

  @@index([orgId, userId])
  @@schema("app_quikchat")
}

// A personal calendar event (S17). start/end stored UTC, rendered local
// client-side (matches QcMeeting). status mirrors QcMeeting (confirmed|cancelled).
model QcCalendarEvent {
  id          String     @id @default(uuid())
  orgId       String
  userId      String     // owner (denormalized from calendar for scoping/query)
  calendarId  String
  title       String
  description String?
  location    String?
  start       DateTime
  end         DateTime
  allDay      Boolean    @default(false)
  color       String?    // optional per-event override; else inherit calendar.color
  joinUrl     String?
  status      String     @default("confirmed")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  calendar    QcCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, start])
  @@index([calendarId])
  @@schema("app_quikchat")
}

// In-chat AI assistant enable flag (S12). One row per (org, channel); the
// org-level default uses channelId = "" (empty). Resolution: per-channel row
// wins, else the org row, else the built-in default.
model QcAssistantConfig {
  id        String   @id @default(uuid())
  orgId     String
  channelId String   @default("") // "" = org-level default
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, channelId])
  @@schema("app_quikchat")
}

// ============================================================================
// Calling & Conferencing (CALL-1 through CALL-5)
// ============================================================================

model QcCall {
  id           String    @id @default(uuid())
  orgId        String
  channelId    String?   // nullable for direct calls not in a channel
  meetingId    String?   // links to QcMeeting if call was started from a meeting
  initiatorId  String
  type         String    // 'audio' | 'video'
  status       String    // 'ringing' | 'active' | 'ended' | 'missed' | 'rejected' | 'timed_out'
  startedAt    DateTime  @default(now())
  answeredAt   DateTime? // set when the first participant accepts (active)
  endedAt      DateTime?
  duration     Int?      // seconds, computed on end from answeredAt or startedAt

  participants QcCallParticipant[]

  @@index([orgId])
  @@index([channelId])
  @@index([meetingId])
  @@schema("app_quikchat")
}

model QcCallParticipant {
  id               String    @id @default(uuid())
  callId           String
  userId           String
  joinedAt         DateTime?
  leftAt           DateTime?
  state            String    // 'waiting' | 'connected' | 'disconnected'
  lastHeartbeatAt  DateTime? // used by the sweep to reap stale active calls

  call      QcCall    @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@schema("app_quikchat")
}
