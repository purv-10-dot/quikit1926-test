model JobApplication {
  id            String @id @default(cuid())
  orgId      String
  candidateId   String
  requisitionId String

  appliedDate  DateTime @default(now())
  currentStage String?
  stageHistory Json?

  status ApplicationStatus @default(AppActive)

  aiMatchScore    Decimal? @db.Decimal(5, 2)
  aiMatchAnalysis Json?

  rejectionReason String?
  rejectionStage  String?

  // Offer — formerly the separate OfferDetail table (1:1, keyed by
  // applicationId). Folded in here. offerStatus = null means no offer exists
  // for this application yet.
  offerStatus          OfferStatus?
  offerDesignation     String?
  offerDepartmentId    String?
  offerReportingToId   String?
  offeredCTC           Decimal?     @db.Decimal(15, 2)
  offeredComponents    Json?
  offerJoiningDate     DateTime?    @db.Date
  offerJoiningBonus    Decimal?     @db.Decimal(15, 2)
  offerRelocationBonus Decimal?     @db.Decimal(15, 2)
  offerEquityGrant     String?
  offerSentAt          DateTime?
  offerRespondedAt     DateTime?
  offerExpiresAt       DateTime?
  offerDeclineReason   String?
  offerCounterOfferCTC Decimal?     @db.Decimal(15, 2)
  offerNegotiationNotes String?
  offerLetterUrl       String?
  offerCreatedAt       DateTime?
  offerCreatedBy       String?

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

