// Per-state minimum wage notifications. Used by statutory bonus calculation
// (calc cap = max(₹7,000, applicable state minimum wage)) and similar needs.
// Lookup: most recent effectiveFrom ≤ pay period for given (tenant, state, scheduledEmployment, skillLevel).
model StateMinimumWage {
  id    String @id @default(cuid())
  orgId String

  state               String
  // Optional refinements — empty string when not specified (so compound unique works).
  scheduledEmployment String   @default("") // e.g. "IT/ITES", "Shops & Establishments", "Construction"
  skillLevel          String   @default("") // "Unskilled" | "SemiSkilled" | "Skilled" | "HighlySkilled"
  zone                String   @default("") // e.g. "A", "B", "C" (some states use zones)
  monthlyWage         Decimal  @db.Decimal(12, 2)
  effectiveFrom       DateTime
  notes               String?

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, state, scheduledEmployment, skillLevel, zone, effectiveFrom])
  @@index([orgId])
  @@index([orgId, state, effectiveFrom])
  @@schema("app_quikhrms")
}

