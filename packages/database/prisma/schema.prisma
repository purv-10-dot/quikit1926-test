  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([org_id, challan_number])
  @@index([org_id, challan_date(sort: Desc)])
  @@index([contact_id])
  @@map("delivery_challans")
  @@schema("app_quikfinance")
}

model QfDeliveryChallanLine {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  org_id        String
  challan_id    String  @db.Uuid
  item_id       String? @db.Uuid
  description   String
  quantity      Decimal @default(0) @db.Decimal(20, 4)
  rate          Decimal @default(0) @db.Decimal(20, 2)
  discount      Decimal @default(0) @db.Decimal(20, 2)
  line_total    Decimal @default(0) @db.Decimal(20, 2)
  tax_rate_id   String? @db.Uuid
  display_order Int     @default(0)

  @@index([challan_id])
  @@map("delivery_challan_lines")
