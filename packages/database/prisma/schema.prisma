  habitAssessmentId String
  respondentUserId  String
  subItemBits       Json
  submittedAt       DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  habitAssessment   HabitAssessment @relation(fields: [habitAssessmentId], references: [id], onDelete: Cascade)

  @@unique([habitAssessmentId, respondentUserId])
  @@index([habitAssessmentId])
  @@schema("app_quikscale")
}

model QuarterSetting {
