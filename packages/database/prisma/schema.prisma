  fieldType      String
  requirement    String   @default("Optional")
  options        Json?
  visible        Boolean  @default(true)
  helpText       String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activityType CrmActivityType         @relation(fields: [activityTypeId], references: [id], onDelete: Cascade)
  fieldValues  CrmActivityFieldValue[]

  @@unique([activityTypeId, key])
  @@index([orgId])
  @@index([activityTypeId])
  @@schema("app_quikcrm")
}

// Phase 2: indexed, queryable storage for activity custom-field VALUES.
// Decision #1 — a dedicated typed-column table, NOT a JSON blob — so the
// Phase-4 dashboard and digests can aggregate/filter BY value (count, sum,
// group-by) using the per-value indexes below. One row per (activity, field).
// Mirrors QuikTrack's QtIssueFieldValue. See ACTIVITY-FEATURE-DECISIONS.md.
model CrmActivityFieldValue {
  id                String    @id @default(cuid())
  orgId             String
  activityId        String
  fieldDefinitionId String
  fieldKey          String
  valueText         String?
  valueNumber       Float?
  valueDate         DateTime?
  valueBoolean      Boolean?
  valueJson         Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  activity        CrmActivity                @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fieldDefinition CrmActivityFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([activityId, fieldDefinitionId])
  @@index([orgId])
  @@index([activityId])
  @@index([fieldDefinitionId, valueText])
  @@index([fieldDefinitionId, valueNumber])
  @@index([fieldDefinitionId, valueDate])
  @@index([fieldDefinitionId, valueBoolean])
  @@schema("app_quikcrm")
}

