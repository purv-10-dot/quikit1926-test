  grns                 CnGoodsReceiptNote[]
  stockLedgerRows      CnStockLedger[]
  materialIssues       CnMaterialIssue[]
  // Phase 3b
  gatePasses           CnGatePass[]
  goodReturns          CnGoodReturn[]
  internalReturns      CnInternalReturn[]
  stockTransfersFrom   CnStockTransfer[]       @relation("TransferFrom")
  stockTransfersTo     CnStockTransfer[]       @relation("TransferTo")
  stockReconciliations CnStockReconciliation[]
  dieselLogs           CnDieselLog[]
  // Phase 6
  dprsConsumingHere    CnDPR[]                 @relation("DprConsumptionLocation")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

