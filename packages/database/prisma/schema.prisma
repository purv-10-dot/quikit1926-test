  payroll  CnPayroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee CnEmployee @relation(fields: [employeeId], references: [id])

  @@index([payrollId])
  @@index([employeeId])
  @@schema("app_quikconstruction")
}

// ── Phase 8 — Approvals ─────────────────────────────────────────────────

model CnApprovalRule {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  docType    String // pr | po | rab | vendor_bill | payroll | other
  /// Threshold: approval required if doc total >= this amount (null = always).
  minAmount  Decimal? @db.Decimal(18, 2)
  approverId String // user id
  status     String   @default("active")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String?
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, docType])
  @@index([deletedAt])
  @@schema("app_quikconstruction")
}

model CnApprovalRequest {
  id          String    @id @default(cuid())
  tenantId    String
  docType     String
  docId       String
  docRef      String // human-readable identifier (doc number)
  amount      Decimal?  @db.Decimal(18, 2)
  requestedBy String
  approverId  String
  status      String    @default("pending") // pending | approved | rejected
  decisionAt  DateTime?
  comment     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([approverId, status])
