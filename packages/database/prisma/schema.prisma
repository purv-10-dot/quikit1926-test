  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  status         QtChecklistStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)

  @@index([orgId, userId])
  @@index([dueDate, reminderSentAt])
  @@schema("app_quiktrack")
}

