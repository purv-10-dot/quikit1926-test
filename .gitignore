# ── Vercel (CLI link, build output, deploy artifacts) ───────────────────────
# Local project link + build output. The bare `.vercel` pattern matches the
# dir at any depth, so the repo-root AND every apps/<app>/.vercel are ignored.
.vercel
.vercel/
**/.vercel/
.vercel/output
# Legacy Vercel CLI dir
.now
.now/
# Deploy logs produced by scripts/_deploy-api.mjs & friends (artifacts, not source).
deploy-*.log
# NOTE: vercel.json and .vercelignore are intentionally NOT ignored — they are
# committed deploy configuration (build commands, crons, upload excludes).

apps/quikscale.zip
apps/quikinfra/uploads/*
packages/database/.env.tmp

# ────────────────────────────────────────────────────────────────────────────
# Internal working artifacts — audits, handoffs, mind maps, brainstorm
# captures, scratch notes. Local-only; never committed.
#
# Three tiers of non-code files:
#   /docs/         → Category A: shippable, versioned, part of platform contract
#   /_internal/    → Category B: gitignored (this), your scratch space
#   ~/Desktop/...  → Category C: external shareables (kits, zips, exports)
# ────────────────────────────────────────────────────────────────────────────
/_internal/
graphify-out/

# Claude Code personal overrides — machine-specific, never committed.
.claude/settings.local.json
**/.claude/settings.local.json

# Markdown files — local-only docs, analyses, scratch notes; never committed.
*.md

# ────────────────────────────────────────────────────────────────────────────
# QuikLMS migrations — applied by hand per environment (dev/uat/prod), so the
# SQL is not carried in git. Only matches *_quiklms_* / *app_quiklms* names;
# every other app's migrations stay tracked. Already-committed files are
# unaffected — .gitignore only applies to untracked paths.
# ────────────────────────────────────────────────────────────────────────────
packages/database/prisma/migrations/*_quiklms_*/
packages/database/prisma/manual-migrations/*app_quiklms*

# ────────────────────────────────────────────────────────────────────────────
# Fathom capture output (apps/quikflow/scripts/fathom-capture.ts).
# The RAW dump contains a client's real attendee emails and the verbatim
# transcript of what people said; the redaction map is a reverse lookup from
# pseudonyms back to those real identities. Neither may ever be committed.
# Only the REDACTED payload is fixture material, and only after a human has
# read it — see apps/quikflow/scripts/redactFathomPayload.ts.
# ────────────────────────────────────────────────────────────────────────────
.fathom-capture/
**/fathom-raw-*.json
**/redaction-map-*.json

# npm lockfile — not tracked in this repo.
package-lock.json
**/package-lock.json
